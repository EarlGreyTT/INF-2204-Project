# Builds the programs we measure into build/, with the flags below on
# every platform. A distribution's compiler can add options of its own;
# the ones we know of are switched off below, and record notes the
# options in force in each run's meta.txt.
#
#   make             everything
#   make <program>   one program: zstd, xz, sqlite, git or magick
#                    (ImageMagick)
#   make clang       the C compilers, built from source: build/clang and
#   make gcc         build/cc1 (gcc's compiler proper). Not part of
#                    "make": each takes hours on a Raspberry Pi.
#   make data        the files the programs are run on:
#                    build/repo     for git: a repository whose three
#                                   commits are three releases of git
#                    build/bridge.ppm, deer.ppm, big_tree.ppm,
#                    artificial.ppm and leaves_iso_1600.ppm
#                                   for ImageMagick: five images from a
#                                   set of test photos used in image
#                                   compression research (the download,
#                                   346 MB, is of the whole set)
#                    build/clones/  for the clone workloads: the history
#                                   of one release each of git, Lua,
#                                   SQLite, curl and Neovim, as bare
#                                   repositories (460 MB)
#                    build/tars/    for zstd and xz: the files of those
#                                   five releases, one tar each (260 MB)
#                    build/compile/ and build/lua-*.tar.gz
#                                   for the compile workloads: the
#                                   source code they compile (git's is
#                                   the download "make git" uses)
#   make compile-gcc   for the compile workloads of programs with a
#   make compile-clang configure step (curl, Neovim): that step, run
#                    once with our gcc or clang, its result kept in
#                    build/compile/<compiler>-<program>.tar. Needs the
#                    compiler (it builds it if missing, so not part of
#                    "make data") and the downloads of make data.
#   make valgrind    valgrind with our fix for arm64 (Raspberry Pi), in
#                    build/valgrind; record uses it when it is there.
#                    measure builds it on arm64.
#   make clean       remove build/
#
# Third-party programs: a pinned release, its download checked against
# the published SHA-256, optional features off, so every platform builds
# the same code. That includes code a program would pick at run time by
# CPU feature, and libraries it would take from the system.

CC = gcc
# -g for symbols (instructions are named function+offset; it does not
# change the code); fixed alignment of functions and loops, so code
# layout differs less between builds. No frame pointers: normal builds
# omit them, and perf records no call stacks. -ffile-prefix-map leaves
# the path of this folder out of the programs (their debug information
# would hold it). With the path left out, the same compiler gives the
# same file in any folder, so checksums can be compared between
# machines.
CFLAGS = -O2 -g -falign-functions=32 -falign-loops=32 -ffile-prefix-map=$(CURDIR)=.
# Ubuntu's gcc hardens programs by itself (stack protector, stack clash
# protection, _FORTIFY_SOURCE, control-flow protection, and its linker
# resolves every library call at start); Debian's does none of this.
# Off everywhere, so the platforms build the same kind of code.
CFLAGS += -fno-stack-protector -fno-stack-clash-protection -fcf-protection=none \
	-U_FORTIFY_SOURCE -Wl,-z,lazy

# The compilers are C++ and built by this one. They get the flags above
# with -g1 for -g: functions and source lines, which is all perf needs,
# without the types and variables, which for programs this size take
# gigabytes more memory and disk to build. -g1 does not change the code
# either.
CXX = g++
COMPILER_CFLAGS = $(patsubst -g,-g1,$(CFLAGS))
# how many files the compilers' builds compile at once, whatever make's
# -j: some of their files need 1-2 GB of memory each.
COMPILER_JOBS = 4

ifneq ($(words $(CURDIR)),1)
$(error the path of this folder has a space in it ($(CURDIR)), which the builds cannot handle)
endif

BUILD = build

# Compilers, configure scripts and the programs' own Makefiles get only
# these environment variables. Otherwise variables set in the shell of
# whoever builds (CPPFLAGS, LDFLAGS, CPATH, LIBRARY_PATH, LD_RUN_PATH,
# the locale, or one a program's Makefile reads, like NO_CURL) would
# change the programs. MAKEFLAGS is kept so that make -j8 also builds
# the programs in parallel; it also carries variables given on make's
# command line.
BUILDENV = env -i PATH="$$PATH" HOME=/nonexistent LC_ALL=C TZ=UTC MAKEFLAGS="$$MAKEFLAGS"

