# fetch url sha256: downloads to $@, kept only if the checksum matches
define fetch
	curl -fsSL --retry 3 -o $@.part $(1)
	echo "$(2)  $@.part" | sha256sum -c --quiet
	mv $@.part $@
endef

# every build also depends on this Makefile, so a change of flags
# rebuilds the programs
$(BUILD)/zstd-$(ZSTD_VERSION).tar.gz: | $(BUILD)
	$(call fetch,$(ZSTD_URL),$(ZSTD_SHA256))

# zlib, lzma and lz4 support (other formats) and threads (multithreaded
# and asynchronous I/O) off: zstd's build enables each only if the
# machine has it, and threads would make runs less repeatable.
# DYNAMIC_BMI2=0: no x86 code paths picked at run time by CPU feature
# (it also turns off zstd's assembly decoder, which needs BMI2).
$(BUILD)/zstd: $(BUILD)/zstd-$(ZSTD_VERSION).tar.gz Makefile
	rm -rf $(ZSTD_SRC)
	tar -xzf $< -C $(BUILD)
	$(BUILDENV) $(MAKE) -C $(ZSTD_SRC)/programs zstd CC="$(CC)" CFLAGS="$(CFLAGS) -DDYNAMIC_BMI2=0" MOREFLAGS= \
		HAVE_ZLIB=0 HAVE_LZMA=0 HAVE_LZ4=0 HAVE_THREAD=0
	cp $(ZSTD_SRC)/programs/zstd $@

$(BUILD)/xz-$(XZ_VERSION).tar.gz: | $(BUILD)
	$(call fetch,$(XZ_URL),$(XZ_SHA256))

# Threads, translations and the sandbox off, and only the xz tool built.
# No assembler and no CRC code picked by CPU feature (CLMUL on x86,
# CRC32 instructions on ARM64).
$(BUILD)/xz: $(BUILD)/xz-$(XZ_VERSION).tar.gz Makefile
	rm -rf $(XZ_SRC)
	tar -xzf $< -C $(BUILD)
	cd $(XZ_SRC) && $(BUILDENV) ./configure --quiet CC="$(CC)" CFLAGS="$(CFLAGS)" \
		--disable-shared --disable-nls --enable-threads=no --enable-sandbox=no \
		--disable-assembler --disable-clmul-crc --disable-arm64-crc32 --disable-loongarch-crc32 \
		--disable-xzdec --disable-lzmadec --disable-lzmainfo --disable-lzma-links \
		--disable-scripts --disable-doc
	$(BUILDENV) $(MAKE) -C $(XZ_SRC)
	cp $(XZ_SRC)/src/xz/xz $@

$(BUILD)/sqlite-src-$(SQLITE_VERSION).zip: | $(BUILD)
	$(call fetch,$(SQLITE_URL),$(SQLITE_SHA256))

# SQLite's own benchmark program, speedtest1, with SQLite compiled in as
# one file (sqlite3.c, which its build generates). Threads and
# loadable extensions off.
$(BUILD)/speedtest1: $(BUILD)/sqlite-src-$(SQLITE_VERSION).zip Makefile
	rm -rf $(SQLITE_SRC)
	unzip -q -d $(BUILD) $<
	cd $(SQLITE_SRC) && $(BUILDENV) ./configure --disable-tcl --disable-readline >/dev/null
	$(BUILDENV) $(MAKE) -C $(SQLITE_SRC) sqlite3.c >/dev/null
	$(BUILDENV) $(CC) $(CFLAGS) -DSQLITE_THREADSAFE=0 -DSQLITE_OMIT_LOAD_EXTENSION -I$(SQLITE_SRC) \
		-o $@ $(SQLITE_SRC)/test/speedtest1.c $(SQLITE_SRC)/sqlite3.c -lm

$(BUILD)/ImageMagick-$(MAGICK_VERSION).tar.xz: | $(BUILD)
	$(call fetch,$(MAGICK_URL),$(MAGICK_SHA256))

# The magick program with all of ImageMagick built in (no shared
# libraries). Every library it could use is off, so it reads and writes
# only the formats it has code for itself (PPM, BMP, ...). No threads
# (OpenMP, pthreads), no X, no C++ or Perl parts. Zero configuration:
# it reads no settings files, and the prefix is a folder that does not
# exist, as for git. Pixels are ImageMagick 7's default kind: floats
# on a 16-bit scale (Q16 HDRI). --without-gcc-arch stops configure
# adding a -mtune of its own; it still adds -fexceptions, on every
# platform alike.
$(BUILD)/magick: $(BUILD)/ImageMagick-$(MAGICK_VERSION).tar.xz Makefile
	rm -rf $(MAGICK_SRC)
	tar -xJf $< -C $(BUILD)
	cd $(MAGICK_SRC) && $(BUILDENV) ./configure --quiet CC="$(CC)" CFLAGS="$(CFLAGS)" --prefix=/nonexistent \
		--disable-shared --enable-zero-configuration --with-quantum-depth=16 --enable-hdri \
		--disable-openmp --disable-opencl --without-threads --without-gcc-arch \
		--without-modules --without-magick-plus-plus --without-perl --without-x --disable-docs --disable-dpc \
		--without-bzlib --without-zip --without-zlib --without-zstd --without-lzma \
		--without-djvu --without-dmr --without-fontconfig --without-freetype --without-heic \
		--without-jbig --without-jpeg --without-jxl --without-lcms --without-lqr --without-openexr \
		--without-openjp2 --without-pango --without-png --without-raqm --without-raw --without-tiff \
		--without-webp --without-xml
	$(BUILDENV) $(MAKE) -C $(MAGICK_SRC) utilities/magick >/dev/null
	cp $(MAGICK_SRC)/utilities/magick $@

$(BUILD)/zlib-$(ZLIB_VERSION).tar.gz: | $(BUILD)
	$(call fetch,$(ZLIB_URL),$(ZLIB_SHA256))

# static only, so git cannot end up with the system's
$(BUILD)/zlib/lib/libz.a: $(BUILD)/zlib-$(ZLIB_VERSION).tar.gz Makefile
	rm -rf $(ZLIB_SRC) $(BUILD)/zlib
	tar -xzf $< -C $(BUILD)
	cd $(ZLIB_SRC) && $(BUILDENV) CC="$(CC)" CFLAGS="$(CFLAGS)" ./configure --static --prefix=$(abspath $(BUILD)/zlib) >/dev/null
	$(BUILDENV) $(MAKE) -C $(ZLIB_SRC) install >/dev/null

$(BUILD)/git-%.tar.gz: | $(BUILD)
	$(call fetch,$(GIT_URL)/git-$*.tar.gz,$(GIT_SHA256_$*))

# Only the git program itself (its built-in commands). Everything
# optional off: other libraries (OpenSSL, curl, expat, PCRE), the parts
# in other languages (Rust, Perl, Python, Tcl), translations and
# threads; its own C code for SHA-1 and SHA-256. The prefix is where git
# looks for a system-wide configuration and for other git programs: a
# folder that does not exist, so that it finds neither on any machine
# (the default is the home folder of whoever builds). CC_LD_DYNPATH=-L
# keeps the build folder's path out of the program.
$(BUILD)/git: $(BUILD)/git-$(GIT_VERSION).tar.gz $(BUILD)/zlib/lib/libz.a Makefile
	rm -rf $(GIT_SRC)
	tar -xzf $< -C $(BUILD)
	$(BUILDENV) $(MAKE) -C $(GIT_SRC) git CC="$(CC)" CFLAGS="$(CFLAGS)" prefix=/nonexistent \
		ZLIB_PATH=$(abspath $(BUILD)/zlib) CC_LD_DYNPATH=-L \
		NO_OPENSSL=1 NO_CURL=1 NO_EXPAT=1 NO_GETTEXT=1 NO_PERL=1 NO_PYTHON=1 \
		NO_TCLTK=1 NO_RUST=1 NO_PTHREADS=1
	cp $(GIT_SRC)/git $@

# One commit per release, oldest first, made and packed by the git built
# above. Author, dates and settings are fixed, so every platform gets
# the same commits in the same pack file. Two checks: the last commit's
# id, and the pack file's SHA-256 (how objects are packed changes the
# work git does to read them). Only the repository is kept, not the
# files checked out.
$(BUILD)/repo: $(BUILD)/git $(foreach v,$(GIT_OLDER) $(GIT_VERSION),$(BUILD)/git-$(v).tar.gz)
	rm -rf $@.part $@
	mkdir $@.part
	set -e; cd $@.part; n=0; \
	git() { env -i PATH=$(abspath $(BUILD)):/usr/bin:/bin HOME=/nonexistent LC_ALL=C TZ=UTC \
		GIT_AUTHOR_NAME=inf2204 GIT_AUTHOR_EMAIL=inf2204@example.org \
		GIT_COMMITTER_NAME=inf2204 GIT_COMMITTER_EMAIL=inf2204@example.org \
		GIT_AUTHOR_DATE="2026-01-0$$n 00:00:00 +0000" GIT_COMMITTER_DATE="2026-01-0$$n 00:00:00 +0000" \
		git "$$@"; }; \
	git init -q --template= -b main .; \
	for v in $(GIT_OLDER) $(GIT_VERSION); do \
		n=$$((n + 1)); \
		find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +; \
		tar -xzf $(abspath $(BUILD))/git-$$v.tar.gz --strip-components=1; \
		git add -A .; \
		git commit -q -m "git $$v"; \
	done; \
	git repack -a -d -q; \
	find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +; \
	test "$$(git rev-parse HEAD)" = $(GIT_REPO_HEAD); \
	echo "$(GIT_REPO_PACK_SHA256)  $$(echo .git/objects/pack/*.pack)" | sha256sum -c --quiet
	mv $@.part $@

$(BUILD)/llvm-project-$(LLVM_VERSION).src.tar.xz: | $(BUILD)
	$(call fetch,$(LLVM_URL),$(LLVM_SHA256))

# Only clang, as one program: LLVM's libraries linked in statically, and
# the C++ library too. Code generation only for the machine it is built
# on (LLVM_TARGETS_TO_BUILD=host; AArch64 on a Raspberry Pi), as gcc
# does. A release build (no assertions) at -O2: cmake's Release would
# add -O3. Optional libraries off (zlib, zstd, libxml2, libedit, libpfm,
# curl, libffi), so it takes none from the system, and so are the
# static analyzer, tests, examples and documentation. Needs cmake and
# ninja (apt install cmake ninja-build).
$(BUILD)/clang: $(BUILD)/llvm-project-$(LLVM_VERSION).src.tar.xz Makefile
	rm -rf $(LLVM_SRC) $(BUILD)/llvm-build
	tar -xJf $< -C $(BUILD)
	$(BUILDENV) cmake -G Ninja -S $(LLVM_SRC)/llvm -B $(BUILD)/llvm-build -Wno-dev \
		-DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=$(CC) -DCMAKE_CXX_COMPILER=$(CXX) \
		-DCMAKE_C_FLAGS="$(COMPILER_CFLAGS)" -DCMAKE_CXX_FLAGS="$(COMPILER_CFLAGS)" \
		-DCMAKE_C_FLAGS_RELEASE=-DNDEBUG -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG \
		-DLLVM_ENABLE_PROJECTS=clang -DLLVM_TARGETS_TO_BUILD=host \
		-DLLVM_ENABLE_ASSERTIONS=OFF -DLLVM_STATIC_LINK_CXX_STDLIB=ON \
		-DLLVM_ENABLE_ZLIB=OFF -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF \
		-DLLVM_ENABLE_LIBEDIT=OFF -DLLVM_ENABLE_LIBPFM=OFF -DLLVM_ENABLE_CURL=OFF \
		-DLLVM_ENABLE_FFI=OFF -DCLANG_ENABLE_STATIC_ANALYZER=OFF \
		-DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF \
		-DLLVM_INCLUDE_DOCS=OFF -DCLANG_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_DOCS=OFF \
		-DLLVM_PARALLEL_LINK_JOBS=1 >/dev/null
	$(BUILDENV) ninja -C $(BUILD)/llvm-build -j $(COMPILER_JOBS) clang
	cp $(BUILD)/llvm-build/bin/clang $@

$(BUILD)/gcc-$(GCC_VERSION).tar.xz: | $(BUILD)
	$(call fetch,$(GCC_URL),$(GCC_SHA256))

$(BUILD)/gmp-$(GMP_VERSION).tar.bz2: | $(BUILD)
	$(call fetch,$(GCC_INFRA_URL)/gmp-$(GMP_VERSION).tar.bz2,$(GMP_SHA256))

$(BUILD)/mpfr-$(MPFR_VERSION).tar.bz2: | $(BUILD)
	$(call fetch,$(GCC_INFRA_URL)/mpfr-$(MPFR_VERSION).tar.bz2,$(MPFR_SHA256))

$(BUILD)/mpc-$(MPC_VERSION).tar.gz: | $(BUILD)
	$(call fetch,$(GCC_INFRA_URL)/mpc-$(MPC_VERSION).tar.gz,$(MPC_SHA256))

# Only cc1, the compiler proper: the gcc command is a driver that starts
# cc1 as a program of its own, and record keeps only the program it is
# given. C only, built once (no bootstrap: gcc otherwise builds itself
# three times), with GMP, MPFR and MPC built in, so it takes none from
# the system. all-gcc stops before the libraries gcc's programs are
# linked with (libgcc and others), which cc1 does not need. Off: other
# languages, translations, link-time optimization, plugins, ISL (loop
# optimizations that -O2 does not use) and zstd. The prefix, as for git,
# is a folder that does not exist. GMP's build needs m4 (apt install m4).
$(BUILD)/cc1: $(BUILD)/gcc-$(GCC_VERSION).tar.xz $(BUILD)/gmp-$(GMP_VERSION).tar.bz2 \
		$(BUILD)/mpfr-$(MPFR_VERSION).tar.bz2 $(BUILD)/mpc-$(MPC_VERSION).tar.gz Makefile
	rm -rf $(GCC_SRC) $(BUILD)/gcc-build
	tar -xJf $< -C $(BUILD)
	tar -xjf $(BUILD)/gmp-$(GMP_VERSION).tar.bz2 -C $(GCC_SRC)
	mv $(GCC_SRC)/gmp-$(GMP_VERSION) $(GCC_SRC)/gmp
	tar -xjf $(BUILD)/mpfr-$(MPFR_VERSION).tar.bz2 -C $(GCC_SRC)
	mv $(GCC_SRC)/mpfr-$(MPFR_VERSION) $(GCC_SRC)/mpfr
	tar -xzf $(BUILD)/mpc-$(MPC_VERSION).tar.gz -C $(GCC_SRC)
	mv $(GCC_SRC)/mpc-$(MPC_VERSION) $(GCC_SRC)/mpc
	mkdir $(BUILD)/gcc-build
	cd $(BUILD)/gcc-build && $(BUILDENV) $(abspath $(GCC_SRC))/configure --quiet \
		CC="$(CC)" CXX="$(CXX)" CFLAGS="$(COMPILER_CFLAGS)" CXXFLAGS="$(COMPILER_CFLAGS)" \
		--prefix=/nonexistent --enable-languages=c --disable-bootstrap --disable-multilib \
		--disable-nls --disable-lto --disable-plugin --without-isl --without-zstd
	$(BUILDENV) $(MAKE) -C $(BUILD)/gcc-build -j $(COMPILER_JOBS) all-gcc
	cp $(BUILD)/gcc-build/gcc/cc1 $@

$(BUILD)/rgb8bit.zip: | $(BUILD)
	$(call fetch,$(IMAGES_URL),$(IMAGES_SHA256))

$(foreach p,$(PHOTOS),$(BUILD)/$(p).ppm): $(BUILD)/%.ppm: $(BUILD)/rgb8bit.zip
	unzip -p $< $*.ppm > $@.part
	mv $@.part $@

# Both gits run without the settings of the user or the system
# (~/.gitconfig, /etc/gitconfig, GIT_* variables): some change the pack
# or the repository's format. The system's git downloads (ours has no
# network support), told to leave out what it would add by itself
# (commit graphs, maintenance), as that differs between versions. Our
# git then packs everything anew, the way a server keeps its
# repositories (with a bitmap index), with fixed settings and one
# thread. -F also compresses every object again, with our zlib:
# otherwise objects keep the bytes the server sent, which can differ
# from one download to the next. build/ comes first in PATH, so that the
# helpers git starts (pack-objects) are ours too, not the system's (our
# git has no folder of its own for them). So every platform gets the
# same pack file: how objects are packed changes the work a clone does.
# Two checks: the release's commit, and the pack file's SHA-256. Our git
# is only needed to be there (|): a rebuilt git need not download the
# repositories again; if it packed differently, the check would say so.
CLONE_FETCH = env -i PATH=/usr/bin:/bin HOME=/nonexistent LC_ALL=C TZ=UTC GIT_CONFIG_NOSYSTEM=1 git
CLONE_GIT = env -i PATH=$(abspath $(BUILD)):/usr/bin:/bin HOME=/nonexistent LC_ALL=C TZ=UTC \
	GIT_CONFIG_NOSYSTEM=1 $(abspath $(BUILD))/git
$(BUILD)/clones/%.git: | $(BUILD)/git
	rm -rf $@.part $@
	mkdir -p $(BUILD)/clones
	$(CLONE_GIT) init -q --bare --template= -b main $@.part
	$(CLONE_FETCH) -C $@.part -c gc.auto=0 -c maintenance.auto=false -c fetch.writeCommitGraph=false \
		fetch -q --no-tags --no-write-fetch-head $(CLONE_URL_$*) $(CLONE_COMMIT_$*):refs/heads/main
	rm -rf $@.part/objects/info/commit-graph $@.part/objects/info/commit-graphs
	$(CLONE_GIT) -C $@.part -c pack.threads=1 -c pack.window=10 -c pack.depth=50 \
		-c repack.writeBitmaps=true repack -q -a -d -F
	test "$$($(CLONE_GIT) -C $@.part rev-parse main)" = $(CLONE_COMMIT_$*)
	echo "$(CLONE_PACK_SHA256_$*)  $$(echo $@.part/objects/pack/*.pack)" | sha256sum -c --quiet
	mv $@.part $@

# The repositories, their tars and the photo set are made once and kept,
# under names without their pin: after a pin above changes, the old ones
# would stay without a word, and machines would measure different inputs.
# So make data checks them each time (seconds).
check-inputs:
	@$(foreach c,$(CLONES),\
	if [ -d $(BUILD)/clones/$(c).git ] && \
		{ [ "$$($(CLONE_GIT) -C $(BUILD)/clones/$(c).git rev-parse main)" != $(CLONE_COMMIT_$(c)) ] || \
		! echo "$(CLONE_PACK_SHA256_$(c))  $$(echo $(BUILD)/clones/$(c).git/objects/pack/*.pack)" | \
			sha256sum -c --quiet >/dev/null 2>&1; }; then \
		printf '%s\n\n%s\n\n' "$(BUILD)/clones/$(c).git is not the pinned one; fix it with:" \
			"rm -rf $(BUILD)/clones/$(c).git $(BUILD)/tars/$(c).tar"; exit 1; fi; \
	if [ -f $(BUILD)/tars/$(c).tar ] && \
		! echo "$(TAR_SHA256_$(c))  $(BUILD)/tars/$(c).tar" | sha256sum -c --quiet >/dev/null 2>&1; then \
		printf '%s\n\n%s\n\n' "$(BUILD)/tars/$(c).tar is not the pinned one; fix it with:" \
			"rm $(BUILD)/tars/$(c).tar"; exit 1; fi;)
	@if [ -f $(BUILD)/rgb8bit.zip ] && \
		! echo "$(IMAGES_SHA256)  $(BUILD)/rgb8bit.zip" | sha256sum -c --quiet >/dev/null 2>&1; then \
		printf '%s\n\n%s\n\n' "$(BUILD)/rgb8bit.zip is not the pinned one; fix it with:" \
			"rm $(BUILD)/rgb8bit.zip $(foreach p,$(PHOTOS),$(BUILD)/$(p).ppm)"; exit 1; fi

$(BUILD)/tars/%.tar: $(BUILD)/clones/%.git
	mkdir -p $(BUILD)/tars
	$(CLONE_GIT) --git-dir=$< archive --format=tar main > $@.part
	echo "$(TAR_SHA256_$*)  $@.part" | sha256sum -c --quiet
	mv $@.part $@

$(BUILD)/lua-$(LUA_VERSION).tar.gz: | $(BUILD)
	$(call fetch,$(LUA_URL),$(LUA_SHA256))

# For the compile workloads: SQLite as its build compiles the sqlite3
# program, from two generated files, sqlite3.c (all of SQLite) and
# shell.c. They are made here, not in a run: making them builds a helper
# program with the system's compiler. They do not depend on the machine
# (configure only chose how the helper is built).
$(BUILD)/compile/sqlite: $(BUILD)/speedtest1
	rm -rf $@ $@.part
	$(BUILDENV) $(MAKE) -C $(SQLITE_SRC) shell.c >/dev/null
	mkdir -p $@.part
	cp $(SQLITE_SRC)/sqlite3.c $(SQLITE_SRC)/sqlite3.h $(SQLITE_SRC)/shell.c $@.part
	mv $@.part $@

$(BUILD)/curl-$(CURL_VERSION).tar.xz: | $(BUILD)
	$(call fetch,$(CURL_URL),$(CURL_SHA256))

# For the compile workloads of Neovim: the libraries it is linked with
# (libuv, LuaJIT, luv, lpeg, unibilium, utf8proc, tree-sitter), built
# by its own cmake.deps from the downloads named, with SHA-256s, in its
# cmake.deps/deps.txt, with the system's compiler: the runs compile
# Neovim's own code only. Not the tree-sitter parsers: Neovim loads
# them at run time; its build does not need them. Needs cmake and ninja
# (apt install cmake ninja-build).
# Built in place (the libraries' files name the folder), removed if the
# build fails, so that a half-built one is not taken as done.
# done is written last: a build stopped part-way leaves a folder that
# make would otherwise take for finished. CACHE_PRG=OFF: Neovim's build
# would use ccache or sccache wherever one is installed.
$(BUILD)/neovim-deps/done: $(BUILD)/tars/neovim.tar Makefile
	rm -rf $(BUILD)/neovim-deps $(BUILD)/neovim-deps.src
	mkdir $(BUILD)/neovim-deps.src
	tar -xf $< -C $(BUILD)/neovim-deps.src
	{ $(BUILDENV) cmake -S $(BUILD)/neovim-deps.src/cmake.deps -B $(BUILD)/neovim-deps -G Ninja \
		-Wno-dev -DCMAKE_BUILD_TYPE=Release -DUSE_BUNDLED_TS_PARSERS=OFF -DCACHE_PRG=OFF >/dev/null && \
	  $(BUILDENV) cmake --build $(BUILD)/neovim-deps >/dev/null; } || { rm -rf $(BUILD)/neovim-deps; exit 1; }
	rm -rf $(BUILD)/neovim-deps.src
	touch $@

# For the compile workloads with a configure step: that step, with the
# compiler the runs use, in the folder they build in (configure writes
# its absolute path into the Makefiles), kept as a tar with the files'
# times, so that make in a run does not configure again. A run unpacks
# it there and runs make. scripts/workloads/compile does both, so the
# compiler and flags are the same.
$(BUILD)/compile/gcc-curl.tar $(BUILD)/compile/clang-curl.tar: $(BUILD)/curl-$(CURL_VERSION).tar.xz
$(BUILD)/compile/gcc-neovim.tar $(BUILD)/compile/clang-neovim.tar: $(BUILD)/tars/neovim.tar $(BUILD)/neovim-deps/done
$(BUILD)/compile/gcc-%.tar: $(BUILD)/cc1 scripts/workloads/compile Makefile
	$(BUILDENV) scripts/workloads/compile --prepare gcc $*
$(BUILD)/compile/clang-%.tar: $(BUILD)/clang scripts/workloads/compile Makefile
	$(BUILDENV) scripts/workloads/compile --prepare clang $*

$(BUILD)/valgrind-$(VALGRIND_VERSION).tar.bz2: | $(BUILD)
	$(call fetch,$(VALGRIND_URL),$(VALGRIND_SHA256))

# With valgrind's own flags, not ours: it measures, it is not measured.
# It finds its files by the folder it is installed in, so moving this
# folder needs a rebuild (make clean). Installed into a staging folder
# first and moved in whole, so a failed install leaves no build/valgrind
# that looks finished.
$(BUILD)/valgrind/bin/valgrind: $(BUILD)/valgrind-$(VALGRIND_VERSION).tar.bz2 $(VALGRIND_PATCH) Makefile
	rm -rf $(VALGRIND_SRC) $(BUILD)/valgrind $(BUILD)/valgrind-staging
	tar -xjf $< -C $(BUILD)
	patch -d $(VALGRIND_SRC) -p1 --quiet <$(VALGRIND_PATCH)
	cd $(VALGRIND_SRC) && $(BUILDENV) ./configure --quiet --prefix=$(CURDIR)/$(BUILD)/valgrind
	$(BUILDENV) $(MAKE) -C $(VALGRIND_SRC)
	$(BUILDENV) $(MAKE) -C $(VALGRIND_SRC) install DESTDIR=$(CURDIR)/$(BUILD)/valgrind-staging >/dev/null
	mv $(BUILD)/valgrind-staging$(CURDIR)/$(BUILD)/valgrind $(BUILD)/valgrind
	rm -rf $(BUILD)/valgrind-staging

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all zstd xz sqlite git magick clang gcc valgrind data check-inputs compile-gcc compile-clang clean
