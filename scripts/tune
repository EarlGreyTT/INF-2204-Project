#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# tune -- tune the system for low-noise CPU time profiling (perf), and
# undo it
#
# Usage:
#   tune hold [<cpu>]
#   tune keep [<cpu>]
#   tune reset
#   tune check
#
#   hold    tune, then stay in the foreground and restore the system on
#           Ctrl-C or when the terminal closes; record from another one
#   keep    tune and exit; the system stays tuned until tune reset
#   reset   restore the system
#   check   show the current state, change nothing
#   <cpu>   the logical CPU to measure on (default: picked automatically)
#
# Tuning dedicates the physical core owning the CPU to measuring: takes
# its SMT sibling(s) offline, shields it from the scheduler, steers IRQs
# off it, pins the clock, and turns off THP, swap, radios and some
# background services. reset puts back what was there before.
#
# ASLR is left on: with it off every run gets the same memory layout,
# which may be a lucky or an unlucky one (Mytkowicz et al. 2009); with
# it on, repeated runs sample different layouts and their spread shows
# the effect.
#
# After every change tune checks that it took effect. If one did not, or
# on Ctrl-C, tune stops and undoes what it did. reset checks too: if a
# radio, a swap device or a service did not come back, it names it and
# exits with an error; run it again.
#
# The radios come back on by themselves an hour after tuning, even if
# this script is killed or never reset: a machine reached only over
# Wi-Fi (a Raspberry Pi over ssh, say) would otherwise stay out of
# reach. Over such a connection the session freezes while they are off,
# so run tune and record inside screen or tmux there.
#
# Needs only util-linux, systemd and coreutils (no Python or
# out-of-distro packages).
# Assumes /sys/devices/system/cpu/present is a contiguous range "0-N".
# Boot-time isolation (isolcpus=, nohz_full=, rcu_nocbs=) needs a
# reboot, so it is only suggested; the README says where it goes.

set -eu

STATE=/run/tune.state
ARMED=0

# perf's sampling ceiling while tuned (see the sample rate step below)
SAMPLE_RATE=100000

# seconds until the radios are turned back on regardless (see
# guard_radios); longer than any tuned session should take
RADIO_LIMIT=3600

die() {
	echo "tune: error: $1" >&2
	exit 1
}

# die with a fix: the command alone on its own line, to copy-paste
die_cmd() {
	echo "tune: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	if [ $# -ge 3 ]; then
		echo "$3" >&2
		echo "" >&2
	fi
	exit 1
}

note() {
	echo "tune: $1" >&2
}

# usage [0]: prints the header's Usage block and exits; with 0 (for -h)
# to stdout, otherwise to stderr as an error
usage() {
	if [ "${1:-1}" = 0 ]; then
		usage_block
		exit 0
	fi
	usage_block >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

have() {
	command -v "$1" >/dev/null 2>&1
}

on_exit() {
	rc=$?
	# from here on nothing may stop the undoing, not even a message that
	# cannot be printed
	set +e
	if [ "$rc" -ne 0 ] && [ "$ARMED" = 1 ]; then
		# leaving a held tuning on Ctrl-C, SIGTERM or a closed terminal
		# is the intended way out, not a failure
		case "${HOLD:-0}:$rc" in
		1:129 | 1:130 | 1:143) ;;
		*) echo "tune: aborting, rolling back" >&2 ;;
		esac
		ARMED=0
		if do_reset; then
			echo "tune: system restored" >&2
		else
			echo "tune: error: rolling back failed" >&2
			echo "" >&2
			echo "fix it with:" >&2
			echo "" >&2
			echo "sudo $0 reset" >&2
			echo "" >&2
		fi
	fi
	exit "$rc"
}

cpu_max() {
	r=$(cat /sys/devices/system/cpu/present)
	echo "${r#*-}"
}

expand_cpulist() {
	oldifs=$IFS
	IFS=,
	set -- $1
	IFS=$oldifs
	for tok in "$@"; do
		case $tok in
		*-*)
			n=${tok%-*}
			hi=${tok#*-}
			while [ "$n" -le "$hi" ]; do
				echo "$n"
				n=$((n + 1))
			done
			;;
		*) echo "$tok" ;;
		esac
	done
}

# boot_covers <option> <cpu>: whether the kernel was booted with the
# option for that CPU. isolcpus can have flags before the CPUs
# (isolcpus=domain,managed_irq,3); =all is every CPU. An option without
# a list covers no CPU (rcu_nocbs alone offloads none at boot, per the
# kernel's documentation), and neither does a list in another form
# (0-7:2/4): then the hint is printed.
boot_covers() {
	# no globbing: the words are the kernel's, not file names
	set -f
	words=$(cat /proc/cmdline)
	set +f
	for w in $words; do
		case "$w" in
		"$1=all") return 0 ;;
		"$1="*) ;;
		*) continue ;;
		esac
		list=$(echo "${w#*=}" | sed 's/^\([a-z_]*,\)*//')
		case "$list" in
		"" | *[!0-9,-]* | *--* | -* | *-) continue ;;
		esac
		for c in $(expand_cpulist "$list"); do
			[ "$c" != "$2" ] || return 0
		done
	done
	return 1
}

# /proc/irq/default_smp_affinity takes a hex bitmask (there is no _list
# variant of that file), as comma-separated 32-bit words, most
# significant first.
cpulist_to_mask() {
	hi=$2
	w=$((hi / 32))
	out=""
	while [ "$w" -ge 0 ]; do
		val=0
		for c in $(expand_cpulist "$1"); do
			if [ $((c / 32)) -eq "$w" ]; then
				val=$((val | (1 << (c % 32))))
			fi
		done
		word=$(printf '%08x' "$val")
		if [ -z "$out" ]; then
			out=$word
		else
			out="$out,$word"
		fi
		w=$((w - 1))
	done
	echo "$out"
}

# compare two cpulists by content, so "0,1,2,4" matches "0-2,4"
cpulist_norm() {
	expand_cpulist "$1" | sort -n | tr '\n' ' '
}

# empty on a kernel built without THP (Raspberry Pi OS's): nothing to
# turn off there
thp_current() {
	[ -r /sys/kernel/mm/transparent_hugepage/enabled ] || return 0
	sed -n 's/.*\[\(.*\)\].*/\1/p' /sys/kernel/mm/transparent_hugepage/enabled
}

# per-CPU and per-IRQ settings for the state file, as "key:value ..."
# lists (key: a CPU or IRQ number)
saved_freqs() {
	for d in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
		lo=$(cat "$d/scaling_min_freq" 2>/dev/null) || continue
		hi=$(cat "$d/scaling_max_freq" 2>/dev/null) || continue
		c=${d%/cpufreq}
		printf '%s:%s:%s ' "${c##*/cpu}" "$lo" "$hi"
	done
}

saved_epps() {
	for d in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
		p=$(cat "$d/energy_performance_preference" 2>/dev/null) || continue
		c=${d%/cpufreq}
		printf '%s:%s ' "${c##*/cpu}" "$p"
	done
}

saved_irqs() {
	for f in /proc/irq/[0-9]*/smp_affinity_list; do
		a=$(cat "$f" 2>/dev/null) || continue
		n=${f#/proc/irq/}
		printf '%s:%s ' "${n%%/*}" "$a"
	done
}

# lookup list key: prints the value saved for key in such a list
lookup() {
	for kv in $1; do
		if [ "${kv%%:*}" = "$2" ]; then
			echo "${kv#*:}"
			return 0
		fi
	done
	return 1
}

swap_kb() {
	awk 'NR>1 {s+=$3} END {print s+0}' /proc/swaps
}

# Makes sure the radios about to be blocked come back, whatever happens
# to this script, the session it runs in or the machine. Takes them from
# radios and radio_types.
guard_radios() {
	# A timer of systemd's own turns them on again after RADIO_LIMIT. It
	# only unblocks; the rest of the tuning stays until reset. By id and
	# by type: a radio whose driver restarts meanwhile returns under a
	# new id.
	rf=$(command -v rfkill)
	cmd=
	if [ "$radios" = unknown ]; then
		cmd="$rf unblock all"
	else
		for r in $radios $radio_types; do
			cmd="$cmd$rf unblock $r; "
		done
	fi
	# one left over from a tuning that was never reset would make
	# systemd-run refuse the name
	radio_timer_off
	systemd-run --quiet --collect --unit=tune-radios \
		--on-active="$RADIO_LIMIT" --timer-property=AccuracySec=1s \
		/bin/sh -c "$cmd" ||
		die "could not start the timer that turns the radios back on, so they are left on"
	[ "$(systemctl is-active tune-radios.timer 2>/dev/null)" = active ] ||
		die "the timer that turns the radios back on is not running, so they are left on"
	RADIOS_BACK=$(date -d "+$RADIO_LIMIT seconds" +%H:%M)

	# systemd-rfkill saves every change of a radio and applies it at the
	# next boot, so a power cut while tuned would boot with the radios
	# off. Masked until reset, in /run: a reboot removes the mask too.
	if systemctl cat systemd-rfkill.socket >/dev/null 2>&1; then
		# it writes a change only as it exits, 5 s after the last one;
		# stopped before that, it loses the change
		wait_rfkill_saved
		systemctl mask --runtime --now --quiet systemd-rfkill.socket systemd-rfkill.service ||
			die "could not stop systemd-rfkill from saving the radios' state for the next boot"
		[ "$(systemctl is-enabled systemd-rfkill.socket 2>/dev/null)" = masked-runtime ] ||
			die "systemd-rfkill.socket is not masked, so a reboot while tuned could start with the radios off"
		for u in systemd-rfkill.socket systemd-rfkill.service; do
			if systemctl is-active --quiet "$u"; then
				die "$u is still active, so a reboot while tuned could start with the radios off"
			fi
		done
	fi
}

wait_rfkill_saved() {
	n=0
	while systemctl is-active --quiet systemd-rfkill.service && [ "$n" -lt 15 ]; do
		sleep 1
		n=$((n + 1))
	done
}

radio_timer_off() {
	systemctl stop tune-radios.timer tune-radios.service 2>/dev/null || true
	systemctl reset-failed tune-radios.timer tune-radios.service 2>/dev/null || true
}

# undoes guard_radios' mask; fails if there was none
rfkill_saving_on() {
	[ -L /run/systemd/system/systemd-rfkill.socket ] || return 1
	systemctl unmask --runtime --quiet systemd-rfkill.socket systemd-rfkill.service 2>/dev/null &&
		systemctl start systemd-rfkill.socket 2>/dev/null ||
		note "warning: could not turn systemd-rfkill back on; radio changes are not remembered until the next boot"
}

# types among $1 that have a blocked radio
types_blocked() {
	for t in $1; do
		if rfkill -n -o TYPE,SOFT 2>/dev/null | grep -q "^$t  *blocked"; then
			printf '%s ' "$t"
		fi
	done
}

# $1 without repeated words
once() {
	printf '%s\n' $1 | sort -u | tr '\n' ' '
}

# Sets id, type, was (on or off) and name from one word of radio_states.
radio_fields() {
	id=${1%%:*}
	name=${1#*:}
	type=${name%%:*}
	name=${name#*:}
	was=${name%%:*}
	name=${name#*:}
}

# The id a radio has now: its own, or the id of the radio of its name
# where it has a new one (an adapter whose switch was off for a while);
# nothing if it is gone.
radio_now() {
	if [ -e "/sys/class/rfkill/rfkill$1" ]; then
		echo "$1"
		return
	fi
	for d in /sys/class/rfkill/rfkill*; do
		if [ "$(tr -c '[:alnum:]._\n-' _ <"$d/name" 2>/dev/null)" = "$2" ]; then
			echo "${d##*rfkill}"
			return
		fi
	done
}

# Puts the radios back as radio_states has them, and turns the timer off
# once those that were on are on.
restore_radios() {
	# first of all, each by its id: the way back to a machine reached
	# over Wi-Fi
	if [ "$radios" = unknown ]; then
		rfkill unblock all || true
	else
		for id in $radios; do
			rfkill unblock "$id" 2>/dev/null || true
		done
	fi
	if rfkill_saving_on; then
		# Started again, systemd-rfkill sets every radio to the state it
		# has saved for it, which need not be the one it had before
		# tuning. Wait for that (it starts a moment after its socket);
		# what follows sets back what it changed, and systemd-rfkill
		# then saves that.
		sleep 2
		wait_rfkill_saved
	fi
	changed=
	failed=

	# Off before, on now: off again. One that is missing gets a moment
	# to return (an adapter does when its switch is on again); if it
	# comes later still, nothing here can turn it off.
	for k in $radio_states; do
		radio_fields "$k"
		[ "$was" = off ] || continue
		now=$(radio_now "$id" "$name")
		n=0
		while [ -z "$now" ] && [ "$n" -lt 5 ]; do
			sleep 1
			n=$((n + 1))
			now=$(radio_now "$id" "$name")
		done
		if [ -z "$now" ]; then
			note "warning: the $type radio $name was off and is missing now; if it returns, it may be on"
			continue
		fi
		f=/sys/class/rfkill/rfkill$now/soft
		if [ "$(cat "$f" 2>/dev/null)" = 0 ]; then
			rfkill block "$now" 2>/dev/null || true
			if [ "$(cat "$f" 2>/dev/null)" = 0 ]; then
				note "warning: could not turn the $type radio $name off again"
				failed=1
			else
				changed="$changed $type"
			fi
		fi
	done

	# A radio that was on before and is off now: on again. One that is
	# missing: its whole type on. Missing is normal on a ThinkPad: the
	# Bluetooth adapter disappears while its switch
	# (tpacpi_bluetooth_sw) is off, and returns with a new id once the
	# switch is on. One case does not end as it was: the switch read
	# "off" before tuning although the adapter was on. The adapter
	# cannot be on while its switch is off, so the switch ends "on".
	types=$radio_types
	for k in $radio_states; do
		radio_fields "$k"
		[ "$was" = on ] || continue
		now=$(radio_now "$id" "$name")
		f=/sys/class/rfkill/rfkill$now/soft
		if [ -z "$now" ]; then
			types="$types $type"
		elif [ "$(cat "$f" 2>/dev/null)" != 0 ]; then
			rfkill unblock "$now" 2>/dev/null || true
			changed="$changed $type"
		fi
	done
	types=$(once "$types")
	for t in $(types_blocked "$types"); do
		rfkill unblock "$t" 2>/dev/null || true
		changed="$changed $t"
	done
	left=$(types_blocked "$types")
	for k in $radio_states; do
		radio_fields "$k"
		[ "$was" = on ] || continue
		now=$(radio_now "$id" "$name")
		if [ -n "$now" ] && [ "$(cat "/sys/class/rfkill/rfkill$now/soft" 2>/dev/null)" != 0 ]; then
			left="$left $type"
		fi
	done
	if [ -n "$left" ]; then
		note "warning: could not turn these radios back on: $(once "$left")"
		failed=1
	fi
	if [ -n "$failed" ]; then
		note "the timer that turns the radios on at the time limit is left running"
		lost="$lost radios;"
	else
		radio_timer_off
		if [ -n "$changed" ]; then
			note "radios put back as before tuning: $(once "$changed")"
		fi
	fi
}

set_verify() {
	path=$1
	want=$2
	echo "$want" > "$path" 2>/dev/null || die "cannot write $path (wanted $want)"
	got=$(cat "$path")
	[ "$got" = "$want" ] || die "$path reads back as '$got', expected '$want'"
}

preflight() {
	[ "$(id -u)" = 0 ] || die_cmd "must run as root" "sudo $0 $ARGS"

	for c in systemctl systemd-run awk sed sort tr; do
		have "$c" || die "missing required command: $c"
	done

	if ! have rfkill; then
		if have apt-get; then
			fix="sudo apt install rfkill"
		elif have dnf; then
			fix="sudo dnf install util-linux"
		elif have pacman; then
			fix="sudo pacman -S util-linux"
		else
			fix="(install rfkill with your package manager)"
		fi
		die_cmd "rfkill is not installed (needed to disable radios)" "$fix"
	fi

	if [ ! -d /sys/fs/cgroup/system.slice ]; then
		die "no cgroup v2 unified hierarchy at /sys/fs/cgroup -- shielding needs it"
	fi
	if ! grep -qw cpuset /sys/fs/cgroup/cgroup.controllers 2>/dev/null; then
		die_cmd "the cpuset cgroup controller is not enabled, so systemd cannot shield a CPU" \
			"cat /sys/fs/cgroup/cgroup.controllers" \
			"That lists the controllers actually available. If cpuset is
missing from it, this kernel or boot configuration cannot do cgroup
CPU shielding at all."
	fi

	# on battery the clock, and so the time per cycle, can change mid-run;
	# no power supply entries at all: a desktop
	ac=desktop
	for f in /sys/class/power_supply/*/online; do
		[ -r "$f" ] || continue
		if [ "$(cat "$f")" = 1 ]; then
			ac=1
		elif [ "$ac" = desktop ]; then
			ac=0
		fi
	done
	if [ "$ac" = 0 ]; then
		die "no AC adapter detected -- plug in the power cable; on battery the CPU clock can drop mid-run"
	fi

	# intel_pstate and nohz_full are incompatible: with nohz_full the
	# CPU frequency goes unstable under intel_pstate.
	# https://bugzilla.redhat.com/show_bug.cgi?id=1378529
	if [ -d /sys/devices/system/cpu/intel_pstate ]; then
		nhf=$(cat /sys/devices/system/cpu/nohz_full 2>/dev/null || echo "")
		case "$nhf" in
		"" | "(null)") ;;
		*) die "nohz_full=$nhf is active together with the intel_pstate driver; that combination makes the CPU frequency unstable (RH bug 1378529). Drop nohz_full= or boot with intel_pstate=disable." ;;
		esac
	fi

	[ -r /sys/devices/system/cpu/present ] || die "cannot read /sys/devices/system/cpu/present"
}

report() {
	max=$(cpu_max)
	echo "CPUs present:        0-$max"
	off=""
	i=0
	while [ "$i" -le "$max" ]; do
		f="/sys/devices/system/cpu/cpu$i/online"
		if [ -f "$f" ] && [ "$(cat "$f")" = 0 ]; then
			off="$off $i"
		fi
		i=$((i + 1))
	done
	echo "CPUs offline:       ${off:- none}"
	echo "governor (cpu0):     $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
	echo "no_turbo:            $(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || echo n/a)"
	echo "cpufreq boost:       $(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo n/a)"
	echo "cpu0 freq floor/ceil: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 2>/dev/null || echo n/a) / $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || echo n/a)"
	capped=
	for d in /sys/devices/system/cpu/cpu*/cpufreq; do
		[ -r "$d/scaling_max_freq" ] && [ -r "$d/cpuinfo_max_freq" ] || continue
		if [ "$(cat "$d/scaling_max_freq")" != "$(cat "$d/cpuinfo_max_freq")" ]; then
			c=${d%/cpufreq}
			capped="$capped ${c##*/}"
		fi
	done
	echo "ceiling below max:  ${capped:- none}"
	ac=$(cat /sys/class/power_supply/A*/online 2>/dev/null | head -1)
	echo "on AC power:         ${ac:-n/a}"
	echo "ASLR:                $(cat /proc/sys/kernel/randomize_va_space)"
	thp=$(thp_current)
	echo "THP:                 ${thp:-n/a}"
	echo "swap turned on (KiB): $(swap_kb)"
	echo "perf sample rate:    $(cat /proc/sys/kernel/perf_event_max_sample_rate 2>/dev/null || echo n/a)"
	echo "perf cpu time limit: $(cat /proc/sys/kernel/perf_cpu_time_max_percent 2>/dev/null || echo n/a) % (0: off)"
	echo "system.slice cpus:   $(cat /sys/fs/cgroup/system.slice/cpuset.cpus.effective 2>/dev/null || echo n/a)"
	echo "user.slice cpus:     $(cat /sys/fs/cgroup/user.slice/cpuset.cpus.effective 2>/dev/null || echo n/a)"
	echo "radios:              $(rfkill -n -o TYPE,SOFT 2>/dev/null | tr '\n' ' ' || true)"
	echo "radio timer:         $(systemctl is-active tune-radios.timer 2>/dev/null || true)"
	echo "tuning state file:   $([ -f "$STATE" ] && echo present || echo absent)"
}

do_reset() {
	# not to be interrupted: stopped half-way, radios, swap and services
	# would stay off
	trap '' HUP INT TERM PIPE
	max=$(cpu_max)

	i=0
	while [ "$i" -le "$max" ]; do
		f="/sys/devices/system/cpu/cpu$i/online"
		if [ -f "$f" ] && [ "$(cat "$f")" = 0 ]; then
			echo 1 > "$f" || note "warning: could not bring cpu $i back online"
		fi
		i=$((i + 1))
	done

	# empty unless the state file saved them (older ones did not)
	freqs=
	epps=
	irqs=
	had_state=0
	if [ -f "$STATE" ]; then
		had_state=1
		. "$STATE"
		if [ "$governor" != unknown ]; then
			for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
				if [ -w "$f" ]; then
					echo "$governor" > "$f" 2>/dev/null || true
				fi
			done
		fi
		# after the governor: with the performance governor the kernel
		# refuses any other preference
		for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
			c=${f%/cpufreq/*}
			p=$(lookup "$epps" "${c##*/cpu}") && echo "$p" > "$f" 2>/dev/null || true
		done
		if [ "$turbo" != unknown ]; then
			echo "$turbo" > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
		fi
		if [ "${boost:-unknown}" != unknown ]; then
			echo "$boost" > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || true
		fi
		# before the sample rate: the kernel refuses that write while
		# the limit is off
		if [ "${cputime:-unknown}" != unknown ]; then
			echo "$cputime" > /proc/sys/kernel/perf_cpu_time_max_percent 2>/dev/null || true
		fi
		if [ "$samplerate" != unknown ]; then
			echo "$samplerate" > /proc/sys/kernel/perf_event_max_sample_rate 2>/dev/null || true
		fi
		if [ -n "$thp" ]; then
			echo "$thp" > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
		fi
	fi

	# Restoring turbo does not lift the ceiling of a CPU that was offline
	# while turbo was off (observed: the SMT sibling stayed at 800 MHz),
	# so both limits are set back explicitly, after turbo: to the saved
	# ones, or else the hardware's.
	for d in /sys/devices/system/cpu/cpu*/cpufreq; do
		[ -w "$d/scaling_min_freq" ] && [ -w "$d/scaling_max_freq" ] || continue
		[ -r "$d/cpuinfo_min_freq" ] && [ -r "$d/cpuinfo_max_freq" ] || continue
		c=${d%/cpufreq}
		if f=$(lookup "$freqs" "${c##*/cpu}"); then
			lo=${f%:*}
			hi=${f#*:}
		else
			lo=$(cat "$d/cpuinfo_min_freq")
			hi=$(cat "$d/cpuinfo_max_freq")
		fi
		# the floor down first, so no write crosses the other limit
		cat "$d/cpuinfo_min_freq" > "$d/scaling_min_freq" 2>/dev/null || true
		echo "$hi" > "$d/scaling_max_freq" 2>/dev/null || true
		echo "$lo" > "$d/scaling_min_freq" 2>/dev/null || true
		if [ "$(cat "$d/scaling_max_freq")" != "$hi" ]; then
			note "warning: $c is capped at $(cat "$d/scaling_max_freq") kHz, not $hi kHz as before"
		fi
	done
	if [ "${defaffinity:-unknown}" != unknown ]; then
		echo "$defaffinity" > /proc/irq/default_smp_affinity 2>/dev/null || true
	fi

	for u in init.scope system.slice user.slice tune.slice; do
		systemctl set-property --runtime "$u" AllowedCPUs="0-$max" 2>/dev/null || true
	done
	# IRQs registered while tuned have no saved affinity: all CPUs.
	# Some IRQs refuse any write (the kernel manages their affinity).
	for f in /proc/irq/[0-9]*/smp_affinity_list; do
		n=${f#/proc/irq/}
		a=$(lookup "$irqs" "${n%%/*}") || a="0-$max"
		echo "$a" > "$f" 2>/dev/null || true
	done

	# Radios, swap and services are put back as they were. Without a state
	# file they may be off by choice (a reset with nothing to undo once
	# turned Bluetooth on), so they are left alone. An older tune's state
	# file lacks the lists: then all are turned on.
	if [ "$had_state" = 0 ]; then
		note "no saved state ($STATE): clock limits and IRQs set to their defaults; radios, swap and services left as they are"
		rfkill_saving_on || true
		return 0
	fi
	# what did not come back; with any, the state file stays for another
	# reset
	lost=
	radios=${radios-unknown}
	radio_types=${radio_types-}
	radio_states=${radio_states-}
	restore_radios
	if [ "${swaps+set}" = set ]; then
		# not swapon -a: a swap file set up outside /etc/fstab (Raspberry
		# Pi OS's, say) would stay off
		# each as "device:priority"; a negative priority is the kernel's
		# own choice, not a setting
		for s in $swaps; do
			case "${s##*:}" in
			-* | *[!0-9]* | "") swapon "${s%:*}" 2>/dev/null || true ;;
			*) swapon -p "${s##*:}" "${s%:*}" 2>/dev/null || true ;;
			esac
			awk -v d="${s%:*}" 'NR > 1 && $1 == d { on = 1 } END { exit !on }' /proc/swaps ||
				lost="$lost swap on ${s%:*};"
		done
	else
		swapon -a 2>/dev/null || true
	fi
	if [ "${stopped+set}" = set ]; then
		svcs=$stopped
	else
		svcs="irqbalance cron crond cronie unattended-upgrades"
	fi
	for svc in $svcs; do
		systemctl cat "$svc" >/dev/null 2>&1 && systemctl start "$svc" 2>/dev/null || true
		# those in the saved list ran before
		if [ "${stopped+set}" = set ]; then
			systemctl is-active --quiet "$svc" || lost="$lost $svc;"
		fi
	done
	if [ -n "$lost" ]; then
		note "warning: not back as before:$lost"
		return 1
	fi
	# last, so that a reset that did not finish can be run again
	rm -f "$STATE"
}

auto_select() {
	max=$1
	best=$max
	sibs=$(cat "/sys/devices/system/cpu/cpu$max/topology/thread_siblings_list" 2>/dev/null || echo "$max")
	for s in $(expand_cpulist "$sibs"); do
		if [ "$s" -lt "$best" ]; then
			best=$s
		fi
	done
	if [ "$best" = 0 ]; then
		die "the auto-selected core is core 0, which cannot be isolated; run tune by hand with another CPU (see tune -h), or use a machine with more cores"
	fi
	echo "$best"
}

trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
# Output piped into a program that has ended (tee after Ctrl-C) would
# kill this script at its next message, before it could undo anything.
# Ignored, the message just fails.
trap '' PIPE

# the arguments, for a fix to print (checked before any is printed:
# a mode and a CPU number)
ARGS=$*
case "${1:-}" in
-h | --help)
	usage 0
	;;
check)
	[ $# -eq 1 ] || usage
	[ "$(id -u)" = 0 ] || die_cmd "must run as root" "sudo $0 $ARGS"
	report
	exit 0
	;;
reset)
	[ $# -eq 1 ] || usage
	[ "$(id -u)" = 0 ] || die_cmd "must run as root" "sudo $0 $ARGS"
	do_reset || die_cmd "the system is not restored in full" \
		"sudo $0 reset" \
		"If something cannot come back, give up on it with:

sudo rm $STATE"
	[ "$had_state" = 0 ] || note "system restored"
	exit 0
	;;
hold)
	HOLD=1
	shift
	;;
keep)
	HOLD=0
	shift
	;;
*)
	usage
	;;
esac
[ $# -le 1 ] || usage
if [ $# -eq 1 ]; then
	case "$1" in
	"" | *[!0-9]* | 0?*) usage ;;
	esac
fi

preflight

MAX=$(cpu_max)
[ "$MAX" -gt 0 ] || die "only one CPU present, nothing to isolate"

if [ -f "$STATE" ]; then
	die_cmd "$STATE exists: the system is already tuned, or a previous run left state behind" \
		"sudo $0 reset"
fi
i=1
while [ "$i" -le "$MAX" ]; do
	f="/sys/devices/system/cpu/cpu$i/online"
	if [ -f "$f" ] && [ "$(cat "$f")" = 0 ]; then
		die_cmd "cpu $i is already offline, so a previous run did not finish" \
			"sudo $0 reset"
	fi
	i=$((i + 1))
done

AUTO=
if [ $# -eq 1 ]; then
	BENCH=$1
	[ "$BENCH" -le "$MAX" ] || die "cpu $BENCH does not exist (max is $MAX)"
	if [ "$BENCH" = 0 ]; then
		die "refusing to isolate cpu 0"
	fi
else
	BENCH=$(auto_select "$MAX")
	AUTO=", auto-selected"
fi

# radios that are on now, and the swap in use, to restore exactly those
# (an rfkill too old for -o gives unknown: reset then unblocks all)
# radio_types: the types whose radios are all on, to turn on by type
# what cannot be found by id any more.
# radio_states: every radio as id:type:on|off:name, to set back what
# systemd-rfkill changes when it is started again (see restore_radios).
if rfkill -n -o ID,TYPE,SOFT >/dev/null 2>&1; then
	radios=$(rfkill -n -o ID,SOFT | awk '$2 == "unblocked" { printf "%s ", $1 }')
	radio_types=$(rfkill -n -o TYPE,SOFT | awk '
		$2 == "unblocked" { on[$1] = 1 }
		$2 == "blocked" { off[$1] = 1 }
		END { for (t in on) if (!(t in off)) printf "%s ", t }')
	radio_states=
	for d in /sys/class/rfkill/rfkill*; do
		[ -r "$d/soft" ] || continue
		case "$(cat "$d/soft")" in 0) on=on ;; *) on=off ;; esac
		radio_states="$radio_states${d##*rfkill}:$(cat "$d/type"):$on:$(tr -c '[:alnum:]._\n-' _ <"$d/name") "
	done
else
	radios=unknown
	radio_types=
	radio_states=
fi
{
	echo "radios='$radios'"
	echo "radio_types='$radio_types'"
	echo "radio_states='$radio_states'"
	echo "swaps='$(awk 'NR > 1 { printf "%s:%s ", $1, $5 }' /proc/swaps)'"
	echo "governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)"
	echo "turbo=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || echo unknown)"
	echo "boost=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo unknown)"
	echo "samplerate=$(cat /proc/sys/kernel/perf_event_max_sample_rate 2>/dev/null || echo unknown)"
	echo "cputime=$(cat /proc/sys/kernel/perf_cpu_time_max_percent 2>/dev/null || echo unknown)"
	echo "thp=$(thp_current)"
	echo "defaffinity=$(cat /proc/irq/default_smp_affinity 2>/dev/null || echo unknown)"
	echo "freqs='$(saved_freqs)'"
	echo "epps='$(saved_epps)'"
	echo "irqs='$(saved_irqs)'"
	# appended to below for each service stopped
	echo "stopped=''"
} > "$STATE.new"
# in one step, so that reset never reads half a file
mv "$STATE.new" "$STATE"
ARMED=1

# nothing to guard if no radio is on
if [ -n "$radios" ]; then
	guard_radios
fi
# Each radio by its id, not "all": that would also make the kernel block
# every radio that appears from then on, also after the reset, which
# unblocks by id. A radio may vanish when another one is blocked (a
# laptop's Bluetooth adapter with its switch), hence no error.
if [ "$radios" = unknown ]; then
	rfkill block all || die "rfkill block failed"
else
	for id in $radios; do
		rfkill block "$id" 2>/dev/null || true
	done
	still=$(rfkill -n -o TYPE,SOFT | awk '$2 == "unblocked" { printf "%s ", $1 }')
	[ -z "$still" ] || note "warning: these radios are still on: $still"
	# those that are off now, so record can tell when the timer has
	# turned them back on
	echo "radios_off='$(rfkill -n -o ID,SOFT | awk '$2 == "blocked" { printf "%s ", $1 }')'" >>"$STATE"
fi

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
	[ -w "$f" ] || continue
	set_verify "$f" performance
done
# Turbo off before the ceiling is read below, so the clock is pinned at
# the highest non-boost frequency: the only one the vendor guarantees
# can be sustained; thermal or power limits may drop a boost one mid-run.
# intel_pstate has no_turbo, acpi-cpufreq and amd-pstate cpufreq/boost.
if [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
	set_verify /sys/devices/system/cpu/intel_pstate/no_turbo 1
elif [ -w /sys/devices/system/cpu/cpufreq/boost ]; then
	set_verify /sys/devices/system/cpu/cpufreq/boost 0
else
	note "warning: no turbo/boost knob found; the pinned clock below may be one the CPU cannot sustain"
fi

# The governor alone leaves the floor at the hardware minimum. Raising
# scaling_min_freq to the maximum pins the clock, so a perf cycle sample
# is worth the same time at the end of a recording as at the start.
for d in /sys/devices/system/cpu/cpu*/cpufreq; do
	[ -w "$d/scaling_min_freq" ] || continue
	maxf=$(cat "$d/scaling_max_freq")
	set_verify "$d/scaling_min_freq" "$maxf"
done
PINNED=$(cat "/sys/devices/system/cpu/cpu$BENCH/cpufreq/scaling_max_freq" 2>/dev/null || echo unknown)

if [ -e /sys/kernel/mm/transparent_hugepage/enabled ]; then
	echo never > /sys/kernel/mm/transparent_hugepage/enabled || die "cannot disable THP"
	[ "$(thp_current)" = never ] || die "THP is still $(thp_current) after write"
	OFF="radios, THP and swap"
else
	OFF="radios and swap"
fi

used=$(awk 'NR > 1 { s += $4 } END { print s + 0 }' /proc/swaps)
if [ "$used" -gt 0 ]; then
	note "turning swap off (${used} KiB in use; this blocks until it is paged back in)"
fi
swapoff -a || die "swapoff failed"
[ "$(swap_kb)" = 0 ] || die "swap still in use after swapoff"

# only those running, so reset starts exactly those again; cron's unit
# is cron on Debian and Ubuntu, crond on Fedora, cronie on Arch
STOPPED=
stopped=
for svc in irqbalance cron crond cronie unattended-upgrades; do
	if systemctl is-active --quiet "$svc" 2>/dev/null; then
		systemctl stop "$svc" || die "could not stop $svc"
		STOPPED="$STOPPED${STOPPED:+, }$svc"
		stopped="$stopped $svc"
		echo "stopped='$stopped'" >>"$STATE"
	fi
done

# SMT sibling(s) offline only after the governor pass above: taking a
# CPU down first makes later cpufreq writes fail (observed: "echo: I/O
# error").
OFFLINED=
siblist=$(cat "/sys/devices/system/cpu/cpu$BENCH/topology/thread_siblings_list" 2>/dev/null || echo "$BENCH")
for s in $(expand_cpulist "$siblist"); do
	if [ "$s" = "$BENCH" ]; then
		continue
	fi
	set_verify "/sys/devices/system/cpu/cpu$s/online" 0
	OFFLINED="$OFFLINED${OFFLINED:+, }$s"
done

REMAINING=""
i=0
while [ "$i" -le "$MAX" ]; do
	if [ "$i" != "$BENCH" ]; then
		f="/sys/devices/system/cpu/cpu$i/online"
		if [ "$i" = 0 ] || { [ -f "$f" ] && [ "$(cat "$f")" = 1 ]; }; then
			REMAINING="$REMAINING,$i"
		fi
	fi
	i=$((i + 1))
done
REMAINING=${REMAINING#,}
[ -n "$REMAINING" ] || die "no CPUs left to host the system"

moved=0
for f in /proc/irq/[0-9]*/smp_affinity_list; do
	echo "$REMAINING" > "$f" 2>/dev/null && moved=$((moved + 1)) || true
done
[ "$moved" -gt 0 ] || die "could not steer any IRQ away from CPU $BENCH"
# per-IRQ affinity only covers IRQs that exist now; default_smp_affinity
# governs any registered from here on
if [ -w /proc/irq/default_smp_affinity ]; then
	mask=$(cpulist_to_mask "$REMAINING" "$MAX")
	echo "$mask" > /proc/irq/default_smp_affinity ||
		die "could not set default_smp_affinity to $mask"
fi

# cgroup-v2-native shielding. cset is not an option: it only speaks
# cgroup v1, which Ubuntu dropped in 21.10.
for u in init.scope system.slice user.slice; do
	systemctl set-property --runtime "$u" AllowedCPUs="$REMAINING" ||
		die "systemctl set-property failed on $u"
done

# The isolated CPU needs a slice of its own, or nothing can run on it:
# user.slice and system.slice were just restricted to the other CPUs.
# Programs run in it with "systemd-run --scope --slice=tune".
systemctl set-property --runtime tune.slice AllowedCPUs="$BENCH" ||
	die "could not create tune.slice for CPU $BENCH"

# check the shielding took effect, not just that systemd accepted it
want=$(cpulist_norm "$REMAINING")
for c in system.slice user.slice; do
	f="/sys/fs/cgroup/$c/cpuset.cpus.effective"
	[ -r "$f" ] || die "cannot read $f to verify shielding"
	got=$(cpulist_norm "$(cat "$f")")
	[ "$got" = "$want" ] ||
		die "shielding did not take effect: $c has cpus '$(cat "$f")', expected '$REMAINING'"
done

# The rest of what pyperf's "system tune" does (governor, turbo, IRQ
# affinity) is done above; it also drops perf_event_max_sample_rate to
# 1, which would throttle perf record, so the rate is raised instead.
if [ -w /proc/sys/kernel/perf_event_max_sample_rate ]; then
	# The kernel lowers the ceiling by itself whenever perf's interrupts
	# exceed its CPU time limit, as they do at a low clock ("perf:
	# interrupt took too long" in the kernel log), and then drops
	# samples. Turning the limit off keeps the ceiling; perf spends the
	# same time per sample either way. The ceiling can only be written
	# while the limit is on, and the kernel may lower it in between, so
	# the pair is retried.
	rate=/proc/sys/kernel/perf_event_max_sample_rate
	limit=/proc/sys/kernel/perf_cpu_time_max_percent
	[ -w "$limit" ] || die "cannot write $limit, so perf would get throttled at this clock"
	try=0
	while :; do
		echo 25 >"$limit" && echo "$SAMPLE_RATE" >"$rate" && echo 0 >"$limit" ||
			die "cannot write $rate and $limit"
		[ "$(cat "$rate")" = "$SAMPLE_RATE" ] && break
		try=$((try + 1))
		[ "$try" -lt 5 ] || die "the kernel kept lowering $rate below $SAMPLE_RATE"
	done
	[ "$(cat "$limit")" = 0 ] || die "$limit reads back as '$(cat "$limit")', expected '0'"
else
	note "warning: perf_event_max_sample_rate not writable; left as-is"
fi

# nohz_full is suggested only where it can be used: not with
# intel_pstate (preflight refuses that pair), and not on a kernel built
# without it (no nohz_full file)
params="isolcpus rcu_nocbs"
if [ ! -d /sys/devices/system/cpu/intel_pstate ] && [ -e /sys/devices/system/cpu/nohz_full ]; then
	params="$params nohz_full"
fi
missing=
for p in $params; do
	boot_covers "$p" "$BENCH" || missing="$missing $p=$BENCH"
done

case "$PINNED" in
*[!0-9]* | "") clock="$PINNED kHz" ;;
*) clock="$((PINNED / 1000)) MHz" ;;
esac
note "isolated CPU $BENCH$AUTO (${OFFLINED:+SMT sibling $OFFLINED offline, }$moved IRQs moved off it), clock pinned at $clock"
note "until restored: $OFF are off${STOPPED:+; $STOPPED stopped}"
if [ -n "$radios" ]; then
	note "the radios come back on by themselves at $RADIOS_BACK, if not restored before"
fi
if [ -n "$missing" ]; then
	if [ -d /sys/devices/system/cpu/intel_pstate ]; then
		note "for full isolation, also boot with$missing (nohz_full is left out: with intel_pstate it makes the clock unstable)"
	else
		note "for full isolation, also boot with$missing"
	fi
fi

if [ "$HOLD" = 1 ]; then
	# ARMED stays set: Ctrl-C/SIGTERM raises a non-zero exit, and the
	# EXIT trap undoes everything on the way out.
	echo "$BENCH"
	note "holding; record from another terminal, e.g.:"
	note ""
	note "sudo $(dirname "$0")/record time -n <nick> -w <workload> <program>"
	note ""
	note "press Ctrl-C here when done, to restore the system"
	note "(closing this terminal restores it too)"
	# short sleeps: a pending trap runs only once the foreground command
	# finishes, so a long sleep would delay the rollback
	while :; do
		sleep 1
	done
fi

ARMED=0
echo "$BENCH"
