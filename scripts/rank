#!/usr/bin/env python3

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

"""rank -- rank a run's instructions, source lines or functions by
how often they were sampled (perf) or ran (callgrind), or show one
function's instructions

Usage:
  rank time <level> <perf-data> <program-name>
  rank count <level> <callgrind-output> <valgrind-log>
  rank count <level> <sum>
  rank collect <folder> <program> <sum>
  rank time -a <function> [-b <binary>] <perf-data> <program-name>
  rank count -a <function> [-b <binary>] <callgrind-output> <valgrind-log>
  rank count -a <function> [-b <binary>] <sum>

  time      the samples in <perf-data> (perf record's output) of the
            process named <program-name>
  count     the executions in <callgrind-output> (recorded with
            --dump-instr=yes --skip-plt=no --collect-jumps=yes);
            <valgrind-log> is the same run's log from valgrind -v -v -v,
            for the load addresses; or a <sum> that collect wrote
  collect   sum the counts of every process that ran <program>, for a
            command that starts it many times (record count -p): reads
            callgrind.<pid>.out and valgrind.<pid>.log in <folder>
            (callgrind with --trace-children=yes) as each process ends,
            removes them, and stops once a file named "finished"
            appears there; writes <sum> (gzipped text). Processes of
            other programs are left out; one of another file with the
            program's name is an error. A process that becomes another
            program (exec) keeps only that program's counts.
  <level>   instructions, lines or functions
  -a        instead of the ranking: <function>'s disassembly, each
            instruction with its samples or count
  -b        disassemble <binary>, a stored copy of the program (e.g.
            measurements/<workload>/binaries/<hash>), instead of the file
            at the recorded path, which the next build overwrites

Prints CSV, most first, ties ordered by name so the ranks are the same
every time. file is the program or library the code is in; source is
a source file.
  instructions  rank,count,function,offset,file
  lines         rank,count,source,line,function,file
  functions     rank,count,function,source,file

An instruction is function+offset in file, the way perf names it.
Where no symbol covers it, function is [unknown] and offset is its
address in the file (the address objdump shows); for the kernel, its
modules and code in no file, the address perf gives. Functions with
the same name in one file (static functions in different source files,
some PLT entries) get their address: fn_init[0x2bb9a0].

Lines and functions are the source code's, from the debug information:
code the compiler copied into another function (inlined) still belongs
to the function and lines it was written in. time adds up the samples
of a line's or function's instructions. count is how many times a line
or function ran: a function, how often it was entered from outside it
(each inlined copy by itself, at the place the debug information says
it starts); a line, the same plus each time around a loop that lies
wholly on the line, the way gcov counts lines. These come from the counts and the
jumps callgrind recorded, in the compiled program. Without
optimization (-O0) lines match gcov exactly. With it, the compiler
moves, merges, copies and removes lines, so a line's count can be far
from how often the source line ran, and some lines have no code at all
(quicksort at -O2: several lines missing, one 3.5 times too low).
Functions stay close (zstd at -O2: 238 of 253 as gcov counts them).
Code with no line in the debug information is left out of lines, and
stderr says how much; in functions, code with no debug information is
its symbol.

callgrind counts a rep-prefixed string instruction (rep movsb, ...)
once per repetition, e.g. once per byte copied; the CPU runs it as one
instruction. count gives it the times it was reached instead (from
recordings without jumps: the count of the instruction before it), and
says so on stderr.

record calls this after each run. Rerun later, it gives the same
names only while the program, libc and their debug symbols are the
recorded versions: perf.data and callgrind.out store addresses. -a
checks a time run's binary by its build-id; a count run stores none,
so there -a only checks that the counts fall on instruction starts.
"""
import bisect
import contextlib
import csv
import getopt
import gzip
import io
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time
from array import array
from collections import Counter

import numpy as np


def die(msg):
    sys.exit(f"rank: error: {msg}")


LEVELS = ("instructions", "lines", "functions")

# With DEBUGINFOD_URLS set (Ubuntu sets it), binutils and perf fetch
# missing debug information over the network: what they find would
# depend on the network and on who runs rank (sudo drops the variable).
# The locale changes the order nm sorts names in.
ENV = {k: v for k, v in os.environ.items() if k != "DEBUGINFOD_URLS"} | {"LC_ALL": "C"}


def run(*cmd, input=None):
    try:
        return subprocess.run(cmd, input=input, capture_output=True, text=True,
                              check=True, env=ENV).stdout
    except subprocess.CalledProcessError as e:
        die(f"{' '.join(map(os.fsdecode, cmd[:2]))} failed: {e.stderr.strip()}")


# -- time (perf) --

def perf_script(data, comm, fields):
    # the kernel keeps only the first 15 bytes as the process name
    return run("perf", "script", "-i", data, "--comms", os.fsencode(comm)[:15],
               "-G", "-F", fields).splitlines()


def rank_time(data, comm):
    """{(function, offset, file): samples}, named by perf."""
    named, unnamed = Counter(), Counter()
    for l in perf_script(data, comm, "ip,sym,symoff,dso"):
        # "ip sym+0xoff (/path/dso)"; without a symbol "ip [unknown] (...)"
        m = re.match(r"\s*([0-9a-f]+)\s+(.*) \(([^()]*)\)$", l)
        if not m:
            die(f"could not parse perf script output: {l}")
        func, _, off = m[2].rpartition("+0x")
        if func:
            named[(func, int(off, 16), m[3], int(m[1], 16))] += 1
        else:
            unnamed[(m[3], int(m[1], 16))] += 1
    # Those without a symbol get their address in the file, which is the
    # same in every run. So does a function that shares its name with
    # another in the file, which perf names alike. The kernel, its
    # modules and code in no file keep the address they ran at.
    paths = {p for p, _ in unnamed} | {p for _, _, p, _ in named}
    files = {p for p in paths if is_elf(p)}
    segs, where, dups = {}, {}, {}
    if files:
        ids = recorded_ids(data)
        for path in sorted(files):
            if build_id(path) == ids.get(path):
                segs[path] = segments(path)
                dups[path] = shared_names(symbols(path))
            elif any(p == path for p, _ in unnamed):
                print(f"warning: {path} changed since the run (build-id differs): its "
                      f"[unknown] rows have the addresses they ran at", file=sys.stderr)
        wanted = {(p, ip) for p, ip in unnamed if p in segs} | \
                 {(p, ip) for f, _, p, ip in named if f in dups.get(p, ())}
        if wanted:
            for l in perf_script(data, comm, "ip,dso,dsoff"):
                # "ip (/path/dso+0xoff)", the offset into the file
                m = re.match(r"\s*([0-9a-f]+)\s+\((.*)\+0x([0-9a-f]+)\)$", l)
                if m and (m[2], int(m[1], 16)) in wanted:
                    where[(m[2], int(m[1], 16))] = int(m[3], 16)
    loc = Counter()
    for (func, off, path, ip), n in named.items():
        if func in dups.get(path, ()):
            if (path, ip) not in where:
                die(f"perf script gave no file offset for {ip:#x} in {path}")
            func = f"{func}[{to_address(segs[path], where[(path, ip)]) - off:#x}]"
        loc[(func, off, file_name(path))] += n
    for (path, ip), n in unnamed.items():
        a = to_address(segs[path], where[(path, ip)]) if (path, ip) in where else None
        loc[("[unknown]", ip if a is None else a, file_name(path))] += n
    return loc


def time_samples(data, comm):
    """({object path: Counter(address)} for the samples in files, by the
    addresses in those files; Counter({(object, function): samples}) for
    the rest, named by perf: the kernel, its modules, code in no file
    and files changed since the run."""
    ids = recorded_ids(data)
    usable, offs, rest = {}, {}, Counter()
    for l in perf_script(data, comm, "ip,sym,dso,dsoff"):
        # "ip sym (/path/dso+0xoff)"; "ip [unknown] ([kernel.kallsyms]+0xaddress)"
        m = re.match(r"\s*[0-9a-f]+\s+(.*) \(([^()]*)\)$", l)
        if not m:
            die(f"could not parse perf script output: {l}")
        path, sep, off = m[2].rpartition("+0x")
        if not sep:
            path = m[2]
        elif not path.startswith("["):
            if path not in usable:
                usable[path] = is_elf(path) and build_id(path) == ids.get(path)
                # a kernel module's file (not ELF) is the kernel's: no lines;
                # so is /proc/kcore, perf's name for the kernel as root
                if (not usable[path] and path != "/proc/kcore"
                        and (is_elf(path) or not os.path.exists(path))):
                    print(f"warning: {path} is gone or changed since the run (build-id "
                          f"differs): its samples have no lines", file=sys.stderr)
            if usable[path]:
                offs.setdefault(path, Counter())[int(off, 16)] += 1
                continue
        rest[(path, m[1])] += 1
    return {p: file_to_address(p, o) for p, o in offs.items()}, rest


def rank_time_source(data, comm, level):
    """{row: samples} for lines or functions."""
    files, rest = time_samples(data, comm)
    loc, names, left = Counter(), {}, 0
    for path, addrs in files.items():
        places = source_places(path, addrs)
        for a, n in addrs.items():
            line, funcs = places[a]
            if level == "lines" and line:
                key = line + (os.path.basename(path),)
                loc[key] += n
                names.setdefault(key, set()).add(funcs[0][0][0])
            elif level == "functions" and funcs:
                loc[funcs[0][0] + (os.path.basename(path),)] += n
            else:
                left += n
    for (path, func), n in rest.items():
        if level == "functions" and func != "[unknown]":
            loc[(func, "", file_name(path))] += n
        else:
            left += n
    total = sum(loc.values()) + left
    print(f"samples: {total:,}", file=sys.stderr)
    print(f"left out, no {level[:-1]}: {left:,} samples ({100 * left / max(total, 1):.1f}%)",
          file=sys.stderr)
    return line_rows(loc, names) if level == "lines" else loc


def time_addresses(data, comm):
    """{object path: Counter(address)} for the samples in files, by the
    addresses in those files."""
    offs = {}
    for l in perf_script(data, comm, "ip,dso,dsoff"):
        # "ip (/path/dso+0xoff)", the offset into the file
        m = re.search(r"\(([^()]*)\)$", l)
        if not m:
            die(f"could not parse perf script output: {l}")
        if m[1].startswith("["):
            continue  # the kernel, or no file
        path, _, off = m[1].rpartition("+0x")
        offs.setdefault(path, Counter())[int(off, 16)] += 1
    return offs


def segments(path):
    """(offset in the file, address, size in the file) of each loadable
    segment of an ELF file."""
    segs = []
    for l in run("readelf", "-l", "-W", path).splitlines():
        f = l.split()
        if f and f[0] == "LOAD":
            segs.append((int(f[1], 16), int(f[2], 16), int(f[4], 16)))
    return segs


def to_address(segs, off):
    """The address of a file offset, or None if no segment has it."""
    for start, address, size in segs:
        if start <= off < start + size:
            return off - start + address


def file_to_address(path, offs):
    """Maps a Counter of file offsets to one of addresses."""
    segs, out = segments(path), Counter()
    for off, n in offs.items():
        a = to_address(segs, off)
        if a is None:
            die(f"{path}: offset {off:#x} is in no loadable segment")
        out[a] += n
    return out


def is_elf(path):
    """Whether a path is an ELF file. perf names a kernel module by its
    file, which can be compressed (btrfs.ko.xz)."""
    try:
        with open(path, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


def file_name(path):
    """The file column of a time row. perf names a kernel module [name],
    or by its file (on the Pi: .../btrfs.ko.xz); both give [btrfs], so
    that kernel code is always in brackets. As root perf names the kernel
    itself /proc/kcore: that is [kernel.kallsyms], as in the instruction
    lists."""
    if path == "/proc/kcore":
        return "[kernel.kallsyms]"
    if m := re.fullmatch(r"(.+)\.ko(?:\.[a-z0-9]+)?", os.path.basename(path)):
        return f"[{m[1].replace('-', '_')}]"
    return os.path.basename(path)


def build_id(path):
    m = re.search(r"Build ID: ([0-9a-f]+)", run("readelf", "-n", path))
    return m and m[1]


def recorded_ids(data):
    """{path: build-id} of the files a recording has samples in."""
    ids = {}
    for l in run("perf", "buildid-list", "-i", data).splitlines():
        bid, _, path = l.partition(" ")
        ids[path] = bid
    return ids


# -- count (callgrind) --

# lines of callgrind's output, compiled once: decode reads millions
OB = re.compile(r"(c?)ob=(?:\((\d+)\))? ?(.*)")
FILE = re.compile(r"(c?)f([lie])=(?:\((\d+)\))? ?(.*)")
CALLS = re.compile(r"calls=(\d+) (.*)")
JUMP = re.compile(r"(?:jump=(\d+)|jcnd=(\d+)/\d+) (.*)")


def decode(path):
    """Returns ({(file id, line or 0, object path, address): Ir},
    {(that key of the jumping instruction, target address): jumps},
    {(that key of the calling instruction, callee's object, target
    address): calls}, {file id: object path}), checked against the
    file's total.

    Callgrind's data is a tree: object, source file, function. A cost
    line's address is relative to the object its instruction is in,
    which need not be the object of the function the cost is charged to
    (ob=): code can run while callgrind still has a function of another
    object on its call stack. What tells the instruction's object:
    - With a line number, the instruction is in the line's source file
      (fl=, fi=, fe=), and file ids are unique per object. An id's
      object is given wherever it is a function's own file (fl= under
      ob=, cfl=/cfi= under cob=), not for a file only inlined code comes
      from (fi= alone). Each function (fn=) starts in its own file, the
      last fl=; an fi=/fe= right before a call is the call's, not the
      following cost lines'.
    - With line 0 there is no debug information, and the file id says
      nothing: callgrind writes such a count under the function's file,
      but a jump or call from the same instruction under "???". The key
      has no file then (None), so that both find the same instruction.
    Where the data does not tell, count_addresses decides.

    A jump (jump=, jcnd=) is written as its target, then a line with its
    source, the jumping instruction; both are relative to the last cost
    line and do not move on from it. A jump stays in its object.
    """
    names = {}       # callgrind shortens repeated object paths to "(id)"
    ob = None        # object of the function the cost lines are charged to
    cob = None       # object of the function called next, if not ob
    file = None      # id of the source file the cost lines are in
    fnfile = None    # id of the current function's own file
    switch = None    # an fi=/fe= not yet known to be for cost lines
    fileob = {}      # file id -> object
    pos = None       # last position; most are written relative to it
    instr = line = ir_col = None
    skip = False     # the cost line after calls= is the callee's total, not ours
    jump = None      # (target address, times taken) until the source line
    call = None      # (callee's object, target address, calls) until the source line
    total = None
    cost, jumps, calls = Counter(), Counter(), Counter()

    def at(p, file):
        n = p[line] if line is not None else 0
        return (file if n else None, n, ob, p[instr])

    def in_object(id, o):
        if fileob.setdefault(id, o) != o:
            die(f"{path}: source file ({id}) is in two objects, {fileob[id]} and {o}")

    # line by line: a file can be tens of MB, and collect may hold a
    # large sum already
    f = open(path)
    for l in f:
        if l[0] in "0123456789+-*":
            if pos is None or ir_col is None:
                die(f"{path}: cost line before the positions:/events: header")
            if skip:
                # written relative to the last position, like any cost
                # line, but callgrind does not move on from it
                calls[(at(moved(pos, l.split()), switch or file), call[0], call[1])] += call[2]
                cob, skip = None, False
                continue
            tok = l.split()
            if jump:
                jumps[(at(moved(pos, tok), switch or file), jump[0])] += jump[1]
                jump = None
                continue
            pos[:] = moved(pos, tok)
            col = len(pos) + ir_col
            if len(tok) > col:
                if switch:
                    file, switch = switch, None
                cost[at(pos, file)] += int(tok[col])
        elif m := OB.match(l.rstrip("\n")):
            callee, id, name = m.groups()
            if name:
                names[id] = name
            if callee:
                cob = name or names[id]
                switch = None
            else:
                ob = name or names[id]
        elif m := FILE.match(l.rstrip("\n")):
            callee, kind, id, name = m.groups()
            id = id or name
            if callee:
                in_object(id, cob or ob)
                switch = None
            elif kind == "l":
                file = fnfile = id
                switch = None
                in_object(id, ob)
            else:
                switch = id
        elif l.startswith("fn="):
            file, switch = fnfile, None
        elif l.startswith("cfn="):
            switch = None
        elif m := CALLS.match(l):
            if pos is None:
                die(f"{path}: call before the positions: header")
            call = (cob or ob, moved(pos, m[2].split())[instr], int(m[1]))
            skip = True
        elif m := JUMP.match(l):
            # jcnd=<taken>/<executed>: the rest went on to the next instruction
            if pos is None:
                die(f"{path}: jump before the positions: header")
            jump = (moved(pos, m[3].split())[instr], int(m[1] or m[2]))
        elif l.startswith("positions:"):
            kinds = l.split()[1:]
            if "instr" not in kinds:
                die(f"{path}: no instruction addresses; record with --dump-instr=yes")
            instr = kinds.index("instr")
            line = kinds.index("line") if "line" in kinds else None
            pos = [0] * len(kinds)
        elif l.startswith("events:"):
            events = l.split()[1:]
            if "Ir" not in events:
                die(f"{path}: no Ir event")
            ir_col = events.index("Ir")
        elif l.startswith(("summary:", "totals:")):
            total = int(l.split()[1 + ir_col])
    f.close()
    if pos is None:
        die(f"{path}: no instruction addresses; record with --dump-instr=yes")
    if total != sum(cost.values()):
        die(f"{path}: decoded {sum(cost.values())} Ir but the file's total is {total}")
    return cost, jumps, calls, fileob


def moved(pos, tok):
    """The position a cost or jump line gives: each number absolute, or
    relative (+n, -n) to the last position, * for the same."""
    pos = list(pos)
    for i, t in enumerate(tok[:len(pos)]):
        if t != "*":
            pos[i] = pos[i] + int(t, 0) if t[0] in "+-" else int(t, 0)
    return pos


def load_offsets(log):
    """{object path: load offset} from a valgrind -v -v -v log, which
    includes valgrind's own files."""
    offsets, path = {}, None
    with open(log) as f:
        lines = f.readlines()
    for l in lines:
        if m := re.search(r"Reading syms from (.+)$", l):
            path = m[1].strip()
        elif path and (m := re.search(r"svma (0x[0-9a-f]+), avma (0x[0-9a-f]+)", l)):
            offsets[path] = int(m[2], 16) - int(m[1], 16)
            path = None
    if not offsets:
        die(f"{log}: no load addresses; run valgrind with -v -v -v")
    return offsets


_lines = {}


def source_lines(path, addresses):
    """{address: source line, or 0 for none} by the file's debug
    information. Callgrind's line numbers come from the same information
    and are the same numbers. Kept, for collect's many processes of one
    program."""
    known = _lines.setdefault(path, {})
    new = sorted(set(addresses) - known.keys())
    if new:
        out = run("addr2line", "-e", path, input="".join(f"{a:#x}\n" for a in new))
        # "file:line", "file:line (discriminator n)", "??:0", "file:?"
        known.update({a: int(m[1]) if (m := re.search(r":(\d+)(?: \(.*\))?$", l)) else 0
                      for a, l in zip(new, out.splitlines())})
    return {a: known[a] for a in addresses}


def count_addresses(out, log):
    """({(object path or None, address): times run}, {(object path,
    address, target address): times jumped} or None for a run recorded
    without jumps, the same for calls inside one object, total Ir, Ir
    left out as valgrind's own code), rep string instructions counted
    once per execution."""
    cost, jumps, calls, fileob = decode(out)
    offsets = load_offsets(log)
    with open(log) as f:
        has_jumps = any(l.split()[-1:] == ["--collect-jumps=yes"] for l in f)
    tools = [p for p in offsets if os.path.basename(p).startswith("callgrind-")]
    if not tools:
        die(f"{log}: valgrind's own files not listed; is it a callgrind log?")
    tooldir = os.path.dirname(tools[0])
    sections = {p: code_sections(p) for p in offsets if os.path.exists(p)}

    def at_run_time(a, text=True):
        """(object, its address) for a run-time address, or None.
        Callgrind attributes only .text to its object: PLT, init and
        fini code has no object ("???"), a run-time address and no
        line."""
        for p, secs in sections.items():
            for name, s, e in secs:
                if s <= a - offsets[p] < e and (text or name != ".text"):
                    return p, a - offsets[p]

    def inside(p, a):
        return any(s <= a < e for _, s, e in sections.get(p, []))

    # A count with a source line belongs to the object its source file
    # is in. Callgrind does not say which object that is for a file that
    # only inlined code comes from. Then: if the debug information of
    # the function's object gives the same line for this address, it is
    # that object. If not, it is the only other object whose debug
    # information does.
    nameless = {}  # function's object -> {(address, line)}
    for (file, line, ob, a) in cost:
        if line and file not in fileob and ob in sections:
            nameless.setdefault(ob, set()).add((a, line))
    elsewhere = {}  # another object -> {(function's object, address, line)}
    for ob, pairs in nameless.items():
        lines = source_lines(ob, {a for a, _ in pairs})
        for a, line in pairs:
            if not (inside(ob, a) and lines[a] == line):
                for p in sections:
                    if p != ob and inside(p, a):
                        elsewhere.setdefault(p, set()).add((ob, a, line))
    agree = {}  # (function's object, address, line) -> [objects with that line there]
    for p, cases in elsewhere.items():
        lines = source_lines(p, {a for _, a, _ in cases})
        for case in cases:
            if lines[case[1]] == case[2]:
                agree.setdefault(case, []).append(p)

    # A count without a source line, listed under an object, is usually
    # that object's own code. It can also be code callgrind knows no
    # object for (PLT, init, fini), listed under the function that was
    # running; its address is then a run-time address.
    place, unsure = {}, {}  # cost key -> (object, address)
    for key in cost:
        file, line, ob, a = key
        if not line:
            own = ob
        elif file in fileob:
            own = fileob[file]
        else:
            fits = agree.get((ob, a, line), [])
            own = fits[0] if len(fits) == 1 else ob
        if own == "???":
            own, a = at_run_time(a) or (None, a)
        elif not line and (other := at_run_time(a, text=False)):
            if inside(own, a):
                unsure.setdefault(own, []).append((key, other))
                continue
            own, a = other
        place[key] = (own, a)
    # The address fits both. If the object has a source line there,
    # callgrind would have printed it, so the count is the other code;
    # otherwise it is the object's own.
    for own, cases in unsure.items():
        lines = source_lines(own, {key[3] for key, _ in cases})
        for key, other in cases:
            place[key] = other if lines[key[3]] else (own, key[3])
    ir = Counter()
    for key, n in cost.items():
        ir[place[key] + (key[2],)] += n

    stray = Counter()
    for (own, a, _), n in ir.items():
        if own in sections and not inside(own, a):
            stray[(own, a)] += n
    if stray:
        print(f"warning: {sum(stray.values()):,} Ir at {len(stray):,} addresses could not "
              f"be placed: not code in the object callgrind lists them under, and no "
              f"other object matches", file=sys.stderr)

    counts, skipped, other = Counter(), 0, Counter()
    for (own, a, ob), n in ir.items():
        if own and os.path.dirname(own) == tooldir:
            skipped += n  # valgrind's own code, absent from a native run
            continue
        counts[(own, a)] += n
        if ob != "???" and own != ob:
            other[(own, a)] += n
    if other:
        print(f"charged to a function of another object: {sum(other.values()):,} Ir "
              f"at {len(other):,} addresses, counted in their own object", file=sys.stderr)

    inside = Counter()
    for (key, callee, target), n in calls.items():
        if key in place and place[key] == (key[2], key[3]) == (callee, key[3]):
            inside[(callee, key[3], target)] += n
    if not has_jumps:
        count_rep_once(counts)
        return counts, None, inside, sum(cost.values()), skipped
    # A jump goes where its source instruction was placed, its target
    # with it: callgrind keeps a jump inside one object.
    arcs, lost = Counter(), 0
    for (key, target), n in jumps.items():
        if key not in place:
            lost += n
            continue
        own, a = place[key]
        if own and os.path.dirname(own) != tooldir:
            arcs[(own, a, target + a - key[3])] += n
    if lost:
        die(f"{out}: {lost:,} jumps from instructions with no count")
    count_rep_jumps(counts, arcs)
    return counts, arcs, inside, sum(cost.values()), skipped


REP = re.compile(r"rep[a-z]*\s+(movs|stos|cmps|scas|lods|ins|outs)")
# an unconditional jump to a fixed address: x86 jmp, arm64 b
DIRECT_JUMP = re.compile(r"(?:bnd |notrack )?(?:jmp|b)\s+([0-9a-f]+) <")


def count_rep_jumps(counts, arcs):
    """Gives each rep string instruction the times it was reached:
    callgrind records each repetition after the first as a jump to the
    instruction itself."""
    fixed, before, after = 0, 0, 0
    for (ob, a, target), n in list(arcs.items()):
        if a == target and ob and a in code(ob).rep:
            fixed, before, after = fixed + 1, before + counts[(ob, a)], after + counts[(ob, a)] - n
            counts[(ob, a)] -= n
            del arcs[(ob, a, target)]
    if fixed:
        print(f"rep string instructions: {fixed}, counted once per execution: "
              f"{before:,} Ir -> {after:,}", file=sys.stderr)


def count_rep_once(counts):
    """Gives each rep string instruction the count of the instruction
    before it. That is its executions unless a jump lands on it, which
    is warned about."""
    fixed, before, after = 0, 0, 0
    for ob in {ob for ob, _ in counts if ob and os.path.exists(ob)}:
        text, prev = instructions(ob)
        targets = set()
        for t in text.values():
            if m := re.match(r"(?:bnd |notrack )?(?:j[a-z]+|call)\s+([0-9a-f]+) <", t):
                targets.add(int(m[1], 16))
        for a, t in text.items():
            if not (REP.match(t) and (ob, a) in counts):
                continue
            n, p = counts[(ob, a)], prev[a]
            if p is None or (ob, p) not in counts or counts[(ob, p)] > n:
                print(f"warning: {os.path.basename(ob)} {a:#x} {t}: no instruction "
                      f"before it to count it by; left at {n:,}", file=sys.stderr)
                continue
            if a in targets:
                print(f"warning: {os.path.basename(ob)} {a:#x} {t}: a jump lands "
                      f"on it; its count may be too low", file=sys.stderr)
            fixed, before, after = fixed + 1, before + n, after + counts[(ob, p)]
            counts[(ob, a)] = counts[(ob, p)]
    if fixed:
        print(f"rep string instructions: {fixed}, counted once per execution: "
              f"{before:,} Ir -> {after:,}", file=sys.stderr)


INSTRUCTION = re.compile(r"\s+([0-9a-f]+):\s+(.*)")


class Code:
    """What the counts need of an object's instructions, kept small: a
    compiler has millions of them, and their text in a dict took
    gigabytes (2 GB for our cc1), several times over when counts run
    side by side. The addresses in order, which ones have no instruction
    right before them (after a label), the rep string instructions and
    the targets of unconditional jumps to a fixed address. By objdump,
    read as it comes."""

    def __init__(self, path):
        addrs, after_label = array("Q"), bytearray()
        jump_from, jump_to = array("Q"), array("Q")
        self.rep = set()
        last = None
        dump = subprocess.Popen(["objdump", "-d", "--no-show-raw-insn", "-w", path],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                env=ENV)
        for l in dump.stdout:
            m = INSTRUCTION.match(l)
            if not m:
                last = None  # a new function or section
                continue
            a = int(m[1], 16)
            addrs.append(a)
            after_label.append(last is None)
            last = a
            if REP.match(m[2]):
                self.rep.add(a)
            elif j := DIRECT_JUMP.match(m[2]):
                jump_from.append(a)
                jump_to.append(int(j[1], 16))
        err = dump.stderr.read()
        if dump.wait():
            die(f"objdump -d failed: {err.strip()}")
        order = np.argsort(np.frombuffer(addrs, dtype=np.uint64), kind="stable")
        self.addrs = np.frombuffer(addrs, dtype=np.uint64)[order]
        self.after_label = np.frombuffer(after_label, dtype=np.bool_)[order]
        # the instruction before each, in the file's order (objdump's)
        before = np.concatenate(([0], np.frombuffer(addrs, dtype=np.uint64)[:-1]))
        self.before = before[order]
        jorder = np.argsort(np.frombuffer(jump_from, dtype=np.uint64), kind="stable")
        self.jump_from = np.frombuffer(jump_from, dtype=np.uint64)[jorder]
        self.jump_to = np.frombuffer(jump_to, dtype=np.uint64)[jorder]

    @staticmethod
    def _find(keys, wanted):
        """For each wanted address, its index in keys, or -1."""
        wanted = np.fromiter(wanted, dtype=np.uint64)
        i = np.searchsorted(keys, wanted)
        i[i >= len(keys)] = 0
        hit = (keys[i] == wanted) if len(keys) else np.zeros(len(wanted), bool)
        return wanted, np.where(hit, i, -1)

    def prev_of(self, wanted):
        """{address: the instruction right before it, or None after a
        label} for the wanted addresses; None for one not in the code."""
        wanted, i = self._find(self.addrs, wanted)
        out = {}
        for a, k in zip(wanted.tolist(), i.tolist()):
            out[a] = None if k < 0 or self.after_label[k] else int(self.before[k])
        return out

    def jumps_of(self, wanted):
        """{address: target} for the wanted addresses that are
        unconditional jumps to a fixed address."""
        wanted, i = self._find(self.jump_from, wanted)
        keep = i >= 0
        return dict(zip(wanted[keep].tolist(), self.jump_to[i[keep]].tolist()))


_code = {}


def code(path):
    if path not in _code:
        _code[path] = Code(path)
    return _code[path]


_instructions = {}


def instructions(path):
    """({address: instruction} in address order, {address: the
    instruction right before it, or None after a label}), by objdump.
    The whole text: for count_rep_once (counts recorded without jumps)
    only; everything else uses code()."""
    if path not in _instructions:
        text, prev, last = {}, {}, None
        for l in run("objdump", "-d", "--no-show-raw-insn", "-w", path).splitlines():
            m = re.match(r"\s+([0-9a-f]+):\s+(.*)", l)
            if not m:
                last = None  # a new function or section
                continue
            a = int(m[1], 16)
            text[a], prev[a], last = m[2], last, a
        _instructions[path] = text, prev
    return _instructions[path]


def rank_count(data):
    counts, _, _, total, skipped = data
    loc = Counter()
    for (ob, a), n in counts.items():
        func, off = "[unknown]", a
        if ob and (sym := symbol_at(symbols(ob), a)):
            func, off = sym[2], a - sym[0]
        loc[(func, off, os.path.basename(ob) if ob else "[unknown]")] += n
    print(f"total Ir: {total:,}", file=sys.stderr)
    print(f"valgrind's own code, left out: {skipped:,} Ir", file=sys.stderr)
    return loc


def rank_count_source(data, level):
    """{row: times run} for lines or functions."""
    counts, arcs, calls, total, skipped = data
    if arcs is None:
        die("no jumps recorded, which lines and functions need; record "
            "count again (record now runs callgrind with --collect-jumps=yes)")
    objects, left = {}, 0
    for (ob, a), n in counts.items():
        if ob and os.path.exists(ob):
            objects.setdefault(ob, {})[a] = n
        else:
            left += n
    loc, names = Counter(), {}
    for ob, exe in objects.items():
        name = os.path.basename(ob)
        table, places = symbols(ob), source_places(ob, exe)
        starts = {start for start, _, _ in table}
        block, ran, pred, succ = flow(ob, exe, Counter({(a, t): n for (o, a, t), n in arcs.items()
                                                        if o == ob}), starts)
        # calls to the start of a function's split-off part
        split_calls = {(a, t): n for (o, a, t), n in calls.items()
                       if o == ob and a in exe and (sym := symbol_at(table, t))
                       and sym[0] == t and ".part." in sym[2]}
        # Each inlined copy of a line or function is counted by itself:
        # copies can follow each other in one block.
        groups = {}  # (line or function, copy) -> blocks
        for a, n in exe.items():
            line, funcs = places[a]
            if level == "lines" and line:
                groups.setdefault((line + (name,), funcs[0][1]), set()).add(block[a])
                names.setdefault(line + (name,), set()).add(funcs[0][0][0])
            elif level == "functions" and funcs:
                for f, copy in funcs:
                    groups.setdefault((f + (name,), copy), set()).add(block[a])
            else:
                left += n
        # An inlined copy is counted where it starts. Elsewhere, control
        # can come in from another copy: the compiler makes copies share
        # code, which the debug information gives to one of them.
        if level == "functions":
            # the blocks where each copy starts: the debug information
            # gives the instruction at a start address to that copy
            first, starts, itself = {}, {}, set()
            if any(copy for _, copy in groups):
                where, itself = entry_points(ob, exe)
                for f, at in where.items():
                    starts[f] = {block[a] for a in at if a in block}
                    for a in at:
                        for g, copy in places.get(a, (None, ()))[1]:
                            if g[0] == f and a in block:
                                first.setdefault((g + (name,), copy), set()).add(block[a])
        for (key, copy), blocks in groups.items():
            if level == "functions" and copy:
                caller = copy[0]
                if caller[:2] == key[:2] and (key[0], caller[2]) in itself:
                    continue  # the function itself, counted as such
                # Where the debug information gives the start to another
                # copy: a start of the function among this copy's blocks.
                # Where the start is never entered from outside (a loop
                # begins there, or the code that ran is elsewhere): as any
                # other code.
                loc[key] += (entries(first.get((key, copy), set()), ran, pred, blocks)
                             or entries(blocks & starts.get(key[0], set()), ran, pred, blocks)
                             or entries(blocks, ran, pred))
            elif level == "functions":
                # GCC can split a function: a small head, often inlined,
                # calls the rest, f.part.N. The run began at the head.
                # A head that jumps to the rest (jmp, b) is written as a
                # call too, but flow already made that jump one inside f:
                # not an entry, so nothing to take away.
                loc[key] += entries(blocks, ran, pred) - sum(
                    n for (a, t), n in split_calls.items()
                    if block.get(t) in blocks and symbol_at(table, t)[2].startswith(key[0] + ".part.")
                    and any(f[0] == key[0] for f, _ in places[a][1])
                    and not (block[a] in blocks and code(ob).jumps_of([a])))
            else:
                loc[key] += entries(blocks, ran, pred)
            if level == "lines":
                loc[key] += loops(blocks, succ)
    print(f"total Ir: {total:,}", file=sys.stderr)
    print(f"valgrind's own code, left out: {skipped:,} Ir", file=sys.stderr)
    print(f"left out, no {level[:-1]}: {left:,} instructions run "
          f"({100 * left / max(sum(counts.values()), 1):.1f}%)", file=sys.stderr)
    if never := [key for key, n in loc.items() if not n]:
        print(f"left out, ran but counted as never entered: {len(never)} functions",
              file=sys.stderr)
        for key in never:
            del loc[key]
    return line_rows(loc, names) if level == "lines" else loc


def flow(ob, exe, jumps, starts):
    """The basic blocks of the code that ran in one object, from its
    counts and jumps: ({address: block}, [times each block ran],
    {block: [(block before it, times)]}, {block: [(block after it,
    times)]}). Blocks are numbered in address order.

    What reached an instruction and was no jump came from the
    instruction right before it, unless it starts a function: then it
    was a call. A block ends where control can go elsewhere."""
    prev, direct = code(ob).prev_of(exe), code(ob).jumps_of(exe)
    out = Counter()
    for (a, _), n in jumps.items():
        out[a] += n
    # Some unconditional jumps are not in the jumps: valgrind can follow
    # one into the code after it (arm64, valgrind 3.24), and callgrind
    # writes a jump to another function (a tail call, f.cold back to f)
    # as a call. Such a jump goes to its one target every time it runs.
    for a, n in exe.items():
        if (t := direct.get(a)) is not None:
            if n > out[a]:
                jumps[(a, t)] += n - out[a]
    into, out = Counter(), Counter()
    for (a, t), n in list(jumps.items()):
        if a not in exe:
            die(f"{ob}: a jump from {a:#x}, which has no count")
        if t not in exe:
            # The process ended there (_exit's system call): callgrind
            # counted the jump but not the code it jumped to.
            del jumps[(a, t)]
            continue
        into[t] += n
        out[a] += n
    on = {}  # address -> times control went on to it from the instruction before
    for a in exe:
        if exe[a] < into[a]:
            die(f"{ob}: {a:#x} ran {exe[a]:,} times but was jumped to {into[a]:,} times")
        p = prev.get(a)
        if p in exe and a not in starts:
            # more than can have come from p came from outside (longjmp)
            on[a] = min(exe[a] - into[a], exe[p] - out[p])
    block, ran = {}, []
    for a in sorted(exe):
        p = prev.get(a)
        if not (p in block and into[a] == 0 and out[p] == 0 and on.get(a) == exe[p] == exe[a]):
            ran.append(exe[a])
        block[a] = len(ran) - 1
    arcs = Counter()
    for a, n in on.items():
        if n and block[prev[a]] != block[a]:
            arcs[(block[prev[a]], block[a])] += n
    for (a, t), n in jumps.items():
        arcs[(block[a], block[t])] += n
    pred, succ = {}, {}
    for (b, c), n in sorted(arcs.items()):
        pred.setdefault(c, []).append((b, n))
        succ.setdefault(b, []).append((c, n))
    return block, ran, pred, succ


def entries(blocks, ran, pred, inside=None):
    """How often control entered a set of blocks from outside it (or
    from outside the set inside)."""
    inside = blocks if inside is None else inside
    return sum(ran[b] - sum(n for p, n in pred.get(b, ()) if p in inside) for b in blocks)


def loops(blocks, succ):
    """How often control went around loops that stay inside a set of
    blocks: gcov's get_cycles_count (gcc/gcov.cc), which finds each
    loop (Johnson's algorithm) and takes away the smallest count on it
    from all its arcs until none is left."""
    left = {(b, c): n for b in blocks for c, n in succ.get(b, ()) if c in blocks}
    after = {b: [c for c, _ in succ.get(b, ()) if c in blocks] for b in blocks}
    count = 0

    def circuit(v, start, path, blocked, waiting):
        nonlocal count
        found = False
        blocked.add(v)
        waiting[v] = set()
        for w in after[v]:
            if w < start or left[(v, w)] <= 0:
                continue
            path.append((v, w))
            if w == start:
                m = min(left[e] for e in path)
                count += m
                for e in path:
                    left[e] -= m
                found = True
            elif all(left[e] > 0 for e in path) and w not in blocked:
                found |= circuit(w, start, path, blocked, waiting)
            path.pop()
        if found:
            unblock(v, blocked, waiting)
        else:
            for w in after[v]:
                if w >= start and left[(v, w)] > 0:
                    waiting.setdefault(w, set()).add(v)
        return found

    def unblock(u, blocked, waiting):
        if u in blocked:
            blocked.discard(u)
            for x in waiting.pop(u, ()):
                unblock(x, blocked, waiting)

    for start in sorted(blocks):
        circuit(start, start, [], set(), {})
    return count


def line_rows(loc, names):
    """{(source, line, function, file): n} from {(source, line, file):
    n}. A line in several functions (written in a macro that makes
    functions) lists them all, joined by |."""
    return Counter({(src, line, "|".join(sorted(names[k])), f): n
                    for k, n in loc.items() for src, line, f in [k]})


def source_places(path, addresses):
    """{address: ((source, line) or None, [((function, source), copy),
    ...] the functions it is part of, innermost first)}, by the debug
    information (addr2line). A copy tells apart the places a function
    was inlined at: the calls it is inlined through. Without debug
    information: no line, and the symbol as the function."""
    addresses = sorted(addresses)
    # Read as it comes, and each name, file and chain of calls kept once:
    # for clang's two million addresses, addr2line's output in one string
    # and a new string per frame took gigabytes.
    shared = {}

    def one(x):
        return shared.setdefault(x, x)

    with tempfile.TemporaryFile("w+") as inp:
        inp.writelines(f"{a:#x}\n" for a in addresses)
        inp.seek(0)
        # stderr to a file, so that a long one cannot block addr2line
        with tempfile.TemporaryFile("w+") as err:
            dump = subprocess.Popen(["addr2line", "-a", "-f", "-i", "-e", path], stdin=inp,
                                    stdout=subprocess.PIPE, stderr=err, text=True, env=ENV)
            frames = read_frames(dump.stdout, path, one)
            if dump.wait():
                err.seek(0)
                die(f"addr2line failed: {err.read().strip()}")
    if set(frames) != set(addresses):
        die(f"addr2line gave {len(frames)} of {len(addresses)} addresses in {path}")
    table, places = symbols(path), {}
    for a in addresses:
        if f := frames[a]:
            # a frame's own place is in it; the next frame's is the call
            places[a] = (one(f[0][1:3]) if f[0][2] else None,
                         [(one((name, src)), one(tuple(f[i + 1:])))
                          for i, (name, src, _) in enumerate(f)])
        else:
            sym = symbol_at(table, a)
            places[a] = (None, [(one((sym[2], "")), ())] if sym else [])
    return places


def read_frames(out, path, one):
    """{address: [(function, source, line), ...] innermost first} from
    addr2line -a -f -i's lines, each value kept once by one()."""
    frames, a, func = {}, None, None
    for l in (l.rstrip("\n") for l in out):
        if re.fullmatch(r"0x[0-9a-f]+", l) and func is None:
            a = int(l, 16)
            frames[a] = []
        elif func is None:
            func = l
        else:
            # "file:line", "file:line (discriminator n)", "??:0", "file:?"
            # (the discriminator is the instruction's, also on the calls)
            m = re.fullmatch(r"(.*):(\d+|\?)(?: \(discriminator \d+\))?", l)
            if not m:
                die(f"addr2line: could not parse {l!r} for {a:#x} in {path}")
            if m[1] != "??" and func != "??":
                frames[a].append(one((one(func), one(source_name(m[1])),
                                      int(m[2]) if m[2] != "?" else 0)))
            func = None
    return frames


def entry_points(path, ran):
    """({function: {address}}, {(function, line)}), by the debug
    information: where the inlined copies of each function start
    (DW_AT_entry_pc, else DW_AT_low_pc), of the starts only those among
    the addresses that ran (the only ones asked for), and the copies of a function
    inlined into itself at its own first line, which are the function
    itself (how GCC describes a function it split, like glibc's
    __random)."""
    if " .debug_info " not in run("readelf", "-S", "-W", path):
        path = debug_file(path)
        if not path:
            return {}, set()
    # Only functions and their inlined copies are kept: what follow()
    # reaches from a copy (its abstract origin, a declaration it
    # specifies) is a function too. clang has 9.5 million of them, so
    # they are kept as columns of numbers, not objects (3.4 GB as
    # objects), each name once. NONE: no such attribute.
    NONE = -1
    node, inlined, parent, entry_pc, low_pc = (array("q"), bytearray(), array("q"),
                                               array("q"), array("q"))
    call_line, decl_line, origin = array("q"), array("q"), array("q")
    name_of, name_id = array("q"), array("q")  # (entry, name) pairs, in entry order
    names, ids = [], {}
    cols = {"entry_pc": entry_pc, "low_pc": low_pc, "call_line": call_line,
            "decl_line": decl_line}
    parents = {}  # depth -> offset of the function or copy there
    i = -1        # the entry attributes are read for, or -1
    # read as it comes: hundreds of MB for libc
    dump = subprocess.Popen(["objdump", "--dwarf=info", path], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, env=ENV)
    for l in dump.stdout:
        # only an entry's own line: a name can have DW_TAG_ in it too
        # (gcc has a function get_DW_TAG_name)
        if "DW_TAG_" in l and ": Abbrev Number: " in l:
            # " <2><4d9>: Abbrev Number: 55 (DW_TAG_inlined_subroutine)"
            depth = int(l[l.index("<") + 1:l.index(">")])
            off = int(l[l.index("><") + 2:l.index(">:")], 16)
            if "DW_TAG_inlined_subroutine" in l or "DW_TAG_subprogram" in l:
                copy = "DW_TAG_inlined_subroutine" in l
                p = NONE
                if copy:
                    p = next((parents[k] for k in range(depth - 1, -1, -1) if k in parents), NONE)
                node.append(off)
                inlined.append(copy)
                parent.append(p)
                for c in (entry_pc, low_pc, call_line, decl_line, origin):
                    c.append(NONE)
                i = len(node) - 1
                parents[depth] = off
                for k in [k for k in parents if k > depth]:
                    del parents[k]
            else:
                parents.pop(depth, None)
                i = -1
        elif i < 0 or "DW_AT_" not in l:
            continue
        elif "DW_AT_name " in l or "DW_AT_linkage_name" in l:
            # "DW_AT_name : (indirect string, offset: 0x2b5): ZSTD_count";
            # addr2line gives the linkage name where there is one
            v = l.split(": ", 1)[1].strip()
            v = v.split("): ", 1)[1] if v.startswith("(") else v
            if v not in ids:
                ids[v] = len(names)
                names.append(v)
            name_of.append(i)
            name_id.append(ids[v])
        elif "DW_AT_abstract_origin" in l or "DW_AT_specification" in l:
            # "<0x750>"; not "<alt 0x...>" (a dwz file) or a signature
            if m := re.search(r"<0x([0-9a-f]+)>", l):
                origin[i] = int(m[1], 16)
        else:
            for at in ("entry_pc", "low_pc", "call_line", "decl_line"):
                if f"DW_AT_{at} " in l:
                    cols[at][i] = int(l.split()[-1], 0)
    if dump.wait():
        die(f"objdump --dwarf=info {path} failed")
    del ids
    if not node:
        return {}, set()

    def col(a):
        return np.frombuffer(a, dtype=np.int64) if len(a) else np.zeros(0, np.int64)

    node_, parent_, origin_ = col(node), col(parent), col(origin)
    decl_ = col(decl_line)
    name_of_, name_id_ = col(name_of), col(name_id)
    inlined_ = np.frombuffer(inlined, dtype=np.bool_)
    order = np.argsort(node_, kind="stable")
    sorted_nodes = node_[order]

    def index(offsets):
        """The entry at each offset, or -1 (none, or not a function)."""
        k = np.searchsorted(sorted_nodes, offsets)
        k[k >= len(sorted_nodes)] = 0
        hit = (offsets >= 0) & (sorted_nodes[k] == offsets)
        return np.where(hit, order[k], -1)

    # where each entry's names are: name_of is in entry order
    first = np.searchsorted(name_of_, np.arange(len(node_)), side="left")
    last = np.searchsorted(name_of_, np.arange(len(node_)), side="right")
    has_names = last > first
    has_decl = decl_ > 0  # as before: a line 0 is no line
    origin_at = index(origin_)

    def follow(start, has):
        """For each start entry (or -1), the first entry along it and
        its origins (at most 10) with the attribute, or -1."""
        cur, out = start.copy(), np.full(len(start), -1)
        for _ in range(10):
            live = (cur >= 0) & (out < 0)
            if not live.any():
                break
            found = live.copy()
            found[live] = has[cur[live]]
            out[found] = cur[found]
            move = live & ~found
            cur[move] = origin_at[cur[move]]
            cur[live & found] = -1
        return out

    copies = np.flatnonzero(inlined_)
    named = follow(copies, has_names)
    declared = follow(copies, has_decl)
    # Only copies that start where code ran, or that may be the function
    # itself (their line is the function's first), matter.
    epc, lpc = col(entry_pc)[copies], col(low_pc)[copies]
    at = np.where(epc != NONE, epc, lpc)
    ran = np.fromiter(ran, dtype=np.int64)
    started = (at != NONE) & np.isin(at, ran)
    cl_ = col(call_line)[copies]
    dl_ = np.where(declared >= 0, decl_[np.maximum(declared, 0)], NONE)
    same = cl_ == dl_
    keep = started | same
    copies, named, declared = copies[keep], named[keep], declared[keep]
    started, same = started[keep], same[keep]
    parent_named = follow(index(parent_[copies]), has_names)

    def names_at(e):
        return [names[k] for k in name_id_[first[e]:last[e]].tolist()] if e >= 0 else []

    starts, itself = {}, set()
    for c, e, pe, st, sm in zip(copies.tolist(), named.tolist(), parent_named.tolist(),
                                started.tolist(), same.tolist()):
        a = entry_pc[c] if entry_pc[c] != NONE else low_pc[c]
        cl = None if call_line[c] == NONE else call_line[c]
        pnames = None
        for name in names_at(e):
            if st:
                starts.setdefault(name, set()).add(a)
            if sm:
                if pnames is None:
                    pnames = names_at(pe)
                if name in pnames:
                    itself.add((name, cl))
    return starts, itself


def source_name(path):
    """A source file's path as the build gave it. addr2line joins the
    compile directory and the file's name; where -ffile-prefix-map made
    both relative (./dir/./name), the name alone is the path from the
    top of the source tree."""
    head, sep, tail = path.rpartition("/./")
    if sep and head.startswith("."):
        path = tail
    return os.path.normpath(path)


# -- ELF files --

_symbols = {}


def symbols(path):
    """Sorted (start, end, name) for the code in an ELF file. Names that
    several functions have get their start: fn_init[0x2bb9a0]."""
    if path not in _symbols:
        _symbols[path] = read_symbols(path)
    return _symbols[path]


def symbol_at(table, a):
    """The (start, end, name) covering an address, or None."""
    i = bisect.bisect_right(table, (a, float("inf"))) - 1
    return table[i] if i >= 0 and a < table[i][1] else None


def shared_names(table):
    """The names that several functions in a symbol table have."""
    return {m[1] for _, _, name in table if (m := re.fullmatch(r"(.*)\[0x[0-9a-f]+\]", name))}


def debug_file(path):
    """The separate debug information of an ELF file, or None: installed
    by the distribution (Debian, Ubuntu, Fedora), or fetched by a
    debuginfod client (Arch)."""
    bid = build_id(path)
    cache = os.environ.get("DEBUGINFOD_CACHE_PATH",
                           os.path.expanduser("~/.cache/debuginfod_client"))
    return next((d for d in (bid and [f"/usr/lib/debug/.build-id/{bid[:2]}/{bid[2:]}.debug",
                                      f"{cache}/{bid}/debuginfo"] or [])
                 if os.path.exists(d)), None)


def read_symbols(path):
    src = [path]
    if " .symtab " not in run("readelf", "-S", "-W", path):
        if found := debug_file(path):
            src = [found]
        else:
            print(f"warning: no symbol table for {path}; using exported names only",
                  file=sys.stderr)
            src = ["-D", path]
    best = {}  # start -> (preference, size, name)
    # -p: in the file's order, which decides between names that are
    # equally good, as in perf
    for l in run("nm", "-p", "-S", "--defined-only", *src).splitlines():
        f = l.split()
        if len(f) == 3:
            f.insert(1, "0")
        if len(f) != 4 or f[2] not in "TtWwi":
            continue
        start, size, kind, name = int(f[0], 16), int(f[1], 16), f[2], f[3]
        if src[0] == "-D":
            # nm adds the version to exported names (printf@@GLIBC_2.2.5);
            # perf shows the name alone
            name = name.split("@")[0]
        # Of several names for one address, pick the one perf shows:
        # sized, strong over weak, global over local, fewest leading
        # underscores, longest.
        pref = (size > 0, kind not in "Ww", kind.isupper() or kind == "i",
                len(name.lstrip("_")) - len(name), len(name))
        if start not in best or pref > best[start][0]:
            best[start] = (pref, size, name)
    # PLT stubs have no symbols; perf names them after objdump's labels.
    plt = [s for s in code_sections(path) if "plt" in s[0]]
    if plt:
        args = [a for s in plt for a in ("-j", s[0])]
        dis = run("objdump", "-d", *args, path)
        for a, name in re.findall(r"^([0-9a-f]+) <(.+)>:$", dis, re.M):
            best.setdefault(int(a, 16), (None, 0, name))
    starts = sorted(best)
    shared = Counter(best[s][2] for s in starts)
    return [(s, s + best[s][1] if best[s][1] else
             (starts[i + 1] if i + 1 < len(starts) else s + 1),
             best[s][2] if shared[best[s][2]] == 1 else f"{best[s][2]}[{s:#x}]")
            for i, s in enumerate(starts)]


_sections = {}


def code_sections(path):
    """(name, start, end) of each executable section."""
    if path not in _sections:
        out = []
        for l in run("objdump", "-h", "-w", path).splitlines():
            f = l.split()
            if len(f) > 6 and f[0].isdigit() and "CODE" in l:
                start = int(f[3], 16)
                out.append((f[1], start, start + int(f[2], 16)))
        _sections[path] = out
    return _sections[path]


# -- sums of many processes (collect) --

SUM_HEADER = "rank count sum 1"


def count_data(files):
    """count_addresses for a callgrind output and its valgrind log, or
    the same read from a sum file."""
    return read_sum(files[0])[0] if len(files) == 1 else count_addresses(*files)


class Sum:
    """Counts by key, summed over many processes: a key is an object
    (None for none) and one or two addresses. Kept as numpy arrays: a
    Counter of tuples took about 200 bytes an entry, and a compiler's
    sum has millions of entries, so collect grew by gigabytes over a
    build. Each process's counts wait as arrays and are folded into the
    sum once they are as many as it."""

    def __init__(self, width):
        self.width = width  # addresses in a key
        self.obs = {}       # object -> id
        self.keys = np.zeros((0, 1 + width), np.uint64)
        self.vals = np.zeros(0, np.int64)
        self.pending, self.waiting = [], 0

    def add(self, counter):
        if not counter:
            return
        obid = self.obs.setdefault
        k = np.array([(obid(key[0], len(self.obs)), *key[1:]) for key in counter],
                     dtype=np.uint64).reshape(-1, 1 + self.width)
        v = np.fromiter(counter.values(), dtype=np.int64, count=len(counter))
        self.pending.append((k, v))
        self.waiting += len(v)
        if self.waiting >= max(len(self.vals), 1 << 20):
            self.fold()

    def fold(self):
        if not self.pending:
            return
        k = np.concatenate([self.keys] + [p[0] for p in self.pending])
        v = np.concatenate([self.vals] + [p[1] for p in self.pending])
        self.pending, self.waiting = [], 0
        order = np.lexsort(k.T[::-1])  # by object, then address(es)
        k, v = k[order], v[order]
        new = np.ones(len(v), dtype=bool)
        new[1:] = (k[1:] != k[:-1]).any(axis=1)
        starts = np.flatnonzero(new)
        self.keys = k[starts]
        self.vals = np.add.reduceat(v, starts) if len(v) else v

    def objects(self):
        return set(self.obs)

    def items(self):
        """((object, address...), count), a slice at a time."""
        self.fold()
        name = {i: ob for ob, i in self.obs.items()}
        for s in range(0, len(self.vals), 1 << 16):
            for key, n in zip(self.keys[s:s + (1 << 16)].tolist(),
                              self.vals[s:s + (1 << 16)].tolist()):
                yield (name[key[0]], *key[1:]), n


def write_sum(path, program, processes, data):
    """Writes the sum (Sums from collect), gzipped text, through a
    temporary file."""
    counts, arcs, inside, total, skipped = data
    obs = sorted(counts.objects() | arcs.objects() | inside.objects(), key=lambda o: o or "")
    ids = {ob: str(i) if ob else "-" for i, ob in enumerate(obs)}
    with gzip.open(path + ".part", "wt") as f:
        f.write(f"{SUM_HEADER}\nprogram {program}\nprocesses {processes}\n"
                f"total {total}\nskipped {skipped}\n")
        for ob in obs:
            if ob:
                f.write(f"o {ids[ob]} {ob}\n")
        for (ob, a), n in counts.items():
            f.write(f"c {ids[ob]} {a:x} {n}\n")
        for (ob, a, t), n in arcs.items():
            f.write(f"j {ids[ob]} {a:x} {t:x} {n}\n")
        for (ob, a, t), n in inside.items():
            f.write(f"i {ids[ob]} {a:x} {t:x} {n}\n")
    os.replace(path + ".part", path)


def read_sum(path):
    """((counts, jumps, calls inside one object, total Ir, valgrind's
    own Ir), program, processes) from a sum file."""
    try:
        f = gzip.open(path, "rt")
        if f.readline().rstrip("\n") != SUM_HEADER:
            raise OSError
    except OSError:
        die(f"{path}: not a sum written by rank collect")
    obs, info = {"-": None}, {}
    counts, arcs, inside = Counter(), Counter(), Counter()
    with f:
        for l in f:
            k, _, rest = l.rstrip("\n").partition(" ")
            if k == "c":
                ob, a, n = rest.split()
                counts[(obs[ob], int(a, 16))] += int(n)
            elif k in "ji":
                ob, a, t, n = rest.split()
                (arcs if k == "j" else inside)[(obs[ob], int(a, 16), int(t, 16))] += int(n)
            elif k == "o":
                i, _, ob = rest.partition(" ")
                obs[i] = ob
            else:
                info[k] = rest
    return ((counts, arcs, inside, int(info["total"]), int(info["skipped"])),
            info["program"], int(info["processes"]))


def log_info(log):
    """(program, parent's pid, the lines on loaded files) from a valgrind
    -v log. valgrind writes the program with its full path, on the
    Command line, also for a child that a fork made without starting
    another program; such a child's log has no lines on loaded files: it
    has its parent's."""
    exe = ppid = None
    loads = []
    with open(log) as f:
        for l in f:
            if exe is None and (m := re.match(r"==\d+== Command: (.*)$", l)):
                # the first word; valgrind writes a space in a word as "\ "
                exe = re.match(r"((?:\\.|[^ \\])*)", m[1])[1]
                exe = re.sub(r"\\(.)", r"\1", exe)
            elif ppid is None and (m := re.match(r"==\d+== Parent PID: (\d+)", l)):
                ppid = m[1]
            elif "Reading syms from " in l or "svma " in l:
                loads.append(l)
    return exe, ppid, loads


def ended(out, log):
    """Whether the process wrote its counts: callgrind writes totals:
    last, valgrind its I refs line after that."""
    try:
        with open(out, "rb") as f:
            f.seek(max(0, os.path.getsize(out) - 200))
            if b"\ntotals: " not in f.read():
                return False
        with open(log, "rb") as f:
            f.seek(max(0, os.path.getsize(log) - 2000))
            return b"I   refs:" in f.read()
    except FileNotFoundError:
        return False


def collect(folder, program):
    """Sums the counts of the processes that ran program, from callgrind
    outputs and valgrind logs named callgrind.<pid>.out and
    valgrind.<pid>.log in folder, as the processes end; removes each
    pair once read. Stops after the file "finished" appears in folder.
    Returns (data, processes)."""
    prog = os.path.realpath(program)
    base = os.path.basename(prog)
    counts, arcs, inside = Sum(1), Sum(2), Sum(2)
    total = skipped = summed = spawns = 0
    others, notes = Counter(), {}
    # pid -> (parent's pid, lines on loaded files), also of processes
    # whose files are gone, for the children a fork made
    known = {}

    def loads_of(pid, seen=()):
        """The lines on loaded files that apply to a process: its own, or
        its parent's (a fork without another program)."""
        if pid not in known:
            log = os.path.join(folder, f"valgrind.{pid}.log")
            if not os.path.exists(log):
                return None
            _, ppid, loads = log_info(log)
            known[pid] = (ppid, loads)
        ppid, loads = known[pid]
        if loads:
            return loads
        if ppid and ppid not in seen:
            return loads_of(ppid, seen + (pid,))
        return None

    while True:
        # looked at before the files, so that a last look follows it
        last = os.path.exists(os.path.join(folder, "finished"))
        for name in sorted(os.listdir(folder)):
            if not (m := re.fullmatch(r"valgrind\.(\d+)\.log", name)):
                continue
            pid = m[1]
            log = os.path.join(folder, name)
            out = os.path.join(folder, f"callgrind.{pid}.out")
            exe, ppid, own = log_info(log)
            known[pid] = (ppid, own)
            if not ended(out, log):
                if not last:
                    continue
                # A process that became a program valgrind does not
                # follow (exec) leaves a log and no counts. So does the
                # program's own fork child that does so at once: clang
                # starts the linker by posix_spawn, a copy of itself
                # (vfork, which valgrind makes a fork) that runs ld. Such
                # a child has no loaded files of its own in its log; the
                # few instructions it ran first are not counted.
                spawned = exe and os.path.realpath(exe) == prog and not own and bool(ppid)
                if os.path.exists(out) or (exe and os.path.realpath(exe) == prog and not spawned):
                    die(f"process {pid} ({exe}) did not end normally: no complete counts "
                        f"in {out}")
                if spawned:
                    spawns += 1
                os.remove(log)
                continue
            if not exe:
                die(f"{log}: no program named; run valgrind with -v -v -v")
            if os.path.realpath(exe) == prog:
                read = log
                if not own:
                    # a fork's child: its parent's loaded files, then its log
                    loads = loads_of(pid)
                    if not loads:
                        die(f"process {pid} ({exe}): no lines on loaded files in its log "
                            f"or its parent's ({ppid}); run valgrind with -v -v -v")
                    read = log + ".loads"
                    with open(read, "w") as f, open(log) as g:
                        f.writelines(loads)
                        f.write(g.read())
                err = io.StringIO()
                try:
                    with contextlib.redirect_stderr(err):
                        c, a, i, t, sk = count_addresses(out, read)
                except SystemExit as e:
                    die(f"process {pid}: {str(e.code).removeprefix('rank: error: ')}")
                finally:
                    if read != log:
                        os.remove(read)
                if a is None:
                    die(f"{out}: no jumps recorded; run callgrind with --collect-jumps=yes")
                counts.add(c)
                arcs.add(a)
                inside.add(i)
                del c, a, i
                total, skipped, summed = total + t, skipped + sk, summed + 1
                # each kind of message once, with how many processes had it
                for l in err.getvalue().splitlines():
                    kind = re.sub(r"[0-9][0-9,.]*", "N", l)
                    notes.setdefault(kind, [l, 0])[1] += 1
            elif os.path.basename(exe) == base:
                die(f"process {pid} ran {exe}, not {prog}, so its counts would be mixed "
                    f"with the program's. Make the command start {prog} itself (for git: "
                    f"--exec-path; for gcc: -B).")
            else:
                others[os.path.basename(exe)] += 1
            os.remove(out)
            os.remove(log)
        if last:
            break
        time.sleep(2)
    if not summed:
        die(f"no process ran {prog}")
    for l, n in notes.values():
        print(l if n == 1 else f"{l} (the first of {n} processes like it)", file=sys.stderr)
    if spawns:
        print(f"processes of {base} that became another program right after a fork "
              f"(posix_spawn), not counted: {spawns}", file=sys.stderr)
    n = sum(others.values())
    print(f"processes: {summed} of {base}, summed; {n} other{'' if n == 1 else 's'} left out"
          + "".join(f", {n} {name}" for name, n in sorted(others.items())), file=sys.stderr)
    return (counts, arcs, inside, total, skipped), summed


# -- one function (-a) --

def time_objects(data, comm, binary):
    """([(recorded path, file to read, Counter(address))], [paths whose
    file changed since the run]), checked by build-id."""
    offs = time_addresses(data, comm)
    ids = recorded_ids(data)
    if binary:
        bid = build_id(binary)
        path = next((p for p in offs if ids.get(p) == bid), None)
        if not path:
            die(f"{binary} is not a file with samples in {data} (build-id {bid})")
        return [(path, binary, file_to_address(binary, offs[path]))], []
    objs, stale = [], []
    for path, o in offs.items():
        if is_elf(path) and build_id(path) == ids.get(path):
            objs.append((path, path, file_to_address(path, o)))
        else:
            stale.append(path)
    return objs, stale


def count_objects(files, binary):
    """[(recorded path, file to read, Counter(address))]."""
    counts, _, _, _, _ = count_data(files)
    addrs = {}
    for (ob, a), n in counts.items():
        if ob:
            addrs.setdefault(ob, Counter())[a] += n
    if binary:
        if len(files) == 1:
            cmd = read_sum(files[0])[1]
        else:
            with open(files[0]) as f:
                cmd = next((l.split()[1] for l in f if l.startswith("cmd:")), None)
        if cmd not in addrs:
            die(f"{files[0]}: no counts for the program ({cmd})")
        return [(cmd, binary, addrs[cmd])], []
    return [(ob, ob, a) for ob, a in addrs.items() if os.path.exists(ob)], []


def show_function(func, objs, stale, unit, fix):
    """fix: the command to rerun with a copy of the program."""
    found = [(path, file, a, s, e) for path, file, a in objs
             for s, e, name in symbols(file) if name == func]
    if not found and (alike := [name for _, file, _ in objs for _, _, name in symbols(file)
                                 if name.startswith(func + "[0x")]):
        die(f"several functions named {func}; name one: " + ", ".join(alike))
    if not found:
        msg = (f"no function {func} in the files with {unit} ("
               + ", ".join(os.path.basename(p) for p, _, _ in objs) + ")")
        if stale:
            msg += ("; changed since the run (build-id differs): "
                    + ", ".join(stale) + "; if it is in the program, use its stored copy"
                    + " (binaries/<hash>, named in the run's meta.txt):\n" + fix)
        die(msg)
    if len(found) > 1:
        die(f"several functions named {func}: "
            + ", ".join(f"{os.path.basename(p)} at {s:#x}" for p, _, _, s, _ in found))
    path, file, addrs, start, end = found[0]
    dis = run("objdump", "-d", "--no-show-raw-insn", f"--start-address={start:#x}",
              f"--stop-address={end:#x}", file)
    insns = [(int(a, 16), text) for a, text in re.findall(r"^\s+([0-9a-f]+):\s+(.*)$", dis, re.M)]
    stray = {a for a in addrs if start <= a < end} - {a for a, _ in insns}
    if stray:
        die(f"{len(stray)} of the addresses with {unit} in {func} are not instruction "
            f"starts in {file}: not the build that ran; use the program's stored copy "
            f"(binaries/<hash>, named in the run's meta.txt):\n{fix}")
    print(f"{func} ({os.path.basename(path)}): {sum(addrs[a] for a, _ in insns):,} {unit}")
    for a, text in insns:
        count = f"{addrs[a]:,}" if a in addrs else "."
        print(f"{count:>14}  {func}+{a - start:<#6x} {text}")


def usage(status=1):
    """Prints the docstring's Usage block and exits; with 0 (for -h) to
    stdout, otherwise to stderr."""
    lines = __doc__.split("\n")
    block = []
    for line in lines[lines.index("Usage:") + 1:]:
        if line and not line.startswith("  "):
            break
        block.append(line)
    text = "usage:\n" + "\n".join(block).rstrip() + "\n"
    (sys.stdout if status == 0 else sys.stderr).write(text)
    sys.exit(status)


def main(argv):
    if any(a in ("-h", "--help") for a in argv[:2]):
        usage(0)
    if argv[:1] == ["collect"]:
        if len(argv) != 4:
            usage()
        folder, program, path = argv[1:]
        data, processes = collect(folder, program)
        write_sum(path, os.path.realpath(program), processes, data)
        return
    if not argv or argv[0] not in ("time", "count"):
        usage()
    try:
        opts, args = getopt.getopt(argv[1:], "a:b:")
    except getopt.GetoptError:
        usage()
    opts = dict(opts)
    mode, func, binary = argv[0], opts.get("-a"), opts.get("-b")
    # count takes a callgrind output and its log, or a sum
    files = 1 if mode == "count" and len(args) == (1 if func else 2) else 2
    if func:
        if len(args) != files:
            usage()
        q = shlex.quote
        fix = f"{q(sys.argv[0])} {mode} -a {q(func)} -b <binary> " + " ".join(map(q, args))
        if mode == "time":
            show_function(func, *time_objects(*args, binary), "samples", fix)
        else:
            show_function(func, *count_objects(args, binary), "Ir", fix)
        return
    if len(args) != 1 + files or args[0] not in LEVELS or binary:
        usage()
    level, a, b = args[0], args[1], args[2:]
    if mode == "time":
        loc = rank_time(a, b[0]) if level == "instructions" else rank_time_source(a, b[0], level)
    else:
        data = count_data([a] + b)
        loc = rank_count(data) if level == "instructions" else rank_count_source(data, level)
    if not loc:
        die(f"nothing to rank in {a}")
    out = csv.writer(sys.stdout, lineterminator="\n")
    if level == "instructions":
        out.writerow(["rank", "count", "function", "offset", "file"])
        order = sorted(loc.items(), key=lambda x: (-x[1], x[0][0], x[0][2], x[0][1]))
        for i, ((func, off, file), n) in enumerate(order, 1):
            out.writerow([i, n, func, f"{off:#x}", file])
    elif level == "lines":
        out.writerow(["rank", "count", "source", "line", "function", "file"])
        for i, (row, n) in enumerate(sorted(loc.items(), key=lambda x: (-x[1], x[0])), 1):
            out.writerow([i, n, *row])
    else:
        out.writerow(["rank", "count", "function", "source", "file"])
        for i, (row, n) in enumerate(sorted(loc.items(), key=lambda x: (-x[1], x[0])), 1):
            out.writerow([i, n, *row])


# die quietly, like a shell script, when stdout closes early or on Ctrl-C
signal.signal(signal.SIGPIPE, signal.SIG_DFL)
signal.signal(signal.SIGINT, signal.SIG_DFL)
try:
    main(sys.argv[1:])
except OSError as e:
    die(f"{e.filename}: {e.strerror}")
