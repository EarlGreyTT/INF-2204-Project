#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# share -- upload your measurements to the group's server, or download
# everyone's
#
# Usage:
#   share upload                    send your measurements
#   share list                      what the server has, and sizes
#   share download entire [-n <nick>]... [<workload>...]
#                                   get all, or only these
#   share download results [-n <nick>]... [<workload>...]
#                                   the same, without raw files
#   share download results -n t14 xz-6-lua
#                                   for example: t14's runs of xz-6-lua
#
# <nick> is a machine's nickname, the one given to measure -n: t14 means
# all of t14's platforms (t14-1, t14-2, ...), t14-3 only that one. Give
# -n again for more machines. With both -n and workloads you get those
# workloads' runs on those machines; without -n, every machine's.
# With entire, -n also gets all binaries/ of those workloads: they are
# not named by machine.
#
# Downloads go to measurements-all/; a file there that differs from the
# server's is replaced. Raw files (perf.data, callgrind.out,
# valgrind.log, counts.sum.gz, binaries/) are needed only to rank a run
# again; without them a download is far smaller.
#
# An upload sends only the files record makes, by their exact names,
# and warns about the other files it finds in platforms/, binaries/,
# time/ and count/. The rest of measurements/ (failed/, old runs,
# notes) stays at home. Linked folders are followed, linked files are
# skipped. It sends the small files first, then each workload's raw
# files, so an upload that stops keeps the parts sent before.
#
# The server keeps a part only if none of its files collides with what
# is already there: a file of the same name with other contents, or a
# nickname (the pi in pi-1.run3) that someone else uploaded first.
# Otherwise it keeps nothing of that part and says which files collide.
# The server never deletes or overwrites anything.
#
# Setup: send the server's owner your public ssh key; you get back its
# ssh destination. Then, in this repo:
#
#   git config share.remote <destination>
#   git config share.key <key file>
#
# share.key is not needed if ~/.ssh/config gives the key.
#
# Needs rsync 3.1 or newer.

set -eu
# letters in the name checks are ASCII only; sizes read 1.0 GB, not
# 1,0 GB; sorting is the same everywhere
export LC_ALL=C

NAME=share
SCRIPTS=$(dirname "$(readlink -f "$0")")
REPO=$(dirname "$SCRIPTS")
# the raw files' names (binaries/ is raw too)
RAW='perf.data callgrind.out valgrind.log counts.sum.gz'
TMP=

die() {
	echo "$NAME: error: $1" >&2
	exit 1
}

# die_cmd message command: the error, then the command that fixes it
die_cmd() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	exit 1
}

# usage [0]: prints the header's Usage block and exits; with 0 (for -h)
# to stdout, otherwise to stderr as an error
usage() {
	if [ "${1:-1}" = 0 ]; then
		usage_block
		exit 0
	fi
	usage_block >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

cleanup() {
	[ -z "$TMP" ] || rm -rf "$TMP"
}

# stopped: Ctrl-C or a kill; an upload says what the server kept
stopped() {
	trap - EXIT
	cleanup
	echo "" >&2
	if [ -n "${sending:-}" ]; then
		echo "$NAME: stopped; the server keeps nothing of $sending${kept:+, but keeps $kept}" >&2
	else
		echo "$NAME: stopped" >&2
	fi
	exit 130
}

rsync_install() {
	if [ "$(uname -s)" = Darwin ]; then
		echo "brew install rsync"
	else
		echo "sudo apt install rsync"
	fi
}

# read_conf: sets HOST and KEY from git config (share.remote, share.key)
read_conf() {
	HOST=$(git -C "$REPO" config --get share.remote) ||
		die_cmd "no remote set; the server's owner gives you its ssh destination" "git config share.remote <destination>"
	case $HOST in
	# a leading - would make it an ssh option
	-* | *[!A-Za-z0-9_.@-]*) die "share.remote is not an ssh destination: $HOST" ;;
	esac
	KEY=$(git -C "$REPO" config --get --type=path share.key) || KEY=
	[ -z "$KEY" ] || {
		# absolute, as an upload runs from measurements/
		case $KEY in /*) ;; *) KEY=$REPO/$KEY ;; esac
		# rsync splits RSYNC_RSH at spaces; the key goes in '...'
		case $KEY in *\'*) die "share.key: a file name with ' does not work: $KEY" ;; esac
		[ -f "$KEY" ] || die "share.key: no key file $KEY"
	}
}

# rsync_failed status message: stops after a failed list or download
rsync_failed() {
	[ "$1" != 255 ] || die "could not reach the server: ssh failed (see above)"
	die "$2 (rsync exit status $1)"
}

# rsync_results rsync-args...: rsync without the raw files. They come
# first: rsync takes the first rule that matches a file. Runs that
# failed hold them without the run's name in front, and a count's
# per-process files in callgrind/.
rsync_results() {
	for r in $RAW; do
		set -- --exclude="$r" --exclude="*.$r" "$@"
	done
	rsync --exclude='/*/binaries/' --exclude='/*/*/failed/*/callgrind/' "$@"
}

# die_list message: stops, and points to share list
die_list() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "see what it has with:" >&2
	echo "" >&2
	echo "$0 list" >&2
	echo "" >&2
	exit 1
}

# tagged tag: the words of the lines in $check that start with tag
tagged() {
	printf '%s\n' "$check" | awk -v t="$1" '$1 == t { s = s (s == "" ? "" : " ") $2 } END { print s }'
}

# machine_pattern machine: the rsync pattern for the start of its file
# names: t14-3 gives t14-3. (not t14-3*, which is also t14-30); t14 gives
# t14-[0-9]*. , which no other machine's names start with, as nicknames
# have no hyphen
machine_pattern() {
	case $1 in
	*-*) echo "$1." ;;
	*) echo "$1-[0-9]*." ;;
	esac
}

# cannot_read path: stops; an upload would miss what it cannot read
cannot_read() {
	if [ -O "$1" ]; then
		fix="chmod -R u+rwX $M"
	else
		fix="sudo chown -R $(id -un) $M"
	fi
	path=$M/$1
	[ "$1" != . ] || path=$M
	die_cmd "cannot read $path, so it cannot be uploaded" "$fix"
}

# find_files: a line per entry in platforms/, binaries/, time/ and
# count/: its type (f file, u unreadable file, d folder, l link,
# x anything else, o odd characters in its name) and its path. The
# globs skip hidden files: record's half-written ones and editors'.
find_files() {
	for f in platforms/* */binaries/* */time/* */count/*; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		case $f in
		*[!A-Za-z0-9_./-]*)
			# shown with ? for those characters, a line break among them
			echo "o $(printf '%s' "$f" | tr -c 'A-Za-z0-9_./-' '?')"
			continue
			;;
		esac
		if [ -d "$f" ]; then
			t=d
		elif [ -L "$f" ]; then
			t=l
		elif [ ! -f "$f" ]; then
			t=x
		elif [ -r "$f" ]; then
			t=f
		else
			t=u
		fi
		echo "$t $f"
	done
}

# sort_files: reads find_files's lines and writes, in $TMP, the files
# the server takes (the same rules as its merge) into small and
# raw/<workload>, unreadable ones into unread, and the rest, with why,
# into odd. failed/ folders are left out without a word.
sort_files() {
	awk -v tmp="$TMP" '
		BEGIN {
			nick = "[A-Za-z0-9_]+"
			run = "^" nick "-[0-9]+\\.run[0-9]+\\."
			split("samples.csv line-samples.csv function-samples.csv meta.txt", a, " ")
			for (i in a) kind["time", a[i]] = "small"
			kind["time", "perf.data"] = "raw"
			split("counts.csv line-counts.csv function-counts.csv meta.txt", a, " ")
			for (i in a) kind["count", a[i]] = "small"
			split("callgrind.out valgrind.log counts.sum.gz", a, " ")
			for (i in a) kind["count", a[i]] = "raw"
		}
		{
			t = substr($0, 1, 1)
			p = substr($0, 3)
			n = split(p, part, "/")
			w = part[1]
			k = ""
			why = "not a name record makes"
			if (t == "o")
				why = "odd characters in its name"
			else if (t == "d") {
				if (n == 3 && part[3] == "failed" && (part[2] == "time" || part[2] == "count"))
					next
				why = "a folder"
			} else if (t == "l")
				why = "a link"
			else if (t == "x")
				why = "not a plain file"
			else if (w == "platforms") {
				if (n == 2 && part[2] ~ ("^" nick "-[0-9]+\\.txt$"))
					k = "small"
			} else if (w !~ /^[A-Za-z0-9][A-Za-z0-9_.-]*$/)
				why = "not a workload name record takes"
			else if (part[2] == "binaries") {
				if (length(part[3]) == 12 && part[3] ~ /^[0-9a-f]+$/)
					k = "raw"
			} else if (match(part[3], run))
				k = kind[part[2], substr(part[3], RLENGTH + 1)]
			if (k == "") {
				print "  " p " (" why ")" > (tmp "/odd")
				next
			}
			if (t == "u")
				print p > (tmp "/unread")
			else if (k == "small")
				print p > (tmp "/small")
			else
				print p > (tmp "/raw/" w)
		}'
}

# send what list: uploads the files in list as one part, which the
# server keeps whole or not at all
send() {
	sending=$1
	echo "$NAME: sending $1 ($(wc -l <"$2" | tr -d ' ') files)"
	status=0
	# word splitting intended: progress is options or nothing. -k: a
	# linked folder arrives as a folder
	rsync -a -k $progress --files-from="$2" . "$HOST:" 2>"$TMP/err" || status=$?
	if [ "$status" = 0 ]; then
		# the server's line on what it kept is summed up at the end
		grep -v '^[^:]*: upload kept; ' "$TMP/err" >&2 || true
		k=$(sed -n 's/^[^:]*: upload kept; \([0-9]*\) new.*/\1/p' "$TMP/err")
		new=$((new + ${k:-0}))
		kept="${kept:+$kept, }$1"
		sending=
		return
	fi
	cat "$TMP/err" >&2
	[ -z "$kept" ] || echo "$NAME: the server keeps what was sent before: $kept" >&2
	case $status in
	23) die_cmd "the server kept nothing of $1: move the files it named above out of measurements/, then upload again" "$0 upload" ;;
	255) die "could not reach the server: ssh failed (see above)" ;;
	*) die_cmd "sending $1 stopped (rsync exit status $status)" "$0 upload" ;;
	esac
}

[ $# -ge 1 ] || usage
case "$1" in
-h | --help) usage 0 ;;
upload | list) [ $# = 1 ] || usage ;;
download)
	case "${2:-}" in
	entire | results) ;;
	*) usage ;;
	esac
	;;
*) usage ;;
esac

# under sudo, ssh would look for root's keys
[ "$(id -u)" != 0 ] || die_cmd "run it without sudo: it uses your own ssh key" "$0 $*"
command -v rsync >/dev/null || die_cmd "rsync is not installed" "$(rsync_install)"
# --info=progress2 needs 3.1; macOS's own rsync is 2.6.9, or openrsync,
# which says "rsync version 2.6.9 compatible" on its second line. Some
# builds say "version v3.2.7".
rsync --version 2>/dev/null | awk '/^rsync +version +v?[0-9]/ {
		sub(/^v/, "", $3)
		split($3, v, ".")
		ok = v[1] > 3 || (v[1] == 3 && v[2] >= 1)
		exit
	}
	END { exit !ok }' ||
	die_cmd "this rsync is too old: share needs rsync 3.1 or newer" "$(rsync_install)"
# rsync's progress line, if someone watches; checked here, as inside
# $(...) the output is never a terminal. -h: sizes as 63M, not
# 63,251,306
progress=
[ ! -t 1 ] || progress='--info=progress2 -h'
read_conf
# ssh -G prints the settings it would use; without a Host entry the
# host name is just the alias, lowercased
hostname=$(ssh -G "$HOST" 2>/dev/null | awk '$1 == "hostname" { print $2 }')
[ -n "$hostname" ] || die "ssh does not work here: ssh -G $HOST printed no host name"
case $HOST in
*@*) ;;
*)
	[ "$hostname" != "$(printf '%s' "$HOST" | tr A-Z a-z)" ] ||
		die "share.remote: no ssh host named $HOST in ~/.ssh/config; give <user>@<host> instead"
	;;
esac
# a server or network that does not answer would hang share with no
# word: ssh gives up after 20 s at the start, or 60 s without answer.
# IdentitiesOnly: else ssh may log in with another of your keys.
RSYNC_RSH="ssh -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
[ -z "$KEY" ] || RSYNC_RSH="$RSYNC_RSH -o IdentitiesOnly=yes -i '$KEY'"
export RSYNC_RSH
trap cleanup EXIT
trap stopped INT TERM HUP
TMP=$(mktemp -d)

case "$1" in
upload)
	M=$REPO/measurements
	[ -d "$M" ] || die "nothing to upload: no $M"
	cd "$M"
	# a folder that cannot be read would drop out without a word
	for d in . * platforms */binaries */time */count; do
		if [ -d "$d" ] && ! { [ -r "$d" ] && [ -x "$d" ]; }; then
			cannot_read "$d"
		fi
	done
	mkdir "$TMP/raw"
	find_files | sort_files
	[ ! -s "$TMP/unread" ] || cannot_read "$(head -n 1 "$TMP/unread")"
	if [ -s "$TMP/odd" ]; then
		n=$(wc -l <"$TMP/odd" | tr -d ' ')
		echo "$NAME: warning: skipped $n file(s) the server would refuse:" >&2
		head -n 10 "$TMP/odd" >&2
		[ "$n" -le 10 ] || echo "  and $((n - 10)) more" >&2
	fi
	[ -s "$TMP/small" ] || [ -n "$(ls "$TMP/raw")" ] ||
		die "nothing to upload: no files record makes in $M"
	kept=
	new=0
	[ ! -s "$TMP/small" ] || send "the small files" "$TMP/small"
	for f in "$TMP"/raw/*; do
		[ -e "$f" ] || continue
		send "the raw files of ${f##*/}" "$f"
	done
	echo "$NAME: the server kept it all; $new new file(s) of yours merged"
	;;
list)
	# a line per file: permissions, size, date, time, path (--no-h:
	# sizes without digit separators)
	files=$(rsync --list-only -r --no-h "$HOST:") || rsync_failed $? "could not list the server's files"
	printf '%s\n' "$files" | awk -v raw="$RAW" '
		function size(b) {
			if (b < 1e3)
				return sprintf("%d B", b)
			if (b < 1e6)
				return sprintf("%.0f kB", b / 1e3)
			return b < 1e9 ? sprintf("%.0f MB", b / 1e6) : sprintf("%.1f GB", b / 1e9)
		}
		# sorted: the words of a list, sorted
		function sorted(list,    word, n, i, j, t, out) {
			n = split(list, word, " ")
			for (i = 2; i <= n; i++)
				for (j = i; j > 1 && word[j - 1] > word[j]; j--) {
					t = word[j]; word[j] = word[j - 1]; word[j - 1] = t
				}
			for (i = 1; i <= n; i++)
				out = out (i > 1 ? " " : "") word[i]
			return out
		}
		# platform_of: the platform of a run (t14-3 of t14-3.run1.x,
		# or of the folder t14-3.run1 of a failed run), or ""
		function platform_of(f) {
			return f ~ /^[A-Za-z0-9_]+-[0-9]+\.run[0-9]/ ? substr(f, 1, index(f, ".run") - 1) : ""
		}
		# machine: adds a file of platform pl to its nickname nk, for
		# what -n would get
		function machine(pl, b, small) {
			nk = substr(pl, 1, index(pl, "-") - 1)
			nick_all[nk] += b
			nick_small[nk] += small ? b : 0
			if (!((nk, pl) in seen_pl)) {
				seen_pl[nk, pl] = 1
				plats[nk] = plats[nk] " " pl
			}
		}
		BEGIN { nraw = split(raw, rawname, " ") }
		/^-/ {
			n = split($5, part, "/")
			w = part[1]
			if (w == "platforms") {
				if (n == 2 && part[2] ~ /^[A-Za-z0-9_]+-[0-9]+\.txt$/)
					machine(substr(part[2], 1, length(part[2]) - 4), $2, 1)
				next
			}
			all[w] += $2
			total += $2
			# the same files as rsync_results leaves out
			israw = part[2] == "binaries" || (part[3] == "failed" && part[5] == "callgrind")
			for (i = 1; i <= nraw && !israw; i++) {
				e = "." rawname[i]
				israw = part[n] == rawname[i] ||
					(length(part[n]) > length(e) && substr(part[n], length(part[n]) - length(e) + 1) == e)
			}
			if (!israw) {
				small[w] += $2
				total_small += $2
			}
			if (part[2] == "binaries")
				bin[w] += $2
			pl = ""
			if (n == 3)
				pl = platform_of(part[3])
			else if (n >= 5 && part[3] == "failed")
				pl = platform_of(part[4])
			if (pl != "") {
				machine(pl, $2, !israw)
				ran[w, nk] = 1
			}
			# a run file: <nick>-<n>.run<k>.<what>
			if (n == 3 && match(part[3], /-[0-9]+\.run[0-9]+\./)) {
				nick = substr(part[3], 1, RSTART - 1)
				if (!((w, nick) in seen)) {
					seen[w, nick] = 1
					machines[w] = machines[w] " " nick
				}
			}
		}
		END {
			printf "%-30s %9s %9s  %s\n", "workload", "entire", "results", "machines"
			for (w in all)
				printf "%-30s %9s %9s  %s\n", w, size(all[w]), size(small[w]), sorted(machines[w]) | "sort"
			close("sort")
			printf "%-30s %9s %9s\n", "total", size(total), size(total_small)
			# entire -n also gets the binaries of the workloads
			# it ran
			print ""
			printf "%-30s %9s %9s  %s\n", "machine (-n)", "entire", "results", "platforms"
			for (nk in nick_all) {
				e = nick_all[nk]
				for (w in bin)
					if ((w, nk) in ran)
						e += bin[w]
				printf "%-30s %9s %9s  %s\n", nk, size(e), size(nick_small[nk]), sorted(plats[nk]) | "sort"
			}
			close("sort")
		}'
	;;
download)
	mode=$2
	fetch=rsync_results
	[ "$mode" != entire ] || fetch=rsync
	shift 2
	# a name becomes an rsync pattern: no / * ? [ in it, and no - or .
	# first (the server's own rule)
	names=
	machines=
	# the words after the mode, for a corrected command
	given=
	while [ $# -gt 0 ]; do
		if [ "$1" = -n ]; then
			# an empty -n must never mean every machine: that is
			# all of it
			[ -n "${2:-}" ] || die "-n needs a machine after it, such as t14 or t14-3"
			case $2 in
			*[!A-Za-z0-9_-]* | -* | *- | *-*-* | *-*[!0-9]*) die "not a machine name: $2" ;;
			esac
			machines="${machines:+$machines }$2"
			given="$given -n $2"
			shift 2
			continue
		fi
		w=${1%/}
		case $w in
		"" | [!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) die "not a workload name: $w" ;;
		# a folder on the server, but every download takes what it needs
		platforms) die "platforms is not a workload" ;;
		esac
		names="${names:+$names }$w"
		given="$given $w"
		shift
	done
	set --
	if [ -n "$names$machines" ]; then
		# the workloads and platforms; with -n also the runs, to see
		# whose they are
		if [ -n "$machines" ]; then
			files=$(rsync --list-only -r --no-h "$HOST:")
		else
			files=$(rsync --list-only -r --no-h --include='/platforms/*' --exclude='/*/*' "$HOST:")
		fi || rsync_failed $? "could not list the server's files"
		check=$(printf '%s\n' "$files" | awk -v names="$names" -v machines="$machines" '
			function platform_of(f) {
				return f ~ /^[A-Za-z0-9_]+-[0-9]+\.run[0-9]/ ? substr(f, 1, index(f, ".run") - 1) : ""
			}
			# is: whether platform p is machine m (t14-3, or t14)
			function is(p, m) {
				return p == m || (m !~ /-/ && index(p, m "-") == 1)
			}
			{
				n = split($5, part, "/")
				pl = ""
				if (n == 1 && /^d/ && $5 != "." && $5 != "platforms")
					workload[$5] = 1
				else if (n == 2 && part[1] == "platforms" && part[2] ~ /^[A-Za-z0-9_]+-[0-9]+\.txt$/)
					platform[substr(part[2], 1, length(part[2]) - 4)] = 1
				else if (n == 3 && (part[2] == "time" || part[2] == "count"))
					pl = platform_of(part[3])
				else if (n >= 4 && part[3] == "failed")
					pl = platform_of(part[4])
				if (pl != "") {
					platform[pl] = 1
					ran[part[1], pl] = 1
				}
			}
			END {
				nn = split(names, name, " ")
				nm = split(machines, mach, " ")
				for (p in platform)
					print "has", p | "sort"
				close("sort")
				for (i = 1; i <= nm; i++) {
					found = 0
					for (p in platform)
						found = found || is(p, mach[i])
					if (!found)
						print "unknown", mach[i]
				}
				for (i = 1; i <= nn; i++) {
					if (name[i] in workload)
						continue
					found = 0
					for (p in platform)
						found = found || is(p, name[i])
					what = found ? "machine" : "missing"
					print what, name[i]
				}
				if (nm == 0)
					exit
				asked = nn
				if (!asked)
					for (w in workload)
						name[++nn] = w
				for (i = 1; i <= nn; i++) {
					any = 0
					for (p in platform)
						for (j = 1; j <= nm; j++)
							any = any || (((name[i], p) in ran) && is(p, mach[j]))
					if (any)
						print "fetch", name[i]
					else if (asked)
						print "noruns", name[i]
				}
			}')
		bad=$(tagged unknown)
		[ -z "$bad" ] || die "the server has no machine $bad; it has $(tagged has)"
		bad=$(tagged machine)
		if [ -n "$bad" ]; then
			fixed=
			prev=
			for a in $given; do
				if [ "$prev" != -n ]; then
					for m in $bad; do
						[ "$a" != "$m" ] || a="-n $a"
					done
				fi
				fixed="$fixed $a"
				prev=$a
			done
			die_cmd "not a workload but a machine: $bad" "$0 download $mode$fixed"
		fi
		bad=$(tagged missing)
		[ -z "$bad" ] || die_list "the server has no $bad, so nothing was downloaded"
		bad=$(tagged noruns)
		[ -z "$bad" ] || die_list "the server has no runs from $machines in $bad, so nothing was downloaded"
		[ -z "$machines" ] || [ -n "$(tagged fetch)" ] ||
			die_list "the server has no runs from $machines, so nothing was downloaded"
		if [ -z "$machines" ]; then
			set -- --include='/platforms/***'
			for w in $names; do
				set -- "$@" --include="/$w/***"
			done
			set -- "$@" --exclude='/*'
		else
			# w/*/ is time/, count/ and binaries/; a run's files, and its
			# folder in failed/, start with the machine's pattern
			set -- --include='/platforms/'
			for m in $machines; do
				set -- "$@" --include="/platforms/$(machine_pattern "$m")txt"
			done
			for w in $(tagged fetch); do
				set -- "$@" --include="/$w/" --include="/$w/*/" --include="/$w/*/failed/"
				for m in $machines; do
					p=$(machine_pattern "$m")
					set -- "$@" --include="/$w/*/$p*" --include="/$w/*/failed/$p*/***"
				done
				[ "$fetch" = rsync_results ] || set -- "$@" --include="/$w/binaries/***"
			done
			set -- "$@" --exclude='*'
		fi
	fi
	status=0
	# word splitting intended: progress is options or nothing
	"$fetch" -a $progress --prune-empty-dirs "$@" "$HOST:" "$REPO/measurements-all/" || status=$?
	[ "$status" = 0 ] || rsync_failed "$status" "the download stopped"
	what="everyone's measurements"
	[ -z "$names$machines" ] || what="the measurements${names:+ of $names}${machines:+ from $machines}"
	[ "$fetch" = rsync ] || what="$what, without the raw files,"
	echo "$NAME: $what are in $REPO/measurements-all"
	;;
esac
