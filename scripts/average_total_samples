#!/usr/bin/env python3
# Responsible: Tuva Marie Eaton Johansen
# This script was generated by Claude Sonnet 5.5

"""Per-file statistics over every CSV in measurements/*/time/.

Run AFTER merge_samples so the *.avg.csv files exist too. Every .csv in each
time directory (run files and averaged files) gets one row in OUTPUT:

    workload, filename, average, variance, standard deviation, n_values,
    log_mean, log_sd, geometric_mean, frac_ones, average_no_ones

n_values is the number of data rows in the file. average_no_ones is the mean of
the rows whose value is not exactly 1 (blank if every row is 1).

log_mean / log_sd are the mean and (population) sd of ln(x); geometric_mean is
exp(log_mean). Values <= 0 are excluded from the log statistics.
frac_ones is the fraction of rows whose value is exactly 1 (the floor of the
distribution; each such row contributes ln(1) = 0 to the log statistics).

workload = name of the * directory. The statistic is taken over column 2 of
each file: 'count' in run files, 'avg_count' in the *.avg.csv files.
"""

import sys
import csv
import math
import glob
import os

# ---------------- CONFIG ----------------
MEASUREMENTS_DIR = "../measurements"
TIME_SUBDIR = "time"
OUTPUT = "../results/stats.csv"
# ----------------------------------------


def read_rows(path):
    """Return data rows (header dropped) as lists of strings, or None if the
    file doesn't look like a rank,<count> table."""
    with open(path, newline="") as f:
        reader = csv.reader(f)
        header = next(reader, None)
        if not header or len(header) < 2 or header[0] != "rank" \
                or header[1] not in ("count", "avg_count"):
            return None
        return [row for row in reader if row]


def compute_average(data):
    total = 0
    for row in data:
        total += float(row[1])

    n_values = len(data)
    avg = total/n_values

    return avg, n_values


def average_excluding_ones(data):
    """Mean of the values that are not exactly 1; '' if every value is 1."""
    vals = [float(row[1]) for row in data if float(row[1]) != 1]
    return sum(vals) / len(vals) if vals else ""

def variance(data, avg, n_values):
    variance = 0
    for row in data:
        variance += (float(row[1]) - avg)**2

    return variance / n_values


def log_stats(data, path):
    """Mean and sd of ln(x) and the geometric mean (= exp(mean of ln x)).
    Values <= 0 have no logarithm and are left out, with a warning."""
    logs = [math.log(float(row[1])) for row in data if float(row[1]) > 0]
    if len(logs) < len(data):
        print(f"{path}: {len(data) - len(logs)} value(s) <= 0 excluded from log stats",
              file=sys.stderr)
    if not logs:
        return "", "", ""

    mean = sum(logs) / len(logs)
    var = sum((x - mean)**2 for x in logs) / len(logs)    # population, like variance()
    return round(mean, 4), round(math.sqrt(var), 4), round(math.exp(mean), 4)


def analyze(path, workload, w):
    data = read_rows(path)
    if not data:
        print(f"skipping {path}: not a rank,count table (or empty)", file=sys.stderr)
        return

    avg, n_values = compute_average(data)
    var = variance(data, avg, n_values)
    sd = math.sqrt(var)
    log_mean, log_sd, geo_mean = log_stats(data, path)
    frac_ones = sum(1 for row in data if float(row[1]) == 1) / len(data)
    avg_no_ones = average_excluding_ones(data)
    if avg_no_ones != "":
        avg_no_ones = round(avg_no_ones, 4)

    w.writerow([workload, os.path.basename(path),
                round(avg, 4), round(var, 4), round(sd, 4), n_values,
                log_mean, log_sd, geo_mean, round(frac_ones, 4), avg_no_ones])


def main():
    time_dirs = sorted(glob.glob(os.path.join(MEASUREMENTS_DIR, "*", TIME_SUBDIR)))
    time_dirs = [d for d in time_dirs if os.path.isdir(d)]
    if not time_dirs:
        raise SystemExit(f"No {MEASUREMENTS_DIR}/*/{TIME_SUBDIR} directories found")

    os.makedirs(os.path.dirname(os.path.abspath(OUTPUT)), exist_ok=True)
    with open(OUTPUT, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["workload", "filename", "average", "variance", "standard deviation", "n_values",
                    "log_mean", "log_sd", "geometric_mean", "frac_ones", "average_no_ones"])
        for d in time_dirs:
            workload = os.path.basename(os.path.dirname(d))   # the * directory
            for path in sorted(glob.glob(os.path.join(d, "*.csv"))):
                analyze(path, workload, w)

    print(f"wrote {OUTPUT}")


if __name__ == "__main__":
    main()
