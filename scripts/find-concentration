#!/usr/bin/env python3
# This script was generated by Claude Code, Anthropic's AI coding
# assistant.
"""find-concentration -- how concentrated is the work, as in the 90:10 rule?

Usage:
  find-concentration [-k] [-e <counts.csv>] <list.csv>...

  -k                also the kernel's code: rows whose file is a name in
                    brackets, like [kernel.kallsyms] or [vdso], but not
                    [unknown]; without -k, user space only
  -e <counts.csv>   for time lists: measure against all the locations
                    that ran, from a count list (*counts.csv) of the
                    same workload, machine and level (instruction, line
                    or function); the count list may come from another
                    setup of the same machine (t14-4 for t14-3), as long
                    as it ran the same binary; locations perf never
                    sampled count as no time
  <list.csv>        ranked lists from rank (rank,count,...,file)

  For example, the ten time runs of one workload, against its count:

  find-concentration -e measurements/xz-6-lua/count/t14-3.run1.counts.csv \\
      measurements/xz-6-lua/time/t14-3.run*.samples.csv

Locations are what the list ranks: instructions, lines or functions. For
each list it prints how small a share of the locations (in %) holds 90 %
and 50 % of the time or of the executions, and one split of the form
N:100-N: the top N % of locations hold the other 100-N %. The 90:10 rule
says N = 10. With more than one list, also the lowest, median and
highest of each.

Only locations that ran are in a list, so "% of locations" means "% of
the code that ran", not of all the code in the program. A time list has
only the locations perf happened to sample, often a small part of those
that ran; without -e its shares come out far too large.
"""
import csv
import math
import re
import shlex
import statistics
import sys

FIX_LIST = "make the list with scripts/rank"


def die(message, fix=None):
    print(f"find-concentration: error: {message}", file=sys.stderr)
    if fix:
        print(f"\nfix it with:\n\n{fix}\n", file=sys.stderr)
    sys.exit(1)


def usage(status=1):
    """prints the docstring's Usage block; with 0 (for -h) to stdout"""
    lines = __doc__.split("\n")
    block = []
    for line in lines[lines.index("Usage:") + 1:]:
        if line and not line.startswith("  "):
            break
        block.append(line)
    text = "usage:\n" + "\n".join(block).rstrip()
    print(text, file=sys.stdout if status == 0 else sys.stderr)
    sys.exit(status)


def is_kernel(file):
    """perf names kernel code by a name in brackets, not a file;
    [unknown] is code outside any file, in user space"""
    return file.startswith("[") and file.endswith("]") and file != "[unknown]"


def level(path):
    """instruction, line or function, from rank's file names"""
    name = path.rsplit("/", 1)[-1]
    for lv in ("line", "function"):
        if f".{lv}-" in name:
            return lv
    return "instruction"


def read_list(path, kernel):
    """the list's counts above 0, largest first, and how many are kernel
    code"""
    # a C++ name in clang's line lists can be longer than csv allows by default
    csv.field_size_limit(2 ** 31 - 1)
    counts = []
    kernel_rows = 0
    try:
        with open(path, encoding="utf-8", newline="") as f:
            rows = csv.reader(f)
            try:
                header = next(rows, None)
                if not header:
                    die(f"{path}: empty file; {FIX_LIST}")
                if "count" not in header:
                    die(f"{path}: no 'count' column; {FIX_LIST}")
                if "file" not in header and not kernel:
                    die(f"{path}: no 'file' column, so kernel code cannot be left out; "
                        f"add -k to count all rows, or {FIX_LIST}")
                count = header.index("count")
                file = header.index("file") if "file" in header else None
                last = max(count, file or 0)
                for row in rows:
                    if len(row) <= last:
                        die(f"{path}, line {rows.line_num}: too few columns; {FIX_LIST}")
                    try:
                        n = int(row[count])
                    except ValueError:
                        n = -1
                    if n < 0:
                        die(f"{path}, line {rows.line_num}: count {row[count]!r} is not a whole "
                            f"number of 0 or more; {FIX_LIST}")
                    if n == 0:
                        continue
                    if file is not None and is_kernel(row[file]):
                        kernel_rows += 1
                        if not kernel:
                            continue
                    counts.append(n)
            except csv.Error as error:
                die(f"{path}, line {rows.line_num}: not a CSV line ({error}); {FIX_LIST}")
    except UnicodeDecodeError:
        die(f"{path}: not a text file; give a ranked list (.csv) from scripts/rank")
    except OSError as error:
        die(f"{path}: {error.strerror.lower()}")
    counts.sort(reverse=True)
    return counts, kernel_rows


def where(path):
    """(workload, platform) from a path like
    measurements/<workload>/count/<platform>.run1.counts.csv, or None"""
    m = re.search(r"([^/]+)/(?:time|count)/([^/.]+)\.run\d+\.[^/]*$", path)
    return m.groups() if m else None


def machine(setup):
    """the machine of a setup name: t14 for t14-3"""
    return re.sub(r"-\d+$", "", setup)


def main_file(path):
    """the file with the most executions in a count list: the program that
    ran"""
    csv.field_size_limit(2 ** 31 - 1)
    per = {}
    with open(path, encoding="utf-8", newline="") as f:
        rows = csv.reader(f)
        header = next(rows)
        if "file" not in header:
            return None
        count, file = header.index("count"), header.index("file")
        for row in rows:
            if not is_kernel(row[file]):
                per[row[file]] = per.get(row[file], 0) + int(row[count])
    return max(per, key=per.get) if per else None


def files(path):
    """the files a list names, kernel code left out"""
    csv.field_size_limit(2 ** 31 - 1)
    with open(path, encoding="utf-8", newline="") as f:
        rows = csv.reader(f)
        header = next(rows)
        if "file" not in header:
            return None
        file = header.index("file")
        return {row[file] for row in rows if not is_kernel(row[file])}


def split(counts, n):
    """(% of n locations holding 90 % of the total, the same for 50 %, N
    of N:100-N); the locations beyond the list count as 0"""
    total = sum(counts)
    run = 0
    need = {}
    point = None
    for k, c in enumerate(counts, 1):
        run += c
        # whole numbers, not floats: a float can miss an exact tie
        for share, (a, b) in ((0.9, (9, 10)), (0.5, (1, 2))):
            if share not in need and run * b >= total * a:
                need[share] = k
        if point is None and run * n >= total * (n - k):
            point = k
    return 100 * need[0.9] / n, 100 * need[0.5] / n, 100 * (point or n) / n


def fmt(x):
    """3 significant digits, no exponent"""
    if x == 0:
        return "0"
    return f"{x:.{max(0, 2 - math.floor(math.log10(abs(x))))}f}"


def main():
    args = sys.argv[1:]
    if not args:
        usage()
    if "-h" in args or "--help" in args:
        usage(0)
    kernel = False
    ran_list = None
    while args and args[0].startswith("-") and args[0] != "-":
        opt = args.pop(0)
        if opt == "--":
            break
        if opt == "-k":
            kernel = True
        elif opt == "-e":
            if not args:
                die("-e needs a count list")
            ran_list = args.pop(0)
        else:
            die(f"unknown option {opt}; see -h")
    if not args:
        usage()

    ran = None
    if ran_list is not None:
        if "counts" not in ran_list.rsplit("/", 1)[-1]:
            die(f"{ran_list} is not a count list; -e needs one of rank's *counts.csv")
        ran_counts, _ = read_list(ran_list, False)
        if not ran_counts:
            die(f"{ran_list}: no counts above 0")
        ran = len(ran_counts)
        ran_main = main_file(ran_list)

    results = []
    unsampled = []
    for path in args:
        if ran is not None:
            if level(path) != level(ran_list):
                die(f"{path} is a{'n' if level(path)[0] == 'i' else ''} {level(path)} list, but "
                    f"{ran_list} is a{'n' if level(ran_list)[0] == 'i' else ''} {level(ran_list)} list; "
                    "-e needs a count list of the same level")
            # a setup is <machine>-<n>; another setup of the same machine
            # (t14-4 for t14-3) is allowed: some workloads were counted there
            a, b = where(path), where(ran_list)
            if a and b and (a[0], machine(a[1])) != (b[0], machine(b[1])):
                what = "workload" if a[0] != b[0] else "machine"
                this, that = (a[0], b[0]) if a[0] != b[0] else (a[1], b[1])
                die(f"{path} is {what} {this}, but the -e count list is {that}; "
                    "-e needs a count list of the same workload and machine")

        counts, kernel_rows = read_list(path, kernel)
        if not counts:
            if kernel_rows and not kernel:
                die(f"{path}: only kernel code; include it with -k",
                    shlex.join([sys.argv[0], "-k", *sys.argv[1:]]))
            die(f"{path}: no counts above 0")
        # a time list may spend most of its time in a library (memcpy in
        # libc), so it need not have the most samples in the program file:
        # it must only have sampled it
        if ran is not None and ran_main is not None:
            sampled = files(path)
            if sampled is not None and ran_main not in sampled:
                die(f"{path} has no sample in {ran_main}, the program {ran_list} counted; "
                    "-e needs a count list of the same workload and machine")
        n = len(counts)
        timed = ".samples." in path or "-samples." in path
        what = f"{n:,} sampled" if timed else f"{n:,} location{'s' if n != 1 else ''}"
        if ran is not None:
            # count lists have no kernel code: with -k, the list's own kernel
            # locations are added to those that ran
            n_ran = ran + (kernel_rows if kernel else 0)
            if n_ran < n:
                die(f"{path} has {n} locations, more than the {n_ran} that ran by {ran_list}; "
                    "-e needs a count list of the same workload and machine")
            what = f"of {n_ran:,} that ran, perf sampled {n:,}"
            n = n_ran
        elif timed:
            unsampled.append(path)
        p90, p50, point = split(counts, n)
        results.append((p90, p50, point))
        total = "time" if timed else "executions" if "counts" in path.rsplit("/", 1)[-1] else "total"
        print(f"{path}: 90 % of the {total} in {fmt(p90)} % of locations, 50 % in {fmt(p50)} %; "
              f"split {fmt(point)}:{fmt(100 - point)}  ({what})")

    if len(results) > 1:
        print(f"{len(results)} lists (lowest / median / highest):")
        for i, name in enumerate(("locations holding 90 % (%)", "locations holding 50 % (%)",
                                  "N of the split N:100-N")):
            v = [r[i] for r in results]
            print(f"  {name:30} {fmt(min(v))} / {fmt(statistics.median(v))} / {fmt(max(v))}")
    if unsampled:
        sys.stdout.flush()
        print("find-concentration: warning: perf sampled only some of the locations that ran, so these shares come out "
              "too large; add -e <counts.csv> to measure against all that ran", file=sys.stderr)


if __name__ == "__main__":
    main()
