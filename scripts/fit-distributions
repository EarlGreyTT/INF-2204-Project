#!/usr/bin/env python3

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

"""fit-distributions -- which distribution do a ranked list's counts follow?

Usage:
  fit-distributions [-k] [-b <bootstraps>] [-j <jobs>] [-d <object>]... <list.csv>...

  -k               also the kernel's code: rows whose file is a name in
                   brackets, like [kernel.kallsyms] or [vdso], but not
                   [unknown]; without -k, user space only
  -b <bootstraps>  per distribution, for the fit p (default 200; about
                   2500 make p right to within 0.01; 0 skips them)
  -j <jobs>        how many bootstraps run at once (default: one per CPU)
  -d <object>      only the locations in this file, e.g. -d xz for xz's
                   own code; may be given more than once
  <list.csv>       ranked lists from rank (rank,count,...,file)

  For example, the fits alone, without bootstraps, for one count list:

  fit-distributions -b 0 measurements/xz-6-lua/count/t14-3.run1.counts.csv

It fits each of these distributions to all the counts in a list, by
maximum likelihood, and compares them on the same data:

  power law              p(x) ~ x^-alpha            (Zipf's law: alpha = 2)
  shifted power law      p(x) ~ (x + q)^-alpha      (the power law, flattened at small x)
  Yule-Simon             p(x) = rho B(x, rho + 1)   (a power-law tail, alpha = rho + 1)
  truncated power law    p(x) ~ x^-alpha e^(-lambda x)
  lognormal              S(x) = lognormal survival function
  stretched exponential  S(x) = e^(-(lambda x)^beta)
  exponential            S(x) = e^(-lambda x)

The first four are for whole numbers. The last three are for any number
and are made whole as p(x) = [S(x) - S(x+1)] / S(1), as in Clauset,
Shalizi & Newman (2009) and the powerlaw package (Alstott et al. 2014).

For each distribution it prints:
  log-lik  the log-likelihood: higher fits better
  dAIC     how far behind the best it is by AIC (2 x parameters
           - 2 x log-lik: a parameter must earn its place)
  KS D     the largest gap between the data's and the distribution's
           cumulative shares
  fit p    the share of data sets drawn from the fitted distribution
           that fit it worse than the data does; below 0.1 rules the
           distribution out. Only for those within 10 of the best AIC.

Then the best by AIC is compared with each of the others by likelihood
ratio: Vuong's test, or for a nested pair (one is the other with a
parameter fixed) the chi-squared test, halved where that value is at the
edge of the other's range (the truncated power law with lambda = 0 or
alpha = 0). Two that the data cannot tell apart (their log-likelihood
differences small both in spread and in sum) are reported as
indistinguishable (Vuong 1989). The results are the same on every run,
whatever -j.
"""

import argparse
import csv
import shlex
import sys
from concurrent.futures import ProcessPoolExecutor

FIX_LIST = "make the list with scripts/rank"


def die(message, fix=None):
    print(f"fit-distributions: error: {message}", file=sys.stderr)
    if fix:
        print(f"\nfix it with:\n\n{fix}\n", file=sys.stderr)
    sys.exit(1)


def usage(status=1):
    """prints the docstring's Usage block; with 0 (for -h) to stdout"""
    lines = __doc__.split("\n")
    block = []
    for line in lines[lines.index("Usage:") + 1:]:
        if line and not line.startswith("  "):
            break
        block.append(line)
    text = "usage:\n" + "\n".join(block).rstrip()
    print(text, file=sys.stdout if status == 0 else sys.stderr)
    sys.exit(status)


# usage before NumPy and SciPy load: they take about 2 s
if __name__ == "__main__":
    if not sys.argv[1:]:
        usage()
    if "-h" in sys.argv[1:] or "--help" in sys.argv[1:]:
        usage(0)

try:
    import numpy as np
    from scipy import optimize, special, stats
except ImportError as e:
    die(f"{e.name} is not installed", "sudo apt install python3-numpy python3-scipy")

SEED = 1
PLAUSIBLE = 10  # AIC difference within which a distribution is bootstrapped
M = 1000  # exact terms in the truncated power law's normalising sum (the rest: an integral, within 3e-8)
GRID = np.arange(1, M + 1, dtype=float)
# Gauss-Legendre nodes and weights on [0, 1], for that integral
_x, _w = np.polynomial.legendre.leggauss(100)
QX, QW = (_x + 1) / 2, _w / 2
SUM_U = np.arange(1, 10 ** 6 + 1, dtype=float)  # where a fit's probabilities are summed as a check


def is_kernel(file):
    """perf names kernel code by a name in brackets, not a file. [unknown]
    is code outside any file, in user space. [vdso] counts as kernel:
    count lists never have it."""
    return file.startswith("[") and file.endswith("]") and file != "[unknown]"


def read_list(path, objects, kernel):
    """(the counts above 0 to fit, how many of the list's counts are
    kernel code, and their sum); None and 0 without a file column"""
    # a C++ name in clang's line lists can be longer than csv allows by default
    csv.field_size_limit(2 ** 31 - 1)
    pairs = []
    try:
        with open(path, encoding="utf-8", newline="") as f:
            rows = csv.reader(f)
            try:
                header = next(rows, None)
                if not header:
                    die(f"{path}: empty file; {FIX_LIST}")
                if "count" not in header:
                    die(f"{path}: no 'count' column; {FIX_LIST}")
                if "file" not in header:
                    if objects:
                        die(f"{path}: no 'file' column, which -d needs; {FIX_LIST}")
                    if not kernel:
                        die(f"{path}: no 'file' column, so kernel code cannot be left out; "
                            f"add -k to fit all rows, or {FIX_LIST}")
                count = header.index("count")
                file = header.index("file") if "file" in header else None
                last = max(count, file or 0)
                for row in rows:
                    if len(row) <= last:
                        die(f"{path}, line {rows.line_num}: too few columns; {FIX_LIST}")
                    text = row[count]
                    try:
                        n = int(text)
                    except ValueError:
                        n = -1
                    if n < 0:
                        die(f"{path}, line {rows.line_num}: count {text!r} is not a whole number "
                            f"of 0 or more; {FIX_LIST}")
                    pairs.append((n, row[file] if file is not None else ""))
            except csv.Error as error:
                die(f"{path}, line {rows.line_num}: not a CSV line ({error}); {FIX_LIST}")
    except UnicodeDecodeError:
        die(f"{path}: not a text file; give a ranked list (.csv) from scripts/rank")
    except OSError as error:
        die(f"{path}: {error.strerror.lower()}")
    if not pairs:
        die(f"{path}: no rows below the header; {FIX_LIST}")
    pairs = [(n, o) for n, o in pairs if n > 0 and (not objects or o in objects)]
    in_kernel = [n for n, o in pairs if is_kernel(o)]
    try:
        vals = np.array([n for n, o in pairs if kernel or not is_kernel(o)], dtype=np.int64)
    except OverflowError:
        die(f"{path}: a count is too big to read; {FIX_LIST}")
    if file is None:
        return vals, None, 0
    return vals, len(in_kernel), sum(in_kernel)


# ---------- the candidates ----------
#
# Each has a log probability for the distinct values u, P(X <= u), a
# sampler, and starting points for the fit. Parameters marked positive
# are searched on a log scale: lambda for instruction counts is around
# 1e-8, far from the other parameters. One-parameter models are searched
# within bounds, on that scale.

def disc_logpmf(logsf, u):
    """log p(u) for a continuous distribution discretised on u >= 1"""
    a = logsf(u)
    b = logsf(u + 1)
    return a + np.log(-np.expm1(b - a)) - logsf(np.array([1.0]))[0]


def disc_cdf(logsf, u):
    return -np.expm1(logsf(u + 1) - logsf(np.array([1.0]))[0])


class Limit:
    """What lognormal and stretched exponential become as they degenerate:
    a discretised continuous power law, S(x) = x^-gamma. Their fits store
    it as the one parameter gamma."""
    positive, bounds = (True,), (np.log(1e-4), np.log(20))

    def logpmf(self, p, u):
        (g,) = p
        return -g * np.log(u) + np.log(-np.expm1(-g * np.log1p(1 / u)))

    def cdf(self, p, u):
        return -np.expm1(-p[0] * np.log1p(u))

    def sample(self, rng, p, n):
        logx = -np.log1p(-rng.random(n)) / p[0]
        return np.floor(np.exp(np.minimum(logx, 62 * np.log(2)))).astype(np.int64)

    def note(self, p):
        return f"degenerate: at its limit, about a continuous power law, S(x) = x^-gamma, gamma = {p[0]:.4g}"


LIMIT = Limit()


class PowerLaw:
    name, params, positive, bounds = "power law", ("alpha",), (False,), (1 + 1e-9, 20)

    def logpmf(self, p, u):
        (a,) = p
        if a <= 1:
            return None
        return -a * np.log(u) - np.log(special.zeta(a, 1))

    def cdf(self, p, u):
        (a,) = p
        return 1 - special.zeta(a, u + 1) / special.zeta(a, 1)

    def sample(self, rng, p, n):
        return rng.zipf(p[0], n).astype(np.int64)


class ShiftedPowerLaw:
    # Often called Zipf-Mandelbrot, but Mandelbrot's law shifts the rank,
    # f(r) ~ (r + q)^-s; this shifts the count (a Hurwitz zeta
    # distribution). Their tails match: a rank law with exponent s gives
    # counts with alpha = 1 + 1/s.
    name, params, positive = "shifted power law", ("alpha", "q"), (False, False)

    def logpmf(self, p, u):
        a, q = p
        if a <= 1 or q <= -1:
            return None
        z = special.zeta(a, 1 + q)
        # subnormal for large alpha and q, and then far from the true sum
        if not z >= np.finfo(float).tiny:
            return None
        return -a * np.log(u + q) - np.log(z)

    def cdf(self, p, u):
        a, q = p
        return 1 - special.zeta(a, u + 1 + q) / special.zeta(a, 1 + q)

    def sample(self, rng, p, n):
        # inverse transform: the smallest k with P(X <= k) >= r, by bisection
        r = rng.random(n)
        lo, hi = np.ones(n), np.full(n, 2.0 ** 53)
        for _ in range(54):
            mid = np.floor((lo + hi) / 2)
            up = self.cdf(p, mid) >= r
            hi = np.where(up, mid, hi)
            lo = np.where(up, lo, mid + 1)
        return lo.astype(np.int64)

    def starts(self, x):
        return [[2.0, 0.0], [1.5, 1.0], [2.0, 10.0]]


class YuleSimon:
    name, params, positive, bounds = "Yule-Simon", ("rho",), (True,), (np.log(1e-4), np.log(50))

    def logpmf(self, p, u):
        if p[0] <= 0:
            return None
        return stats.yulesimon.logpmf(u, p[0])

    def cdf(self, p, u):
        return stats.yulesimon.cdf(u, p[0])

    def sample(self, rng, p, n):
        return stats.yulesimon.rvs(p[0], size=n, random_state=rng).astype(np.int64)


class TruncatedPowerLaw:
    name, params, positive = "truncated power law", ("alpha", "lambda"), (True, True)

    # Sum of g^-a e^(-lam (g - 1)) over g >= y > M: the integral plus the
    # first Euler-Maclaurin correction. With g = y e^v the integral is
    #   y^(1-a) e^(-lam (y - 1)) * int_0^inf e^((1-a) v - lam y (e^v - 1)) dv,
    # a smooth integrand, cut where it is below e^-60 of its value. (Summing
    # terms up to the largest count needs billions of them for instruction
    # counts; the closed form, a confluent hypergeometric U(a, a, lam y), is
    # wrong in SciPy near whole alpha.)
    def _tail(self, a, lam, y):
        out = np.empty(len(y))
        for i in range(0, len(y), 4096):
            yy = y[i:i + 4096]
            z = lam * yy
            cut = np.log1p(60 / z)
            v = cut[:, None] * QX
            integral = cut * (np.exp((1 - a) * v - z[:, None] * np.expm1(v)) @ QW)
            out[i:i + 4096] = yy ** (-a) * np.exp(-lam * (yy - 1)) * (yy * integral + 0.5)
        return out

    def _terms(self, a, lam):
        return GRID ** (-a) * np.exp(-lam * (GRID - 1))

    def _logz(self, a, lam):
        return np.log(self._terms(a, lam).sum() + self._tail(a, lam, np.array([M + 1.0]))[0])

    def logpmf(self, p, u):
        a, lam = p
        # The integral above is checked down to lam y = 1e-12; below that,
        # e^(-lam x) differs from 1 by under 0.1% up to x = 1e12.
        if a <= 0 or lam * (M + 1) < 1e-12:
            return None
        return -a * np.log(u) - lam * (u - 1) - self._logz(a, lam)

    def cdf(self, p, u):
        a, lam = p
        terms = self._terms(a, lam)
        z = terms.sum() + self._tail(a, lam, np.array([M + 1.0]))[0]
        head = np.cumsum(terms)
        small = u <= M
        below = np.empty(len(u))
        below[small] = head[u[small].astype(np.int64) - 1]
        below[~small] = z - self._tail(a, lam, (u[~small] + 1).astype(float))
        return below / z

    def sample(self, rng, p, n):
        # rejection sampling, from whichever of the two factors gives the
        # better acceptance: a Zipf draw kept with probability
        # e^(-lam (x - 1)), or a geometric draw kept with probability x^-a.
        # Where both accept little (alpha near or below 1, small lambda),
        # the bisection the shifted power law uses.
        a, lam = p
        z = np.exp(self._logz(a, lam))
        by_zipf = z / special.zeta(a, 1) if a > 1 else 0
        by_geometric = -np.expm1(-lam) * z
        if max(by_zipf, by_geometric) < 0.01:
            return ShiftedPowerLaw.sample(self, rng, p, n)
        out = np.empty(0, dtype=np.int64)
        while len(out) < n:
            k = 2 * (n - len(out)) + 16
            if by_zipf > by_geometric:
                x = rng.zipf(a, k)
                keep = rng.random(k) < np.exp(-lam * (x - 1))
            else:
                x = rng.geometric(-np.expm1(-lam), k)
                keep = rng.random(k) < x ** (-a)
            out = np.concatenate([out, x[keep]])
        return out[:n]

    def starts(self, x):
        return [[1.5, 1 / x.mean()], [2.0, 1 / x.max()], [0.5, 1 / x.mean()]]


class Lognormal:
    name, params, positive = "lognormal", ("mu", "sigma"), (False, True)

    def _logsf(self, p):
        # as the normal distribution of log v, which stays finite where
        # scipy's lognorm divides by exp(mu)
        mu, s = p
        return lambda v: stats.norm.logsf((np.log(v) - mu) / s)

    def logpmf(self, p, u):
        if len(p) == 1:
            return LIMIT.logpmf(p, u)
        mu, s = p
        if s <= 0:
            return None
        # S(u) - S(u+1) is the normal's mass between z and z + dz. For large
        # counts that step is so small that subtracting the two would leave
        # only rounding; there the mass is the height at the step's middle
        # times dz, with the first correction (error under (dz m)^4 / 1920).
        z = (np.log(u) - mu) / s
        dz = np.log1p(1 / u) / s
        m = z + dz / 2
        small = dz * np.maximum(1, np.abs(m)) < 1e-3
        out = np.empty(len(u))
        ms, ds = m[small], dz[small]
        out[small] = stats.norm.logpdf(ms) + np.log(ds) + np.log1p(ds ** 2 * (ms ** 2 - 1) / 24)
        a = stats.norm.logsf(z[~small])
        b = stats.norm.logsf(z[~small] + dz[~small])
        out[~small] = a + np.log(-np.expm1(b - a))
        return out - stats.norm.logsf(-mu / s)

    def cdf(self, p, u):
        if len(p) == 1:
            return LIMIT.cdf(p, u)
        return disc_cdf(self._logsf(p), u)

    def sample(self, rng, p, n):
        if len(p) == 1:
            return LIMIT.sample(rng, p, n)
        # log x from the normal distribution, above log 1 = 0
        mu, s = p
        logx = stats.truncnorm.rvs(-mu / s, np.inf, loc=mu, scale=s, size=n, random_state=rng)
        return np.floor(np.exp(np.minimum(logx, 62 * np.log(2)))).astype(np.int64)

    def degenerate(self, p):
        if len(p) == 1:
            return LIMIT.note(p)
        mu, s = p
        if mu + 3 * s < 0:
            return "degenerate: almost all of it lies below 1, and the part above behaves like a power law"

    def starts(self, x):
        lx = np.log(x)
        return [[lx.mean(), max(lx.std(), 0.1)]]


class StretchedExponential:
    name, params, positive = "stretched exponential", ("lambda", "beta"), (True, True)

    # Searched and stored as (C, beta), C = lambda^beta, so that
    # S(x) = e^(-C x^beta): as beta goes to 0, lambda runs past the largest
    # float while C stays moderate. log p is computed without subtracting
    # two values of C x^beta, which are huge near that limit.
    def logpmf(self, p, u):
        if len(p) == 1:
            return LIMIT.logpmf(p, u)
        c, beta = p
        if c <= 0 or beta <= 0:
            return None
        lu = np.log(u)
        step = np.exp(np.log(c) + beta * lu) * np.expm1(beta * np.log1p(1 / u))
        return -c * np.expm1(beta * lu) + np.log(-np.expm1(-step))

    def cdf(self, p, u):
        if len(p) == 1:
            return LIMIT.cdf(p, u)
        c, beta = p
        return -np.expm1(-c * np.expm1(beta * np.log1p(u)))

    def sample(self, rng, p, n):
        if len(p) == 1:
            return LIMIT.sample(rng, p, n)
        # solves S(x) = r S(1) for x, on the log scale
        c, beta = p
        logx = np.log1p(-np.log(rng.random(n)) / c) / beta
        return np.floor(np.exp(np.minimum(logx, 62 * np.log(2)))).astype(np.int64)

    def shown(self, p):
        if len(p) == 1:
            return p
        c, beta = p
        with np.errstate(over="ignore"):  # lambda can pass the largest float: shown as inf
            return [np.exp(np.log(c) / beta), beta]

    def degenerate(self, p):
        if len(p) == 1:
            return LIMIT.note(p)
        if p[1] < 0.05:
            return "degenerate: beta near 0 makes it a power law"

    def starts(self, x):
        return [[x.mean() ** -0.5, 0.5], [x.mean() ** -0.2, 0.2], [1 / np.median(x), 1.0]]


class Exponential:
    name, params, positive, bounds = "exponential", ("lambda",), (True,), (np.log(1e-15), np.log(20))

    def logpmf(self, p, u):
        (lam,) = p
        if lam <= 0:
            return None
        return disc_logpmf(lambda v: -lam * v, u)

    def cdf(self, p, u):
        (lam,) = p
        return disc_cdf(lambda v: -lam * v, u)

    def sample(self, rng, p, n):
        x = 1 - np.log(rng.random(n)) / p[0]
        return np.minimum(np.floor(x), 2.0 ** 62).astype(np.int64)


MODELS = [PowerLaw(), ShiftedPowerLaw(), YuleSimon(), TruncatedPowerLaw(), Lognormal(),
          StretchedExponential(), Exponential()]
# (smaller, larger): the smaller is the larger with one parameter fixed.
# The exponential, made whole, is the truncated power law with alpha = 0.
NESTED = {("power law", "truncated power law"), ("power law", "shifted power law"),
          ("exponential", "stretched exponential"), ("exponential", "truncated power law")}
# nested at the edge of the larger's parameters (lambda = 0, alpha = 0).
# Tested on power laws: halved, it rules out a true power law a little
# too often (14% of lists at p < 0.1, not 10%).
BOUNDARY = {("power law", "truncated power law"), ("exponential", "truncated power law")}


# ---------- fitting ----------

class FitFailed(Exception):
    pass


def fit(model, x):
    """(parameters, log p of each distinct value, the distinct values and
    how often each occurs); raises FitFailed if no fit has a finite
    likelihood. Lognormal and stretched exponential are also fitted at the
    limit they degenerate to, and the better of the two is kept."""
    u, c = np.unique(x, return_counts=True)
    u = u.astype(float)

    def search(m, starts):
        def nll(p):
            lp = m.logpmf(p, u)
            if lp is None or not np.all(np.isfinite(lp)):
                return 1e300
            return -(c * lp).sum()

        def to_search(p):
            return [np.log(v) if pos else v for v, pos in zip(p, m.positive)]

        def from_search(q):
            return np.array([np.exp(v) if pos else v for v, pos in zip(q, m.positive)])

        best, best_nll = None, None
        # The search tries extreme parameters where the sums overflow; nll()
        # rejects those, so NumPy's warnings are expected. The chosen fit is
        # evaluated again below, outside this block, and dropped if not finite.
        with np.errstate(over="ignore", invalid="ignore", divide="ignore", under="ignore"):
            if starts is None:
                r = optimize.minimize_scalar(lambda q: nll(from_search([q])), bounds=m.bounds,
                                             method="bounded", options={"xatol": 1e-10})
                best, best_nll = from_search([r.x]), r.fun
            else:
                for p0 in starts:
                    r = optimize.minimize(lambda q: nll(from_search(q)), to_search(p0),
                                          method="Nelder-Mead",
                                          options={"maxiter": 20000, "xatol": 1e-10, "fatol": 1e-10})
                    if best_nll is None or r.fun < best_nll:
                        best, best_nll = from_search(r.x), r.fun
        return best, best_nll

    best, best_nll = search(model, None if len(model.params) == 1 else model.starts(x))
    if hasattr(model, "degenerate"):
        g, g_nll = search(LIMIT, None)
        # a degenerate fit within 0.001 of the limit is that limit
        if g_nll < best_nll or (model.degenerate(best) and g_nll < best_nll + 1e-3):
            best = g
    lp = model.logpmf(best, u)
    if lp is None or not np.all(np.isfinite(lp)):
        raise FitFailed("no finite likelihood")
    return best, lp, u, c


def checked_fit(model, x):
    """fit(), but a numerical error in a normalising sum can make a fit
    look better than it is; it shows as probabilities summing past 1."""
    p, lp, u, c = fit(model, x)
    with np.errstate(under="ignore"):
        lps = model.logpmf(p, SUM_U)
    if lps is not None and not np.exp(lps).sum() <= 1 + 1e-6:
        raise FitFailed(f"rejected: its probabilities sum to {np.exp(lps).sum():.4g}, "
                        "more than 1 (a numerical error)")
    return p, lp, u, c


def ks(model, p, u, c):
    # over the data's values, not their ranks, as the powerlaw package does
    emp = np.cumsum(c) / c.sum()
    return np.max(np.abs(emp - model.cdf(p, u)))


def bootstrap_one(job):
    """KS distance of one data set drawn from the fitted distribution to
    its own fit, or None if it could not be fitted."""
    seed, i, p, n = job
    model = MODELS[i]
    rng = np.random.default_rng(seed)
    with np.errstate(over="ignore", invalid="ignore", divide="ignore", under="ignore"):
        s = model.sample(rng, p, n)
    try:
        p, _, u, c = fit(model, s)
    except FitFailed:
        return None
    return ks(model, p, u, c)


def gof(i, p, n, d, reps, jobs):
    """(bootstraps that fit worse than the data, bootstraps that could be
    fitted)"""
    # one seed per bootstrap, so the result does not depend on -j
    seeds = np.random.SeedSequence([SEED, i]).spawn(reps)
    with ProcessPoolExecutor(max_workers=jobs) as ex:
        ds = [r for r in ex.map(bootstrap_one, [(s, i, p, n) for s in seeds], chunksize=4)
              if r is not None]
    return sum(r >= d for r in ds), len(ds)


def fmt_p(p):
    """A test's p-value, with its magnitude: the tests' approximations do
    not hold below about 1e-16, so smaller values are shown as a bound."""
    if p >= 0.001:
        return f"= {p:.3f}"
    if p >= 1e-16:
        return f"= {p:.1e}"
    return "< 1e-16"


def fmt_fit_p(worse, done):
    """A bootstrap p: counted, so it cannot resolve below 1 / bootstraps"""
    if worse == 0:
        return f"< {1 / done:.2g}"
    return f"{worse / done:.3f}"


def vuong(l1, l2, larger, boundary, k):
    """(R, p, verdict) for the best (l1) against another (l2): R > 0
    favours the best. larger: for a nested pair 1 if the best is the larger
    model, -1 if the other is; 0 if not nested. k: both models' parameters."""
    d = l1 - l2
    R = d.sum()
    if larger:
        # larger over smaller; below 0 only by a search error
        lr = max(2 * larger * R, 0)
        p = stats.chi2.sf(lr, 1)
        if boundary:
            # the smaller sits on the edge of the larger's parameters, so
            # the ratio is 0 half the time (Self & Liang 1987)
            p = p / 2 if lr > 0 else 1.0
    else:
        # Where the two may be the same distribution (all pointwise
        # differences 0), the normal test does not hold. Vuong (1989): then
        # n var(d) and 2R follow weighted sums of chi-squareds; chi-squared
        # with k degrees of freedom stands in for both (all weights 1). If
        # neither is beyond it, the two cannot be told apart.
        c = stats.chi2.isf(0.1, k)
        if len(d) * d.var() <= c and 2 * abs(R) <= c:
            return R, None, "indistinguishable"
        p = special.erfc(abs(R) / (np.sqrt(2 * len(d)) * d.std()))
    if p >= 0.1:
        return R, p, "not significantly worse"
    if R > 0:
        return R, p, "significantly worse"
    return R, p, "fits significantly better, but worse by AIC"


# ---------- report ----------

def locations(n):
    return f"{n:,} location{'' if n == 1 else 's'}"


def analyse(path, x, kernel_n, kernel_sum, objects, reps, kernel, jobs):
    what = f" (only {', '.join(objects)})" if objects else ""
    where = "in the selected objects" if objects else "in this list"
    if kernel_n is None:
        code = "user space and kernel (no file column to tell them apart)"
    elif not kernel_n:
        code = ("user space and kernel" if kernel else "user space only") + \
            f" (no kernel code {where})"
    else:
        share = f"{100 * kernel_sum / (x.sum() + (0 if kernel else kernel_sum)):.2f}% of the counts" + \
            (" in the selected objects" if objects else "")
        code = (f"user space and kernel: {kernel_n:,} kernel locations, {share}" if kernel else
                f"user space only: left out {kernel_n:,} kernel locations, {share}")
    if len(x) < 10:
        print(f"=== {path}{what}: {locations(len(x))}, too few to fit\n  {code}\n")
        return
    print(f"=== {path}{what}: {locations(len(x))}, counts sum to {x.sum():,}, "
          f"from {x.min():,} to {x.max():,}")
    print(f"  {code}")

    results, failed = [], []
    for i, model in enumerate(MODELS):
        try:
            p, lp, u, c = checked_fit(model, x)
        except FitFailed as e:
            failed.append((model, str(e)))
            continue
        ll = (c * lp).sum()
        # a degenerate fit has one parameter, not the model's two
        results.append((model, i, dict(p=p, lp=lp, u=u, c=c, ll=ll,
                                       aic=2 * len(p) - 2 * ll, d=ks(model, p, u, c))))
    if not results:
        for model, why in failed:
            print(f"  {model.name:22s} fit failed: {why}")
        print("  no distribution could be fitted\n")
        return
    fitted = sorted(results, key=lambda r: r[2]["aic"])
    best = fitted[0]
    plausible = sum(r["aic"] - best[2]["aic"] <= PLAUSIBLE for _, _, r in fitted)
    if reps:
        sys.stdout.flush()
        print(f"fit-distributions: {path}: {reps} bootstraps for each of {plausible} "
              f"distribution{'' if plausible == 1 else 's'}", file=sys.stderr)

    print(f"  {'distribution':22s} {'parameters':34s} {'log-lik':>12s} {'dAIC':>10s} {'KS D':>7s} {'fit p':>7s}")
    notes = []
    for model, i, r in fitted:
        names = model.params if len(r["p"]) == len(model.params) else ("gamma",)
        ps = ", ".join(f"{k}={v:.4g}" for k, v in zip(names, getattr(model, "shown", lambda p: p)(r["p"])))
        note = getattr(model, "degenerate", lambda p: None)(r["p"])
        if note:
            notes.append(f"{model.name}: {note}")
        # far behind by AIC, a distribution is ruled out already
        if reps and r["aic"] - best[2]["aic"] <= PLAUSIBLE:
            worse, done = gof(i, r["p"], len(x), r["d"], reps, jobs)
            fp = (f"{fmt_fit_p(worse, done):>7s}" if done else "      ?") + \
                ("" if done == reps else f"  ({done} of {reps} bootstraps fitted)")
        else:
            fp = f"{'-':>7s}"
        print(f"  {model.name:22s} {ps:34s} {r['ll']:12.1f} {r['aic'] - best[2]['aic']:10.1f} "
              f"{r['d']:7.4f} {fp}")
    for model, why in failed:
        print(f"  {model.name:22s} fit failed: {why}")
    for n in notes:
        print(f"  {n}")
    if reps:
        print(f"  (fit p: from {reps} bootstraps each, for those within {PLAUSIBLE} of the best AIC;"
              " p < 0.1 rules the distribution out)")

    bm, _, br = best
    lbest = np.repeat(br["lp"], br["c"])
    print(f"  best by AIC: {bm.name}. Compared with it:")
    for model, i, r in fitted[1:]:
        pair = (model.name, bm.name)
        # a fit at its degenerate limit is no longer the larger model
        whole = len(r["p"]) == len(model.params) and len(br["p"]) == len(bm.params)
        larger = 0 if not whole else 1 if pair in NESTED else -1 if pair[::-1] in NESTED else 0
        R, pv, verdict = vuong(lbest, np.repeat(r["lp"], r["c"]), larger,
                               pair in BOUNDARY or pair[::-1] in BOUNDARY, len(r["p"]) + len(br["p"]))
        print(f"    {model.name:22s} R={R:10.2f}  p {fmt_p(pv) if pv is not None else '-':9s}  {verdict}")
    print()


def main():
    argv = sys.argv[1:]
    parser = argparse.ArgumentParser(add_help=False)
    parser.error = lambda _: usage()
    parser.add_argument("-k", dest="kernel", action="store_true")
    parser.add_argument("-b", dest="bootstraps", default="200")
    parser.add_argument("-j", dest="jobs")
    parser.add_argument("-d", dest="objects", action="append", default=[])
    parser.add_argument("lists", nargs="+")
    args = parser.parse_args(argv)

    b = args.bootstraps
    if not (b.isascii() and b.isdigit()):
        die(f"-b {b}: give a whole number of bootstraps, 0 or more")
    jobs = args.jobs
    if jobs is not None:
        if not (jobs.isascii() and jobs.isdigit() and int(jobs) >= 1):
            die(f"-j {jobs}: give a whole number of jobs, 1 or more")
        jobs = int(jobs)

    # all lists read and checked first, so a bad one stops the run before
    # hours of fitting, not after
    lists = []
    for path in args.lists:
        x, kernel_n, kernel_sum = read_list(path, args.objects, args.kernel)
        if not len(x):
            if kernel_n:
                die(f"{path}: only kernel code to fit; include it with -k",
                    shlex.join([sys.argv[0], "-k", *argv]))
            if args.objects:
                die(f"{path}: nothing above 0 in {', '.join(args.objects)}; "
                    "-d takes a name from the list's file column")
            die(f"{path}: no counts above 0; nothing to fit")
        lists.append((path, x, kernel_n, kernel_sum))
    for path, x, kernel_n, kernel_sum in lists:
        analyse(path, x, kernel_n, kernel_sum, args.objects, int(b), args.kernel, jobs)


if __name__ == "__main__":
    main()
