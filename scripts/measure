#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# measure -- build the programs, download their inputs, and record the
# workloads in workloads.txt
#
# Usage:
#   measure -n <nick> [-r <runs>] [-u] [-c <cycles>] [-m <dir>] all
#   measure -n <nick> [-r <runs>] [-u] [-c <cycles>] [-m <dir>]
#           <workload>...
#
#   all          build the programs, download their inputs (about
#                900 MB the first time), then run record all (time runs,
#                then a count) on every workload in workloads.txt, in
#                order; as root. Workloads with -p get time runs only.
#   <workload>   the same for only these workloads
#
#   -n <nick>    your machine's short name, e.g. t14; the same every time
#   -r, -u, -c and -m are record's: see scripts/record -h
#
# The build runs as the user who ran sudo; record runs from the repo's
# folder. A workload that fails does not stop the others; Ctrl-C stops
# them all. If any failed or did not run, the end prints the command
# that runs just those. Such a rerun records a workload again in full:
# its good runs from before stay, so it can end up with more runs than
# the others.
#
# Workloads may keep files in /tmp/inf2204.<user id> (RAM on most
# machines; the clone workloads do); measure empties it before and
# after each workload.

set -eu
# no globbing: workloads.txt's lines are split into words, and a word
# like *.c must reach record as written
set -f

NAME=measure
SCRIPTS=$(dirname "$(readlink -f "$0")")
REPO=$(dirname "$SCRIPTS")
WORKLOADS=$REPO/workloads.txt

# quote <word>: the word as the shell reads it back, in '' if needed
quote() {
	case "$1" in
	"" | *[!A-Za-z0-9_./:=,+%@-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
	*) printf '%s' "$1" ;;
	esac
}

die() {
	echo "$NAME: error: $1" >&2
	exit 1
}

die_cmd() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	if [ -n "${3:-}" ]; then
		echo "$3" >&2
		echo "" >&2
	fi
	exit 1
}

note() {
	echo "$NAME: $1" >&2
}

# usage [0]: prints the header's Usage block and exits; with 0 (for -h)
# to stdout, otherwise to stderr as an error
usage() {
	if [ "${1:-1}" = 0 ]; then
		usage_block
		exit 0
	fi
	usage_block >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

# workload_lines: workloads.txt without comments and blank lines
workload_lines() {
	sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$WORKLOADS"
}

# workload_line name: the words after the name on its line
workload_line() {
	workload_lines | awk -v w="$1" '$1 == w { $1 = ""; sub(/^ +/, ""); print; exit }'
}

# as_user command...: runs it as the user who ran sudo
as_user() {
	if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
		sudo -u "$SUDO_USER" -H -- "$@"
	else
		"$@"
	fi
}

# first word of a list, and the rest
first() {
	echo "${1%% *}"
}
rest() {
	case "$1" in
	*" "*) echo "${1#* }" ;;
	esac
}

[ $# -ge 1 ] || usage
for a in "$@"; do
	case "$a" in
	-h | --help) usage 0 ;;
	esac
done

NICK=
RUNS=
UNTUNED=
# set before the workloads run; emptied on exit
SCRATCH=
PERIOD=
MDIR=
while getopts n:r:uc:m: opt; do
	case "$opt" in
	n) NICK=$OPTARG ;;
	r) RUNS=$OPTARG ;;
	u) UNTUNED=-u ;;
	c) PERIOD=$OPTARG ;;
	m) MDIR=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage

# the same checks as record's, here so that a mistake shows before the
# build, not after it
case "$NICK" in
"") die "a system nickname is required, e.g. -n t14" ;;
*[!A-Za-z0-9_]*) die "nickname '$NICK' may only contain letters, digits and _" ;;
esac
case "$RUNS" in
*[!0-9]* | 0*) die "-r takes a positive number of runs, got '$RUNS'" ;;
esac
case "$PERIOD" in
*[!0-9]* | 0*) die "-c takes a positive number of cycles, got '$PERIOD'" ;;
esac
# measure starts record from the repo's folder (cd below), so a
# relative folder is made absolute here
case "$MDIR" in
"" | /*) ;;
*) MDIR=$PWD/$MDIR ;;
esac

[ -f "$WORKLOADS" ] || die "$WORKLOADS is missing"
known=
for w in $(workload_lines | awk '{ print $1 }'); do
	case "$w" in
	all | platforms) die "workloads.txt: '$w' cannot be a workload's name" ;;
	[!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) die "workloads.txt: workload '$w' may only contain letters, digits, _ . and -, and must start with a letter or digit" ;;
	esac
	case " $known " in
	*" $w "*) die "workloads.txt: workload $w is there twice" ;;
	esac
	[ -n "$(workload_line "$w")" ] || die "workloads.txt: workload $w has no command"
	known="${known:+$known }$w"
done
[ -n "$known" ] || die "workloads.txt lists no workloads"

if [ "$*" = all ]; then
	todo=$known
else
	todo=
	for w in "$@"; do
		case " $known " in
		*" $w "*) ;;
		*) die "no workload '$w' in workloads.txt (these are: $known)" ;;
		esac
		todo="${todo:+$todo }$w"
	done
fi

# this command without its workloads, to print with the ones left over
CMD="sudo $(quote "$0") -n $(quote "$NICK")${RUNS:+ -r $RUNS}${UNTUNED:+ -u}${PERIOD:+ -c $PERIOD}${MDIR:+ -m $(quote "$MDIR")}"

if [ "$(id -u)" != 0 ]; then
	die_cmd "must run as root (tuning and perf need it)" "$CMD $*"
fi
# also with -u: record time -u refuses a tuned system, and every
# workload's time runs would fail
if [ -f /run/tune.state ]; then
	die_cmd "the system is already tuned, by something other than this run" \
		"sudo $SCRIPTS/tune reset" \
		"or, if tune is running in another terminal, stop it with Ctrl-C."
fi

# make's output goes to a log, the user's to read; only its end is
# shown if it fails. The user's shell writes it: root may not write to
# another user's file in /tmp (fs.protected_regular).
LOG=$(as_user mktemp)
note "building the programs and downloading their inputs (make; minutes the first time)"
if ! as_user sh -c 'exec >"$3" 2>&1; make -C "$1" -j"$2" && make -C "$1" data' sh \
	"$REPO" "$(nproc)" "$LOG"; then
	tail -n 20 "$LOG" >&2
	die "make failed; all of its output is in $LOG"
fi
rm "$LOG"

failed=
left=$todo
# On any end: the workloads that failed or did not run, and the command
# that runs just those.
on_exit() {
	status=$?
	[ -z "${SCRATCH:-}" ] || rm -rf "$SCRATCH"
	again="$failed${failed:+${left:+ }}$left"
	[ -n "$again" ] || return 0
	if [ -n "$left" ]; then
		echo "$NAME: stopped; not done: $left" >&2
	fi
	if [ -n "$failed" ]; then
		echo "$NAME: failed: $failed (record's errors are above)" >&2
	fi
	echo "" >&2
	echo "run just these with:" >&2
	echo "" >&2
	echo "$CMD $again" >&2
	echo "" >&2
	[ "$status" != 0 ] || exit 1
}
trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 141' PIPE
trap 'exit 143' TERM

cd "$REPO"
SCRATCH=/tmp/inf2204.${SUDO_UID:-$(id -u)}
total=$(echo "$todo" | wc -w)
i=0
while [ -n "$left" ]; do
	w=$(first "$left")
	i=$((i + 1))
	note "workload $i of $total: $w"
	# word splitting intended: the line is a list of words
	set -- $(workload_line "$w")
	rm -rf "$SCRATCH"
	status=0
	"$SCRIPTS/record" all -n "$NICK" -w "$w" ${RUNS:+-r} ${RUNS:+"$RUNS"} $UNTUNED \
		${PERIOD:+-c} ${PERIOD:+"$PERIOD"} ${MDIR:+-m} ${MDIR:+"$MDIR"} "$@" || status=$?
	rm -rf "$SCRATCH"
	case "$status" in
	0) left=$(rest "$left") ;;
	# terminal closed, Ctrl-C, pipe closed, killed: stop the series
	129 | 130 | 141 | 143) exit "$status" ;;
	*)
		failed="${failed:+$failed }$w"
		left=$(rest "$left")
		;;
	esac
done
[ -n "$failed" ] || note "recorded every workload ($total)"
