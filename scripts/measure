#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# measure -- build the programs, download their inputs, and record the
# workloads in workloads.txt
#
# Usage:
#   measure -n <nick> [-r <runs>] [-u] [-c <cycles>] [-m <dir>]
#           [-j <counts>] [-s] all
#   measure -n <nick> [-r <runs>] [-u] [-c <cycles>] [-m <dir>]
#           [-j <counts>] [-s] <workload>...
#   measure -n <nick> [-m <dir>] [-j <counts>] [-s] count all
#   measure -n <nick> [-m <dir>] [-j <counts>] [-s] count <workload>...
#
#   all          build the programs, download their inputs (about
#                1.5 GB the first time), then record every workload in
#                workloads.txt: first the time runs of each, in order
#                (record all -t: a warm-up run, then the time runs, on
#                the tuned system), then one count of each, several at
#                a time, untuned (counts are exact; callgrind is slow);
#                the slow counts (marked -s in workloads.txt) start
#                only when all the others have ended; as root
#   <workload>   the same for only these workloads
#   count        only the counts, no time runs: e.g. the ones a
#                stopped run, or -s, left out
#
#   -n <nick>    your machine's short name, e.g. t14; the same every time
#   -s           leave out the slow counts (their time runs still run);
#                the end prints the command that counts them
#   -j <counts>  how many counts run at most at once (default 3, at most
#                the number of CPUs minus one); each takes about 1.5
#                CPUs and up to a few GB of memory, so another starts
#                only while 4 GB are free, and a minute after the last
#   -r, -u, -c and -m are record's: see scripts/record -h
#
# Counts must not take all the memory: a Raspberry Pi with 8 GB hung for
# five minutes and restarted, with two compiler counts on top of its
# other services. So measure stops the newest count whenever less than
# 1 GB is free (it fails, and measure says so). Where the kernel allows
# it, the counts also run in one systemd slice, inf2204counts.slice,
# capped at what was free when they began minus 1 GB, with no swap; the
# kernel then stops one of them at once. Raspberry Pi OS cannot cap
# (cgroup_disable=memory in cmdline.txt): there they run one at a time.
#
# The build runs as the user who ran sudo; record runs from the repo's
# folder. It also builds the programs given with -p in build/ (the
# compilers, for the compile workloads), only if one of the chosen
# workloads needs them: that takes hours on a Raspberry Pi.
#
# A workload that fails does not stop the others; Ctrl-C stops them all,
# and what has ended stays. If any failed or did not run, the end prints
# the commands that run just those: in full if their time runs are not
# done (the good runs from before stay, so a workload can end up with
# more runs than the others), else only their counts.
#
# The counts' output goes to a log per workload, under /tmp; the
# terminal gets one line when each starts and ends.
#
# Workloads may keep files in /tmp/inf2204.<user id> (RAM on most
# machines; the clone workloads do); measure empties it before and
# after each workload's time runs, and before and after the counts.

set -eu
# no globbing: workloads.txt's lines are split into words, and a word
# like *.c must reach record as written
set -f

NAME=measure
SCRIPTS=$(dirname "$(readlink -f "$0")")
REPO=$(dirname "$SCRIPTS")
WORKLOADS=$REPO/workloads.txt

# quote <word>: the word as the shell reads it back, in '' if needed
quote() {
	case "$1" in
	"" | *[!A-Za-z0-9_./:=,+%@-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
	*) printf '%s' "$1" ;;
	esac
}

die() {
	echo "$NAME: error: $1" >&2
	exit 1
}

die_cmd() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	if [ -n "${3:-}" ]; then
		echo "$3" >&2
		echo "" >&2
	fi
	exit 1
}

note() {
	echo "$NAME: $1" >&2
}

# usage [0]: prints the header's Usage block and exits; with 0 (for -h)
# to stdout, otherwise to stderr as an error
usage() {
	if [ "${1:-1}" = 0 ]; then
		usage_block
		exit 0
	fi
	usage_block >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

# workload_lines: workloads.txt without comments and blank lines
workload_lines() {
	sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$WORKLOADS"
}

# workload_line name: the words after the name on its line, for
# record: without measure's own -s
workload_line() {
	workload_lines | awk -v w="$1" '$1 == w {
		out = ""
		opts = 1
		for (i = 2; i <= NF; i++) {
			if (opts && $i == "-s") continue
			if (opts && ($i == "-p" || $i == "-c")) { out = out " " $i " " $(i + 1); i++; continue }
			if ($i !~ /^-/) opts = 0
			out = out " " $i
		}
		print substr(out, 2)
		exit
	}'
}

# is_slow name: prints "slow" if the workload's line has -s among its
# options (its count runs last; see the header)
is_slow() {
	workload_lines | awk -v w="$1" '$1 == w {
		for (i = 2; i <= NF; i++) {
			if ($i == "-s") { print "slow"; exit }
			if ($i == "-p" || $i == "-c") { i++; continue }
			if ($i !~ /^-/) exit
		}
		exit
	}'
}

# as_user command...: runs it as the user who ran sudo
as_user() {
	if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
		sudo -u "$SUDO_USER" -H -- "$@"
	else
		"$@"
	fi
}

# first word of a list, and the rest
first() {
	echo "${1%% *}"
}
rest() {
	case "$1" in
	*" "*) echo "${1#* }" ;;
	esac
}

# free_mb: the memory available for new programs, in MB
free_mb() {
	awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo
}

# stop_count pid: stops the count a count's subshell (pid) started:
# TERM to its child (sudo, which passes it on to record, or record),
# which stops its callgrind and cleans up. Not the subshell: it writes
# the count's status once record has ended. Not record's own children:
# record stops them, and a second TERM would cut its cleanup short.
stop_count() {
	for _c in $(pgrep -P "$1"); do
		kill -s TERM "$_c" 2>/dev/null || true
	done
}

# drop word list: the list without that word
drop() {
	_out=
	for _w in $2; do
		[ "$_w" = "$1" ] || _out="${_out:+$_out }$_w"
	done
	echo "$_out"
}

[ $# -ge 1 ] || usage
for a in "$@"; do
	case "$a" in
	-h | --help) usage 0 ;;
	esac
done

NICK=
RUNS=
UNTUNED=
# set before the workloads run; emptied on exit
SCRATCH=
PERIOD=
MDIR=
JOBS=
SKIP=
# the counts running: their subshells' pids, and their logs' folder
COUNTING=
LOGS=
while getopts n:r:uc:m:j:s opt; do
	case "$opt" in
	n) NICK=$OPTARG ;;
	r) RUNS=$OPTARG ;;
	u) UNTUNED=-u ;;
	c) PERIOD=$OPTARG ;;
	m) MDIR=$OPTARG ;;
	j) JOBS=$OPTARG ;;
	s) SKIP=-s ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
MODE=all
if [ "${1:-}" = count ]; then
	MODE=count
	shift
	[ -z "$RUNS$UNTUNED$PERIOD" ] || die "count runs no time runs, so it takes no -r, -u or -c"
fi
[ $# -ge 1 ] || usage

# the same checks as record's, here so that a mistake shows before the
# build, not after it
case "$NICK" in
"") die "a system nickname is required, e.g. -n t14" ;;
*[!A-Za-z0-9_]*) die "nickname '$NICK' may only contain letters, digits and _" ;;
esac
case "$RUNS" in
*[!0-9]* | 0*) die "-r takes a positive number of runs, got '$RUNS'" ;;
esac
case "$PERIOD" in
*[!0-9]* | 0*) die "-c takes a positive number of cycles, got '$PERIOD'" ;;
esac
case "$JOBS" in
*[!0-9]* | 0*) die "-j takes a positive number of counts, got '$JOBS'" ;;
"")
	JOBS=$(($(nproc) - 1))
	[ "$JOBS" -le 3 ] || JOBS=3
	[ "$JOBS" -ge 1 ] || JOBS=1
	;;
esac
# measure starts record from the repo's folder (cd below), so a
# relative folder is made absolute here
case "$MDIR" in
"" | /*) ;;
*) MDIR=$PWD/$MDIR ;;
esac

[ -f "$WORKLOADS" ] || die "$WORKLOADS is missing"
known=
for w in $(workload_lines | awk '{ print $1 }'); do
	case "$w" in
	all | count | platforms) die "workloads.txt: '$w' cannot be a workload's name" ;;
	[!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) die "workloads.txt: workload '$w' may only contain letters, digits, _ . and -, and must start with a letter or digit" ;;
	esac
	case " $known " in
	*" $w "*) die "workloads.txt: workload $w is there twice" ;;
	esac
	[ -n "$(workload_line "$w")" ] || die "workloads.txt: workload $w has no command"
	known="${known:+$known }$w"
done
[ -n "$known" ] || die "workloads.txt lists no workloads"

if [ "$*" = all ]; then
	todo=$known
else
	todo=
	for w in "$@"; do
		case " $known " in
		*" $w "*) ;;
		*) die "no workload '$w' in workloads.txt (these are: $known)" ;;
		esac
		case " $todo " in
		*" $w "*) ;;
		*) todo="${todo:+$todo }$w" ;;
		esac
	done
fi

# commands: this command without its workloads, to print with the ones
# left over; and the ones that only count
commands() {
	CMD="sudo $(quote "$0") -n $(quote "$NICK")${RUNS:+ -r $RUNS}${UNTUNED:+ -u}${PERIOD:+ -c $PERIOD}${MDIR:+ -m $(quote "$MDIR")} -j $JOBS"
	CMD_COUNT="sudo $(quote "$0") -n $(quote "$NICK")${MDIR:+ -m $(quote "$MDIR")} -j $JOBS"
	CMD_COUNT1="sudo $(quote "$0") -n $(quote "$NICK")${MDIR:+ -m $(quote "$MDIR")} -j 1"
}
commands

if [ "$(id -u)" != 0 ]; then
	if [ "$MODE" = count ]; then
		die_cmd "must run as root (the counts' memory cap needs it)" "$CMD_COUNT${SKIP:+ -s} count $*"
	fi
	die_cmd "must run as root (tuning and perf need it)" "$CMD${SKIP:+ -s} $*"
fi
# also with -u: record time -u refuses a tuned system, and every
# workload's time runs would fail
if [ -f /run/tune.state ]; then
	die_cmd "the system is already tuned, by something other than this run" \
		"sudo $SCRIPTS/tune reset" \
		"or, if tune is running in another terminal, stop it with Ctrl-C."
fi

# make's output goes to a log, the user's to read; only its end is
# shown if it fails. The user's shell writes it: root may not write to
# another user's file in /tmp (fs.protected_regular).
# the programs the chosen workloads give with -p, if make builds them
# (build/...), e.g. build/cc1; make data does not build them
progs=
for w in $todo; do
	for p in $(workload_line "$w" | awk '{
		for (i = 1; i <= NF; ) {
			if ($i == "-p") { print $(i + 1); exit }
			else if ($i == "-c") i += 2
			else if ($i ~ /^-/) i++
			else exit
		} }'); do
		case "$p" in
		build/*)
			case " $progs " in
			*" $p "*) ;;
			*) progs="${progs:+$progs }$p" ;;
			esac
			;;
		esac
	done
done
what="the programs"
# word splitting intended: progs is a list of files
if [ -n "$progs" ] && ! as_user make -C "$REPO" -q $progs >/dev/null 2>&1; then
	what="the programs, also $progs (can take hours on a Raspberry Pi),"
fi

LOG=$(as_user mktemp)
note "building $what and downloading their inputs (make; minutes the first time)"
# word splitting intended: progs is a list of files
# One program at a time: the compilers' builds each use several CPUs and
# a lot of memory.
if ! as_user sh -c 'exec >"$3" 2>&1; repo=$1 jobs=$2; shift 3
	make -C "$repo" -j"$jobs" all || exit
	for p; do make -C "$repo" -j"$jobs" "$p" || exit; done
	make -C "$repo" data || exit
	# the configure steps of the compile workloads (curl, Neovim), with
	# our compilers, so after them and after the downloads
	for p; do
		case $p in
		build/cc1) make -C "$repo" -j"$jobs" compile-gcc || exit ;;
		build/clang) make -C "$repo" -j"$jobs" compile-clang || exit ;;
		esac
	done' sh \
	"$REPO" "$(nproc)" "$LOG" $progs; then
	tail -n 20 "$LOG" >&2
	die "make failed; all of its output is in $LOG"
fi
rm "$LOG"

# Workloads whose time runs are still to do, and those whose count is
# (their time runs are done, or count was asked for); those that failed
# in either; the slow counts left out by -s.
if [ "$MODE" = count ]; then
	left_time=
	left_count=$todo
else
	left_time=$todo
	left_count=
fi
failed_time=
failed_count=
skipped=
# On any end: the workloads that failed or did not run, and the commands
# that run just those: in full if their time runs are not done, else
# only their counts.
on_exit() {
	status=$?
	# nothing may cut this short: not a second Ctrl-C, not a failing rm
	trap '' HUP INT TERM
	set +e
	# the counts still running; their subshells end when record has
	for pid in $COUNTING; do
		stop_count "$pid"
	done
	for pid in $COUNTING; do
		wait "$pid" 2>/dev/null
	done
	[ -z "$LOGS" ] || note "the counts' logs are in $LOGS"
	[ -z "${SCRATCH:-}" ] || rm -rf "$SCRATCH"
	# a count that ended just before the stop, not yet seen by the loop
	if [ -n "$LOGS" ]; then
		for w in $left_count; do
			[ "$(cat "$LOGS/$w.status" 2>/dev/null)" != 0 ] || left_count=$(drop "$w" "$left_count")
		done
	fi
	unfinished=$left_count
	for w in $skipped; do
		unfinished=$(drop "$w" "$unfinished")
	done
	full="$failed_time${failed_time:+${left_time:+ }}$left_time"
	counts="$failed_count${failed_count:+${unfinished:+ }}$unfinished"
	[ -n "$full$counts$skipped" ] || return 0
	if [ -n "$left_time" ]; then
		echo "$NAME: stopped; not measured: $left_time" >&2
	fi
	if [ -n "$unfinished" ]; then
		echo "$NAME: stopped; not counted: $unfinished" >&2
	fi
	if [ -n "$failed_time$failed_count" ]; then
		echo "$NAME: failed: $failed_time${failed_time:+${failed_count:+ }}$failed_count (record's errors are above)" >&2
	fi
	if [ -n "$full$counts" ]; then
		echo "" >&2
		echo "run just these with:" >&2
		echo "" >&2
		[ -z "$full" ] || echo "$CMD${SKIP:+ -s} $full" >&2
		[ -z "$counts" ] || echo "$CMD_COUNT${SKIP:+ -s} count $counts" >&2
		echo "" >&2
	fi
	if [ -n "$skipped" ]; then
		echo "" >&2
		echo "$NAME: the slow counts were left out (-s); count them later with:" >&2
		echo "" >&2
		echo "$CMD_COUNT count $skipped" >&2
		echo "" >&2
	fi
	# only slow counts left out, as asked: a normal end
	[ -n "$full$counts" ] || return 0
	[ "$status" != 0 ] || exit 1
}
trap on_exit EXIT
# A signal only notes itself; the loops stop at the next point where
# their bookkeeping is complete (a workload's time runs just ended, a
# count just started), so the commands printed at the end are right.
STOP=
trap 'STOP=129' HUP
trap 'STOP=130' INT
trap 'STOP=141' PIPE
trap 'STOP=143' TERM

cd "$REPO"
SCRATCH=/tmp/inf2204.${SUDO_UID:-$(id -u)}
total=$(echo "$todo" | wc -w)

# the time runs, one workload after the other
i=0
for w in $left_time; do
	i=$((i + 1))
	note "time runs, workload $i of $total: $w"
	# word splitting intended: the line is a list of words
	set -- $(workload_line "$w")
	rm -rf "$SCRATCH"
	status=0
	"$SCRIPTS/record" all -t -n "$NICK" -w "$w" ${RUNS:+-r} ${RUNS:+"$RUNS"} $UNTUNED \
		${PERIOD:+-c} ${PERIOD:+"$PERIOD"} ${MDIR:+-m} ${MDIR:+"$MDIR"} "$@" || status=$?
	rm -rf "$SCRATCH"
	case "$status" in
	0)
		left_count="${left_count:+$left_count }$w"
		;;
	# terminal closed, Ctrl-C, pipe closed, killed: stop the series
	129 | 130 | 141 | 143) exit "$status" ;;
	*)
		failed_time="${failed_time:+$failed_time }$w"
		;;
	esac
	left_time=$(drop "$w" "$left_time")
	[ -z "$STOP" ] || exit "$STOP"
done

# count w word...: one count of workload w, its line's words without
# -c <cycles> (sampling is for time runs), as the user who ran sudo
count() {
	w=$1
	shift
	n=$#
	options=1
	while [ "$n" -gt 0 ]; do
		a=$1
		shift
		n=$((n - 1))
		if [ "$options" = 1 ]; then
			case "$a" in
			-c)
				shift
				n=$((n - 1))
				continue
				;;
			-p)
				# and its program
				set -- "$@" "$a" "$1"
				shift
				n=$((n - 1))
				continue
				;;
			-*) ;;
			*) options=0 ;;
			esac
		fi
		set -- "$@" "$a"
	done
	if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
		set -- sudo -u "$SUDO_USER" -- "$SCRIPTS/record" count -n "$NICK" -w "$w" \
			${MDIR:+-m} ${MDIR:+"$MDIR"} "$@"
	else
		set -- "$SCRIPTS/record" count -n "$NICK" -w "$w" ${MDIR:+-m} ${MDIR:+"$MDIR"} "$@"
	fi
	# in the capped slice (see the header)
	systemd-run --scope --quiet --collect --slice=inf2204counts -- "$@"
}

# ooms: how many times the kernel has stopped a program in the counts'
# slice for lack of memory
ooms() {
	awk '$1 == "oom_kill" { print $2; exit }' /sys/fs/cgroup/inf2204counts.slice/memory.events 2>/dev/null || echo 0
}

# then the counts, up to JOBS at once: the slow ones only when all the
# others have ended, or not at all with -s
fast=
slow=
for w in $left_count; do
	if [ -n "$(is_slow "$w")" ]; then
		slow="${slow:+$slow }$w"
	else
		fast="${fast:+$fast }$w"
	fi
done
if [ -n "$SKIP" ]; then
	skipped=$slow
	slow=
fi
pending="$fast${fast:+${slow:+ }}$slow"
if [ -n "$pending" ]; then
	LOGS=$(mktemp -d /tmp/measure-counts.XXXXXX)
	chmod 755 "$LOGS"
	rm -rf "$SCRATCH"
	cap=$(($(free_mb) - 1024))
	[ "$cap" -ge 1024 ] ||
		die "only $(free_mb) MB of memory free; the counts need at least 2 GB free to start"
	# Raspberry Pi OS boots without memory control (cgroup_disable=memory
	# in cmdline.txt); systemd then ignores the cap without a word
	if grep -qw memory /sys/fs/cgroup/cgroup.controllers 2>/dev/null; then
		systemctl set-property --runtime inf2204counts.slice MemoryMax="${cap}M" MemorySwapMax=0 ||
			die "could not cap the counts' memory (systemctl set-property inf2204counts.slice)"
		note "counts: $(echo "$pending" | wc -w)${slow:+ ($(echo "$slow" | wc -w) slow, last)}, up to $JOBS at a time, untuned, in at most $cap MB of memory; logs in $LOGS"
	else
		JOBS=1
		commands
		note "warning: this kernel cannot cap memory (memory is not in /sys/fs/cgroup/cgroup.controllers; on a Raspberry Pi, cgroup_disable=memory in cmdline.txt), so the counts run one at a time"
		note "counts: $(echo "$pending" | wc -w)${slow:+ ($(echo "$slow" | wc -w) slow, last)}, one at a time, untuned; logs in $LOGS"
	fi
fi
running=
stopped=
waited=
started=0
while [ -n "$pending" ] || [ -n "$running" ]; do
	[ -z "$STOP" ] || exit "$STOP"
	now=$(date +%s)
	# A count starts with 2 GB free, beside others with 4 GB free, and a
	# minute after the one before: free memory says little about a count
	# that has just started. A slow one starts only when no other count
	# is left or running.
	if [ -n "$pending" ] && [ "$(echo $running | wc -w)" -lt "$JOBS" ] &&
		{ [ -z "$running" ] || [ $((now - started)) -ge 60 ]; } &&
		{ [ "$(free_mb)" -ge 4096 ] || { [ -z "$running" ] && [ "$(free_mb)" -ge 2048 ]; }; }; then
		w=$(first "$pending")
		case " $slow " in
		*" $w "*) [ -z "$fast" ] && go=1 || go= ;;
		*) go=1 ;;
		esac
		if [ -n "$go" ]; then
			pending=$(rest "$pending")
			# word splitting intended: the line is a list of words
			set -- $(workload_line "$w")
			{
				rc=0
				before=$(ooms)
				count "$w" "$@" >"$LOGS/$w.log" 2>&1 || rc=$?
				# stopped for memory: here or in a count running beside it,
				# whichever the kernel picked; this one failed, so maybe here
				[ "$rc" = 0 ] || [ "$(ooms)" = "$before" ] || : >"$LOGS/$w.memory"
				echo "$rc" >"$LOGS/$w.status"
			} &
			COUNTING="${COUNTING:+$COUNTING }$!"
			running="${running:+$running }$w:$!"
			started=$now
			waited=
			note "count of $w: started"
			[ -z "$STOP" ] || exit "$STOP"
		fi
	fi
	if [ -n "$pending" ] && [ -z "$running" ]; then
		# nothing runs that could free memory: something else holds it
		if [ -z "$waited" ]; then
			waited=$now
			note "waiting for 2 GB of memory to be free before the next count"
		elif [ $((now - waited)) -ge 600 ]; then
			note "less than 2 GB of memory was free for 10 minutes; stopping"
			exit 1
		fi
	fi
	sleep 2
	still=
	for job in $running; do
		w=${job%:*}
		pid=${job##*:}
		if [ ! -f "$LOGS/$w.status" ]; then
			if kill -0 "$pid" 2>/dev/null; then
				still="${still:+$still }$job"
				continue
			fi
			# its subshell was killed before it could write the status
			echo "gone" >"$LOGS/$w.status"
		fi
		wait "$pid" 2>/dev/null || true
		COUNTING=$(drop "$pid" "$COUNTING")
		if [ "$(cat "$LOGS/$w.status")" = 0 ]; then
			note "count of $w: $(tail -n 1 "$LOGS/$w.log" | sed 's/^record count: //')"
		else
			note "count of $w: failed:"
			tail -n 5 "$LOGS/$w.log" | sed 's/^/    /' >&2
			if [ -e "$LOGS/$w.memory" ]; then
				note "memory ran out while it ran (the kernel or measure stopped a count); rerun it alone:"
				echo "" >&2
				echo "$CMD_COUNT1 count $w" >&2
				echo "" >&2
			fi
			failed_count="${failed_count:+$failed_count }$w"
		fi
		left_count=$(drop "$w" "$left_count")
		fast=$(drop "$w" "$fast")
	done
	running=$still
	# Below 1 GB free, the newest count not yet stopped is stopped: the
	# machine must not run out (see the header).
	if [ -n "$running" ] && [ "$(free_mb)" -lt 1024 ]; then
		victim=
		for job in $running; do
			case " $stopped " in
			*" ${job%:*} "*) ;;
			*) victim=$job ;;
			esac
		done
		if [ -n "$victim" ]; then
			w=${victim%:*}
			stopped="$stopped $w"
			note "count of $w: stopping it, less than 1 GB of memory is left"
			: >"$LOGS/$w.memory"
			stop_count "${victim##*:}"
		fi
	fi
done
rm -rf "$SCRATCH"
if [ -n "$LOGS" ] && [ -z "$failed_count" ]; then
	rm -rf "$LOGS"
	LOGS=
fi
[ -n "$failed_time$failed_count$skipped$pending" ] || note "recorded every workload ($total)"
