#!/usr/bin/env python3
# Responsible: Tuva Marie Eaton Johansen
# This script was generated by Claude Sonnet 5.5

"""Average repeated runs of profile CSVs under measurements/*/time/.

For every  <MEASUREMENTS_DIR>/<X>/time/  directory, files named

    <prefix>.run<N>.<kind>.csv        e.g. gospi-1.run1.function-samples.csv

are grouped by (prefix, kind). Each group (all runs of the same thing) is
merged into one file in the same directory:

    <prefix>.<kind>.avg.csv           e.g. gospi-1.function-samples.avg.csv

Key columns = every column except 'rank' and 'count' (they differ per kind).
Output columns: rank,avg_count,total_count,appears_in,<key columns...>
  avg_count   = total_count / appears_in
  total_count = sum of count over all runs
  appears_in  = number of distinct run files containing the key
Rows are ranked by avg_count (descending); ties broken by total_count.
"""
import csv
import glob
import os
import re
from collections import defaultdict

# ---------------- CONFIG ----------------
MEASUREMENTS_DIR = "../measurements"
TIME_SUBDIR = "time"
# ----------------------------------------

NAME_RE = re.compile(r"^(?P<prefix>[^.]+)\.run(?P<run>\d+)\.(?P<kind>[^.]+)\.csv$")
DROP = {"rank", "count"}


def group_files(time_dir):
    """Return {(prefix, kind): [run file paths]} for one time directory."""
    groups = defaultdict(list)
    for path in sorted(glob.glob(os.path.join(time_dir, "*.csv"))):
        m = NAME_RE.match(os.path.basename(path))
        if m:  # also skips our own *.avg.csv outputs (they have no runN part)
            groups[(m["prefix"], m["kind"])].append(path)
    return groups


def merge(paths, output):
    total = defaultdict(int)
    seen_in = defaultdict(set)
    key_cols = None

    for p in paths:
        with open(p, newline="") as f:
            reader = csv.DictReader(f)
            cols = [c for c in reader.fieldnames if c not in DROP]
            if key_cols is None:
                key_cols = cols
            elif cols != key_cols:
                raise SystemExit(f"Column mismatch in {p}: {cols} vs {key_cols}")
            for r in reader:
                key = tuple(r[c] for c in key_cols)
                total[key] += int(r["count"])
                seen_in[key].add(p)

    rows = []
    for key, s in total.items():
        n = len(seen_in[key])
        rows.append((s / n, s, n, key))
    rows.sort(key=lambda r: (-r[0], -r[1], r[3]))  # avg desc, then total desc, then key

    with open(output, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["rank", "avg_count", "total_count", "appears_in", *key_cols])
        for rank, (avg, s, n, key) in enumerate(rows, 1):
            w.writerow([rank, round(avg, 2), s, n, *key])

    print(f"{len(paths)} runs -> {len(rows):>5} keys -> {output}")


def main():
    time_dirs = sorted(glob.glob(os.path.join(MEASUREMENTS_DIR, "*", TIME_SUBDIR)))
    time_dirs = [d for d in time_dirs if os.path.isdir(d)]
    if not time_dirs:
        raise SystemExit(f"No {MEASUREMENTS_DIR}/*/{TIME_SUBDIR} directories found")

    for d in time_dirs:
        for (prefix, kind), paths in sorted(group_files(d).items()):
            merge(paths, os.path.join(d, f"{prefix}.{kind}.avg.csv"))


if __name__ == "__main__":
    main()