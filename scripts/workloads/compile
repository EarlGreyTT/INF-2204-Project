#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# compile -- one run of the compile workloads: our gcc (build/cc1) or
# our clang (build/clang) compiles one program from scratch, in RAM
#
# Usage:
#   compile <compiler> <program>
#   compile --prepare <compiler> <program>
#
#   <compiler>   gcc or clang (make gcc, make clang)
#   <program>    git, lua, sqlite, curl or neovim: the source code make
#                data keeps in build/
#   --prepare    for curl and neovim: run their configure step (cmake
#                for Neovim) and keep the result in
#                build/compile/<compiler>-<program>.tar (make
#                compile-gcc and make compile-clang do this)
#
# Run it through record, which keeps only the processes of the compiler:
#   sudo scripts/record time -n t14 -w gcc-lua -p build/cc1 scripts/workloads/compile gcc lua
#
# Each run unpacks the source code anew into
# /tmp/inf2204.<user id>/compile/<compiler>-<program>/ (RAM on most
# machines), builds it with make -j1 (one file at a time, so one process
# of the compiler at a time) and removes it. measure empties
# /tmp/inf2204.<user id>/ around the workloads; by hand, remove it with
# rm -rf.
#
# curl and Neovim have a configure step (Neovim's is cmake), which runs
# the compiler many times on test programs; it is no part of what we
# measure. --prepare runs it once, in the folder the runs build in
# (configure writes that absolute path into the Makefiles), and keeps
# the configured tree with its files' times; a run unpacks it there, and
# make does not configure again. Both use the same compiler and flags,
# from this script. The folder has the user's id in it: prepare as the
# user who runs measure. A run stops if the folder, the compiler, the
# flags or the version of gcc or cmake differ from the prepare's (after
# a system update, say): make cannot see those.
#
# The flags are each program's own, plus ours: the hardening some
# distributions' compilers add by themselves off, and the run folder
# left out of the debug information, as in the Makefile. gcc here is the
# system's gcc command, a driver that starts build/cc1 for each file
# (and the system's assembler and linker, which are not measured); the
# options it gives cc1 are its own and may differ between
# distributions: the ones we know of are set back to gcc's defaults.
# clang is ours alone (--no-default-config: no settings files).

set -eu
# the PATH record gives the runs, also for --prepare: configure and cmake
# keep the tools they find by their full paths
export PATH=/usr/bin:/bin

NAME=compile
REPO=$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")
BUILD=$REPO/build

die() {
	echo "$NAME: error: $1" >&2
	exit 1
}

die_cmd() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

# makefile_var name: the value of name in the Makefile, e.g. GIT_VERSION
makefile_var() {
	sed -n "s/^$1 = //p" "$REPO/Makefile"
}

# what a prepared tree was made with, in .prepared-for; a run checks it.
# The system's gcc, also for clang: clang links with gcc's start files
# and libraries. Neither command starts a compiler.
prepared_for() {
	echo "folder: $DIR"
	echo "compiler: $CC"
	echo "flags: $FLAGS"
	echo "gcc: $(gcc -dumpfullversion 2>/dev/null || echo none)"
	[ "$1" != neovim ] || echo "cmake: $(cmake --version 2>/dev/null | head -n 1)"
}

PREPARE=
case "${1:-}" in
-h | --help)
	usage_block
	exit 0
	;;
--prepare)
	PREPARE=1
	shift
	;;
esac
[ $# = 2 ] || {
	usage_block >&2
	exit 1
}

DIR=/tmp/inf2204.$(id -u)/compile/$1-$2
FLAGS="-fno-stack-protector -fno-stack-clash-protection -fcf-protection=none -U_FORTIFY_SOURCE -ffile-prefix-map=$DIR=."
case "$1" in
gcc)
	[ -x "$BUILD/cc1" ] || die_cmd "$BUILD/cc1 is missing" "make -C $REPO gcc"
	inc=$BUILD/gcc-build/gcc/include
	[ -d "$inc" ] || die_cmd "$inc is missing (gcc's own headers; make gcc keeps them)" "make -C $REPO gcc"
	# -B: cc1 from build/; -isystem: the headers of our gcc, not those
	# of the system's
	CC="gcc -B$BUILD/ -isystem $inc -fPIE"
	# gcc's defaults, which Ubuntu's gcc changes. An older driver (gcc
	# 14 on Debian) refuses the options it does not know; it does not add
	# them either, so they are left out there. -### only checks them:
	# no cc1 starts outside the build.
	for f in -Wno-format-security -fzero-init-padding-bits=standard -Wbidi-chars=unpaired; do
		gcc -### -x c -c -o /dev/null "$f" /dev/null >/dev/null 2>&1 && FLAGS="$FLAGS $f"
	done
	;;
clang)
	[ -x "$BUILD/clang" ] || die_cmd "$BUILD/clang is missing" "make -C $REPO clang"
	# clang's own headers, in the build folder of LLVM (the one folder
	# named after LLVM's major version)
	res=$BUILD/llvm-build/lib/clang/$(makefile_var LLVM_VERSION | cut -d. -f1)
	[ -d "$res/include" ] || die_cmd "$res/include is missing (clang's own headers; make clang keeps them)" "make -C $REPO clang"
	CC="$BUILD/clang --no-default-config -resource-dir $res"
	;;
*) die "no compiler '$1': gcc or clang" ;;
esac

case "$2" in
git) src=$BUILD/git-$(makefile_var GIT_VERSION).tar.gz ;;
lua) src=$BUILD/lua-$(makefile_var LUA_VERSION).tar.gz ;;
sqlite) src=$BUILD/compile/sqlite ;;
curl) src=$BUILD/curl-$(makefile_var CURL_VERSION).tar.xz ;;
neovim) src=$BUILD/tars/neovim.tar ;;
*) die "no program '$2': git, lua, sqlite, curl or neovim" ;;
esac
[ -e "$src" ] || die_cmd "$src is missing" "make -C $REPO data"
case "$2" in
curl | neovim) configured=$BUILD/compile/$1-$2.tar ;;
*) configured= ;;
esac
if [ -n "$PREPARE" ] && [ -z "$configured" ]; then
	die "$2 has no configure step to prepare"
fi
if [ -z "$PREPARE" ] && [ -n "$configured" ]; then
	[ -f "$configured" ] || die_cmd "$configured is missing" "make -C $REPO compile-$1"
fi

# /tmp is everyone's: the folder must be this user's own, or another
# user could change the sources between unpacking and building
TMP=/tmp/inf2204.$(id -u)
mkdir -m 700 -p "$TMP"
[ -O "$TMP" ] && [ ! -L "$TMP" ] || die "$TMP is not your own folder; remove it, as its owner"
rm -rf "$DIR"
# a stopped or failed build leaves nothing in /tmp (RAM on most
# machines), a stopped prepare no half-written tar
if [ -n "$PREPARE" ]; then
	trap 'cd / && rm -rf "$DIR" "$configured.part"' EXIT
else
	trap 'cd / && rm -rf "$DIR"' EXIT
fi
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -p "$DIR"
cd "$DIR"

if [ -n "$PREPARE" ]; then
	case "$2" in
	curl)
		tar -xJf "$src" --strip-components=1
		# curl's own CFLAGS (-O2) and ours; nothing optional: no TLS, no
		# compression or other libraries, no manual
		./configure --quiet CC="$CC" CFLAGS="-O2 $FLAGS" --disable-shared \
			--without-ssl --without-zlib --without-brotli --without-zstd \
			--without-libpsl --without-libidn2 --without-nghttp2 --without-nghttp3 \
			--without-ngtcp2 --without-libssh2 --without-libssh --without-libgsasl \
			--without-ca-bundle --without-ca-path --disable-ldap --disable-ldaps \
			--disable-manual --disable-docs >/dev/null
		;;
	neovim)
		tar -xf "$src"
		# Neovim's release build type (-O2 -g) and ours; its libraries
		# from make data. CC with its options: cmake keeps the options.
		# CACHE_PRG=OFF: Neovim would build through ccache or sccache
		# wherever one is installed, and a cached file runs no compiler.
		CC="$CC" CFLAGS="$FLAGS" cmake -S . -B build -G Ninja -Wno-dev \
			-DCMAKE_BUILD_TYPE=RelWithDebInfo -DDEPS_PREFIX="$BUILD/neovim-deps/usr" \
			-DCACHE_PRG=OFF >/dev/null
		;;
	esac
	prepared_for "$2" >.prepared-for
	mkdir -p "$BUILD/compile"
	tar -cf "$configured.part" .
	mv "$configured.part" "$configured"
	cd /
	rm -rf "$DIR"
	exit 0
fi

if [ -n "$configured" ]; then
	tar -xf "$configured"
	prepared_for "$2" | diff .prepared-for - >&2 ||
		die_cmd "$configured was made with other settings (above: < then, > now; another user, or a system update?)" \
			"rm $configured; make -C $REPO compile-$1"
fi

case "$2" in
git)
	[ -f "$BUILD/zlib/lib/libz.a" ] || die_cmd "$BUILD/zlib is missing" "make -C $REPO git"
	tar -xzf "$src" --strip-components=1
	# git's own CFLAGS (-g -O2 -Wall), and the options of build/git (see
	# the Makefile): only the git program, nothing optional, our zlib
	make -j1 git CC="$CC" CFLAGS="-g -O2 -Wall $FLAGS" prefix=/nonexistent \
		ZLIB_PATH="$BUILD/zlib" CC_LD_DYNPATH=-L \
		NO_OPENSSL=1 NO_CURL=1 NO_EXPAT=1 NO_GETTEXT=1 NO_PERL=1 NO_PYTHON=1 \
		NO_TCLTK=1 NO_RUST=1 NO_PTHREADS=1
	;;
lua)
	tar -xzf "$src" --strip-components=1
	# Lua's own CC line has -std=gnu99; its CFLAGS take ours in MYCFLAGS
	make -j1 -C src linux CC="$CC -std=gnu99" MYCFLAGS="$FLAGS"
	;;
sqlite)
	cp "$src"/* .
	# the command SQLite's build runs for the sqlite3 program, with its
	# default options, minus what configure found on the machine: no
	# zlib, no sqlite_cfg.h
	$CC -DNDEBUG -fPIC -O2 -g $FLAGS -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_PERCENTILE \
		-DSQLITE_THREADSAFE=1 -DSQLITE_DQS=0 -DSQLITE_ENABLE_BYTECODE_VTAB \
		-DSQLITE_ENABLE_DBPAGE_VTAB -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_ENABLE_EXPLAIN_COMMENTS \
		-DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_OFFSET_SQL_FUNC -DSQLITE_ENABLE_RTREE \
		-DSQLITE_ENABLE_STMTVTAB -DSQLITE_ENABLE_UNKNOWN_SQL_FUNCTION -DSQLITE_STRICT_SUBTYPE=1 \
		-o sqlite3 shell.c sqlite3.c -lm
	;;
curl)
	# configured by --prepare with our compiler and flags: the library
	# and the curl program. Not all of make: without shared libraries,
	# curl's configure also builds the library a second time for its
	# unit tests (libcurlu), and has no option to leave that out.
	make -j1 -C lib libcurl.la
	make -j1 -C src curl
	;;
neovim)
	# configured by --prepare: the nvim program only, not its runtime
	# files (help tags and the like, which the new nvim makes)
	ninja -C build -j1 nvim_bin
	;;
esac
cd /
rm -rf "$DIR"
