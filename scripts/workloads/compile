#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# compile -- one run of the compile workloads: our gcc (build/cc1) or
# our clang (build/clang) compiles one program from scratch, in RAM
#
# Usage:
#   compile <compiler> <program>
#
#   <compiler>   gcc or clang (make gcc, make clang)
#   <program>    git, lua or sqlite: the source code make data keeps in
#                build/
#
# Run it through record, which keeps only the processes of the compiler:
#   sudo scripts/record time -n t14 -w gcc-lua -p build/cc1 scripts/workloads/compile gcc lua
#
# Each run unpacks the source code anew into
# /tmp/inf2204.<user id>/compile/<compiler>-<program>/ (RAM on most
# machines), builds it with make -j1 (one file at a time, so one process
# of the compiler at a time) and removes it. measure empties
# /tmp/inf2204.<user id>/ around the workloads; by hand, remove it with
# rm -rf.
#
# The flags are each program's own, plus ours: the hardening some
# distributions' compilers add by themselves off, and the run folder
# left out of the debug information, as in the Makefile. gcc here is the
# system's gcc command, a driver that starts build/cc1 for each file
# (and the system's assembler and linker, which are not measured); the
# options it gives cc1 are its own and may differ between
# distributions: the ones we know of are set back to gcc's defaults.
# clang is ours alone (--no-default-config: no settings files).

set -eu

NAME=compile
REPO=$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")
BUILD=$REPO/build

die() {
	echo "$NAME: error: $1" >&2
	exit 1
}

die_cmd() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

# makefile_var name: the value of name in the Makefile, e.g. GIT_VERSION
makefile_var() {
	sed -n "s/^$1 = //p" "$REPO/Makefile"
}

case "${1:-}" in
-h | --help)
	usage_block
	exit 0
	;;
esac
[ $# = 2 ] || {
	usage_block >&2
	exit 1
}

DIR=/tmp/inf2204.$(id -u)/compile/$1-$2
FLAGS="-fno-stack-protector -fno-stack-clash-protection -fcf-protection=none -U_FORTIFY_SOURCE -ffile-prefix-map=$DIR=."
case "$1" in
gcc)
	[ -x "$BUILD/cc1" ] || die_cmd "$BUILD/cc1 is missing" "make -C $REPO gcc"
	inc=$BUILD/gcc-build/gcc/include
	[ -d "$inc" ] || die_cmd "$inc is missing (gcc's own headers; make gcc keeps them)" "make -C $REPO gcc"
	# -B: cc1 from build/; -isystem: the headers of our gcc, not those
	# of the system's
	CC="gcc -B$BUILD/ -isystem $inc -fPIE"
	# gcc's defaults, which Ubuntu's gcc changes. An older driver (gcc
	# 14 on Debian) refuses the options it does not know; it does not add
	# them either, so they are left out there. -### only checks them:
	# no cc1 starts outside the build.
	for f in -Wno-format-security -fzero-init-padding-bits=standard -Wbidi-chars=unpaired; do
		gcc -### -x c -c -o /dev/null "$f" /dev/null >/dev/null 2>&1 && FLAGS="$FLAGS $f"
	done
	;;
clang)
	[ -x "$BUILD/clang" ] || die_cmd "$BUILD/clang is missing" "make -C $REPO clang"
	# clang's own headers, in the build folder of LLVM (the one folder
	# named after LLVM's major version)
	res=$BUILD/llvm-build/lib/clang/$(makefile_var LLVM_VERSION | cut -d. -f1)
	[ -d "$res/include" ] || die_cmd "$res/include is missing (clang's own headers; make clang keeps them)" "make -C $REPO clang"
	CC="$BUILD/clang --no-default-config -resource-dir $res"
	;;
*) die "no compiler '$1': gcc or clang" ;;
esac

case "$2" in
git) src=$BUILD/git-$(makefile_var GIT_VERSION).tar.gz ;;
lua) src=$BUILD/lua-$(makefile_var LUA_VERSION).tar.gz ;;
sqlite) src=$BUILD/compile/sqlite ;;
*) die "no program '$2': git, lua or sqlite" ;;
esac
[ -e "$src" ] || die_cmd "$src is missing" "make -C $REPO data"

rm -rf "$DIR"
mkdir -p "$DIR"
cd "$DIR"
case "$2" in
git)
	[ -f "$BUILD/zlib/lib/libz.a" ] || die_cmd "$BUILD/zlib is missing" "make -C $REPO git"
	tar -xzf "$src" --strip-components=1
	# git's own CFLAGS (-g -O2 -Wall), and the options of build/git (see
	# the Makefile): only the git program, nothing optional, our zlib
	make -j1 git CC="$CC" CFLAGS="-g -O2 -Wall $FLAGS" prefix=/nonexistent \
		ZLIB_PATH="$BUILD/zlib" CC_LD_DYNPATH=-L \
		NO_OPENSSL=1 NO_CURL=1 NO_EXPAT=1 NO_GETTEXT=1 NO_PERL=1 NO_PYTHON=1 \
		NO_TCLTK=1 NO_RUST=1 NO_PTHREADS=1
	;;
lua)
	tar -xzf "$src" --strip-components=1
	# Lua's own CC line has -std=gnu99; its CFLAGS take ours in MYCFLAGS
	make -j1 -C src linux CC="$CC -std=gnu99" MYCFLAGS="$FLAGS"
	;;
sqlite)
	cp "$src"/* .
	# the command SQLite's build runs for the sqlite3 program, with its
	# default options, minus what configure found on the machine: no
	# zlib, no sqlite_cfg.h
	$CC -DNDEBUG -fPIC -O2 -g $FLAGS -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_PERCENTILE \
		-DSQLITE_THREADSAFE=1 -DSQLITE_DQS=0 -DSQLITE_ENABLE_BYTECODE_VTAB \
		-DSQLITE_ENABLE_DBPAGE_VTAB -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_ENABLE_EXPLAIN_COMMENTS \
		-DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_OFFSET_SQL_FUNC -DSQLITE_ENABLE_RTREE \
		-DSQLITE_ENABLE_STMTVTAB -DSQLITE_ENABLE_UNKNOWN_SQL_FUNCTION -DSQLITE_STRICT_SUBTYPE=1 \
		-o sqlite3 shell.c sqlite3.c -lm
	;;
esac
cd /
rm -rf "$DIR"
