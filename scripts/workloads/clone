#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# clone -- one run of the clone workloads: build/git clones one of the
# repositories that make data puts in build/clones/, from RAM to RAM
#
# Usage:
#   clone <repo>
#
#   <repo>   git, lua, sqlite, curl or neovim: build/clones/<repo>.git
#
# Run it through record, which keeps only the processes of build/git:
#   sudo scripts/record time -n t14 -w clone-lua -p build/git scripts/workloads/clone lua
#
# The repository is copied to /tmp/inf2204.<user id>/ first, once (RAM
# on most machines), and cloned there into <repo>.clone/, which is
# removed after the run (and before it: git clone refuses a folder that
# exists). Every name has the repository in it, so clones of different
# repositories can run at once (measure's counts). measure empties
# /tmp/inf2204.<user id>/ around the workloads; by hand, remove it with
# rm -rf.
#
# Every process of the clone must be build/git, not the system's git:
# our git has no folder of helper programs (its prefix does not exist),
# so it would start the system's git for the other side of the clone.
# --exec-path points it to a folder whose only git is ours, and
# --upload-pack="git upload-pack" makes that side a git process too (as
# git-upload-pack, perf would see it under another name).

set -eu

NAME=clone
REPO=$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")
BUILD=$REPO/build

die() {
	echo "$NAME: error: $1" >&2
	exit 1
}

die_cmd() {
	echo "$NAME: error: $1" >&2
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

case "${1:-}" in
-h | --help)
	usage_block
	exit 0
	;;
"" | */* | .*)
	usage_block >&2
	exit 1
	;;
esac
[ $# = 1 ] || die "one repository only, got: $*"

SRC=$BUILD/clones/$1.git
[ -d "$SRC" ] || die_cmd "$SRC is missing" "make -C $REPO data"
[ -x "$BUILD/git" ] || die_cmd "$BUILD/git is missing" "make -C $REPO git"

TMP=/tmp/inf2204.$(id -u)
# /tmp is everyone's: the folder must be this user's own, or another
# user could put a repository in it to be cloned
mkdir -m 700 -p "$TMP"
[ -O "$TMP" ] && [ ! -L "$TMP" ] || die "$TMP is not your own folder; remove it, as its owner"
trap 'rm -rf "$TMP/$1.clone"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -p "$TMP/$1.exec"
ln -sf "$BUILD/git" "$TMP/$1.exec/git"
# Copied once per workload, so the first run takes longer and its noise
# figures include the copy (cp's samples are not kept). The marker,
# written only after a whole copy, lists every file of the repository
# with its size and time, so a changed repository is copied again.
files=$(ls -lnR "$SRC")
if [ "$(cat "$TMP/$1.copied" 2>/dev/null)" != "$files" ]; then
	rm -rf "$TMP/$1.git"
	cp -R "$SRC" "$TMP/$1.git"
	printf '%s\n' "$files" >"$TMP/$1.copied"
fi
rm -rf "$TMP/$1.clone"
"$BUILD/git" --exec-path="$TMP/$1.exec" clone -q --no-local --upload-pack="git upload-pack" \
	"$TMP/$1.git" "$TMP/$1.clone"
rm -rf "$TMP/$1.clone"
