#!/usr/bin/env python3
# Authors: Kathryn Ann Emblow && Tuva Marie Eaton Johansen

"""
Graph inputted files as a log-log graph.

run with:

python3 graphing <relative_filepath_a> <relative_filepath_b> 

With any number of input filepaths.

There is no title as there will be a figure description in the paper.

"""


import matplotlib.pyplot as plt
import sys
import csv

FONTSIZE = 10

plt.rcParams['font.family'] = 'serif'
plt.rcParams['font.serif'] = ['Times New Roman'] + plt.rcParams['font.serif']

def main():
    if len(sys.argv) < 2:
        print("Error: No input file\nUsage: python3 graphing.py <path>", file=sys.stderr)
        return

    unit = " (" + sys.argv[1].split("/")[-2] + ")"
    if unit == "count":
        unit = None
        
    header = None
    all_data = []
    for i in range(1, len(sys.argv)):
        path = sys.argv[i]
        try:
            with open(path, 'r') as f:
                data = csv.reader(f)
                if not header:
                    header = next(data)
                else:
                    next(data)

                y = [float(row[1]) for row in data]
                x = [x for x in range(1, len(y) + 1)]

                all_data.append(x)
                all_data.append(y)
                
                all_data.append(path.split("/")[-1])

        except FileNotFoundError:
            print(f"Error: {path} not found, skipping file", file=sys.stderr)

    i = 0
    while i < len(all_data):
        plt.loglog(all_data[i], all_data[i+1], label=all_data[i+2])
        i += 3

    plt.xlabel(header[0])
    if unit:
        plt.ylabel(header[1] + unit)
    else:
        plt.ylabel(header[1])

    plt.legend(fontsize=FONTSIZE)
    plt.show()

    
if __name__ == "__main__":
    main()
