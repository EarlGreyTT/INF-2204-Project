#!/usr/bin/env python3

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

"""stack -- draw many ranked lists on top of each other as a heatmap

Usage:
  stack [-t <title>] [-n <squares>] [-o <image>] <list.csv>...

Each <list.csv> is a ranked list from rank (rank,count,...), most first.
Every list becomes a line of rank against its share of the total, and
the colour of a square is how many lists pass through it: bright where
many lists agree. A list counts once per square, so a long list does not
outshine short ones just by having more points.

  -t  the title (default: how many lists)
  -n  how many squares along each side (default 150); more is finer
  -o  save the picture to <image> (e.g. stack.png, 4K) instead of showing it

Example, all time runs of one workload:
  scripts/stack measurements/imagemagick-resize-deer/time/*.run*.samples.csv
"""

import argparse
import csv
import sys

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter


def read_list(path):
    """rank and % of the total of one ranked list"""
    with open(path) as f:
        counts = np.array([int(row['count']) for row in csv.DictReader(f)], float)
    if counts.sum() == 0:
        raise ValueError(f"{path}: no counts")
    return np.arange(1, len(counts) + 1), counts / counts.sum() * 100


def percent(value, _):
    """100%, 1%, 0.01%, ... instead of powers of ten"""
    return f"{value:.10f}".rstrip('0').rstrip('.') + '%'


def main():
    parser = argparse.ArgumentParser(
        usage='stack [-t <title>] [-n <squares>] [-o <image>] <list.csv>...',
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('-t', dest='title')
    parser.add_argument('-n', dest='squares', type=int, default=150)
    parser.add_argument('-o', dest='image')
    parser.add_argument('lists', nargs='+')
    args = parser.parse_args()

    try:
        lists = [read_list(path) for path in args.lists]
    except (OSError, ValueError, KeyError) as error:
        print(f"stack: {error}", file=sys.stderr)
        sys.exit(1)

    # squares evenly spaced on the log axes, covering every point
    longest = max(len(rank) for rank, _ in lists)
    smallest = min(pct.min() for _, pct in lists)
    x_edges = np.logspace(0, np.log10(longest) + 0.05, args.squares + 1)
    y_edges = np.logspace(np.floor(np.log10(smallest)), 2, args.squares + 1)

    lists_through = np.zeros((len(x_edges) - 1, len(y_edges) - 1))
    for rank, pct in lists:
        points, _, _ = np.histogram2d(rank, pct, [x_edges, y_edges])
        lists_through += points > 0
    lists_through[lists_through == 0] = np.nan  # empty squares stay blank

    # 12.8 x 7.2 inches at 300 dots per inch: a 4K picture, 3840 x 2160
    fig, ax = plt.subplots(figsize=(12.8, 7.2), layout='constrained')
    mesh = ax.pcolormesh(x_edges, y_edges, lists_through.T, cmap='viridis',
                         vmin=1, vmax=len(lists))
    ax.set_xscale('log')
    ax.set_yscale('log')
    ax.xaxis.set_major_formatter(FuncFormatter(lambda value, _: f"{value:,.0f}"))
    ax.yaxis.set_major_formatter(FuncFormatter(percent))
    ax.set_xlabel('rank (1 = the most)')
    ax.set_ylabel('share of the total')
    ax.set_title(args.title or f"{len(lists)} ranked lists stacked")
    fig.colorbar(mesh, label='how many lists pass through this square')

    if args.image:
        fig.savefig(args.image, dpi=300)
    else:
        plt.show()


if __name__ == "__main__":
    main()
