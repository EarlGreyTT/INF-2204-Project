#!/bin/sh

# This script was generated by Claude Code, Anthropic's AI coding
# assistant.

# record -- measure a program: where its CPU time goes (perf) and how
# often each instruction runs (callgrind)
#
# Usage:
#   record all -n <nick> -w <workload> [-r <runs>] [-u] [-c <cycles>] [-q]
#              [-m <dir>] [-p <program>] <program> [<arg>...]
#   record time -n <nick> -w <workload> [-u] [-c <cycles>] [-q] [-m <dir>]
#               [-p <program>] <program> [<arg>...]
#   record count -n <nick> -w <workload> [-q] [-m <dir>] <program>
#                [<arg>...]
#
#   all          tune the system, record time <runs> times, restore the
#                system, then record count once; as root
#   time         sample where the program spends its CPU cycles, with
#                perf, on the CPU that tune isolated; as root, with tune
#                hold running in another terminal (or -u)
#   count        count exactly how many times each instruction, source
#                line and function runs, with callgrind; needs no root
#                or tuning
#
#   -n <nick>    a nickname for the system measured on (hardware and
#                software), e.g. t14
#   -w <workload>
#                a name for what is measured: the program with its
#                settings and input, e.g. zstd-3-silesia; the folder its
#                runs go in. Runs of another command need another name.
#   -r <runs>    how many time runs to record (default 1)
#   -u           untuned baseline: skip tune, run the program anywhere
#   -c <cycles>  sampling period for perf (default 100003); fewer samples
#                disturb the program less
#   -q           throw away what the program prints to standard output
#                (normally its first 100 lines are kept in meta.txt);
#                for a program that prints its result, like xz -c
#   -m <dir>     the measurements folder (default: measurements/ in the
#                repo)
#   -p <program> measure <program>, which the command after the options
#                starts, perhaps many times; e.g. make starting gcc's
#                cc1 once for each file it compiles. Time runs only:
#                callgrind does not follow the processes a command
#                starts, so record all skips the count.
#
# all restores the system also on errors and Ctrl-C. It counts after
# that, as the user who ran sudo: counts do not depend on tuning, and
# callgrind is slow. While the system is tuned the radios are off; tune
# turns them back on after an hour whatever happens, and a time run
# during which they came back fails. If a series of runs takes longer
# than that hour, all restores the system and tunes it again before the
# next run.
#
# The program runs with the same small environment in every run (see
# ENVIRONMENT below), whoever runs it: the environment's size shifts the
# stack and with it the timing (Mytkowicz et al. 2009), and what is in
# it (the home folder, the locale, ...) can change what a program does.
#
# Time runs by hand, from two terminals:
#   sudo scripts/tune hold
#   sudo scripts/record time -n t14 -w quicksort-100m ./build/quicksort 100000000
#
# A program that a command starts (here gcc's cc1, started by make);
# the command must clean up first, or a second run has nothing to do:
#   sudo scripts/record time -n t14 -w cc1-git -p build/cc1 sh -c 'make clean; make -j1'
#
# Layout under the measurements folder:
#
#   platforms/t14-1.txt                  the system: hardware, OS,
#                                        versions, ...
#   <workload>/binaries/<hash>           each build of the program, once
#   <workload>/time/t14-1.run1.<file>    runs, numbered per platform
#   <workload>/time/failed/t14-1.run2/   a run that failed
#   <workload>/count/...                 the same for counts
#
# A time run's files (<run> is e.g. t14-1.run1):
#   <run>.samples.csv            the ranked instructions (see rank), all
#                                code, kernel too
#   <run>.line-samples.csv       the ranked source lines
#   <run>.function-samples.csv   the ranked functions
#   <run>.meta.txt               what was run, how it was sampled, and
#                                the program's output
#   <run>.perf.data              raw samples
#
# A count run's files:
#   <run>.counts.csv            the ranked instructions (see rank), all
#                               user-space code
#   <run>.line-counts.csv       the ranked source lines
#   <run>.function-counts.csv   the ranked functions
#   <run>.meta.txt              what was run, and the program's output
#   <run>.callgrind.out         raw counts and jumps
#   <run>.valgrind.log          load addresses, needed to rank the raw
#                               counts
#
# t14-1 is a platform: the system (t14) as it is now. When anything in
# its platform file changes, new hardware or a kernel update say, the
# next run creates t14-2 and shows what changed.
#
# A run is written into failed/<run>/ and moved out only when it
# succeeds, so one that fails, is interrupted or crashes stays there,
# with error.txt saying why. Run numbers count attempts: a gap among the
# successful runs is the failed run with that number.
#
# Time: one sample every <cycles> cycles (cycles:P: the most precise
# sampling the CPU supports); a prime period avoids falling into step
# with loops. Only processes with the program's name are kept, and they
# must all run the program's very file. perf runs outside tune.slice
# and only the program inside it, keeping perf's own work off the
# measured CPU. That relies on systemd-run --scope moving itself into
# the slice before exec'ing the program, so a sample on any other CPU
# fails the run.
#
# Count: instructions are named as perf names them (function and
# offset), so the lists line up with the time runs'. Valgrind's own code
# is left out; callgrind sees user space only.

set -eu

NAME=record
# the program's environment; no existing home folder, so that no user's
# settings reach it
ENVIRONMENT="PATH=/usr/bin:/bin HOME=/nonexistent LC_ALL=C TZ=UTC"
SCRIPTS=$(dirname "$(readlink -f "$0")")

# quote <word>: the word as the shell reads it back, in '' if needed
quote() {
	case "$1" in
	"" | *[!A-Za-z0-9_./:=,+%@-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
	*) printf '%s' "$1" ;;
	esac
}

# this command, to print as a fix
CMDLINE=$(quote "$0")
for a in "$@"; do
	CMDLINE="$CMDLINE $(quote "$a")"
done

ROOT=
PLATFORM=
RUN=
RUN_DIR=
STAGE=
BINARY=
PROG=
PROG_SHA=
BASE=
WORKLOAD=
# set by -q: the program's output is thrown away
DISCARD=
ARGS=
# set by -p: the command that starts the program, quoted
STARTER=
# a time run's folder in RAM for perf's samples
PERF_RAM=

# records an error in the run being written, if there is one
record_error() {
	if [ -n "$STAGE" ] && [ -d "$STAGE" ]; then
		echo "$1" >>"$STAGE/error.txt"
	fi
}

die() {
	echo "$NAME: error: $1" >&2
	record_error "$1"
	exit 1
}

# The radios tune turned off that are on again. tune's timer turns them
# back on after a while, so that a machine reached over Wi-Fi cannot
# stay cut off; a run with them on is noisier than the others.
radios_back() {
	[ -f /run/tune.state ] || return 0
	(
		. /run/tune.state
		for id in ${radios_off:-}; do
			f=/sys/class/rfkill/rfkill$id/soft
			if [ -r "$f" ] && [ "$(cat "$f")" = 0 ]; then
				echo "$id"
			fi
		done
	)
}

die_cmd() {
	echo "$NAME: error: $1" >&2
	record_error "$1"
	echo "" >&2
	echo "fix it with:" >&2
	echo "" >&2
	echo "$2" >&2
	echo "" >&2
	if [ -n "${3:-}" ]; then
		echo "$3" >&2
		echo "" >&2
	fi
	exit 1
}

note() {
	echo "$NAME: $1" >&2
}

# usage [0]: prints the header's Usage block and exits; with 0 (for -h)
# to stdout, otherwise to stderr as an error
usage() {
	if [ "${1:-1}" = 0 ]; then
		usage_block
		exit 0
	fi
	usage_block >&2
	exit 1
}

usage_block() {
	awk '/^# Usage:/ { p = 1; print "usage:"; next }
		p && !/^#   / && !/^#$/ { exit }
		p && /^#$/ { blank++; next }
		p { while (blank) { print ""; blank-- } sub(/^# /, ""); print }' "$0"
}

have() {
	command -v "$1" >/dev/null 2>&1
}

# install_hint apt-packages dnf-packages pacman-packages: the command
# that installs them with this machine's package manager
install_hint() {
	if have apt-get; then
		echo "sudo apt install $1"
	elif have dnf; then
		echo "sudo dnf install $2"
	elif have pacman; then
		echo "sudo pacman -S $3"
	else
		echo "(install $1 with your package manager)"
	fi
}

# perf's package: per kernel on Ubuntu, linux-perf on Debian and
# Raspberry Pi OS
perf_hint() {
	if grep -Eqi '^ID(_LIKE)?=.*ubuntu' /etc/os-release 2>/dev/null; then
		echo "sudo apt install linux-tools-common linux-tools-$(uname -r)"
	else
		install_hint linux-perf perf perf
	fi
}

# commas n: n with thousands separators, 1234567 -> 1,234,567
commas() {
	awk -v n="$1" 'BEGIN {
		while (length(n) > 3) { s = "," substr(n, length(n) - 2) s; n = substr(n, 1, length(n) - 3) }
		print n s }'
}

# shown path: the path relative to the current folder, if it is inside it
shown() {
	case "$1" in
	"$PWD"/*) echo "${1#"$PWD"/}" ;;
	*) echo "$1" ;;
	esac
}

check_nick() {
	case "$1" in
	"") die "a system nickname is required, e.g. -n t14" ;;
	*[!A-Za-z0-9_]*) die "nickname '$1' may only contain letters, digits and _" ;;
	esac
}

# check_workload name: a folder name of its own, not a path
check_workload() {
	case "$1" in
	"") die "a workload name is required, e.g. -w zstd-3-silesia" ;;
	platforms) die "'platforms' cannot be a workload's name: that folder holds the platform files" ;;
	[!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) die "workload '$1' may only contain letters, digits, _ . and -, and must start with a letter or digit" ;;
	esac
}

# check_command root: stops if the workload's earlier runs ran another
# command (the program's file name, its arguments, what started it with
# -p, and whether its output was thrown away), so that runs of different
# settings or inputs never mix under one name. An empty root means
# measurements/ in the repo.
check_command() {
	this="$BASE $ARGS${STARTER:+ (started by: $STARTER)}${DISCARD:+ (output discarded, -q)}"
	for f in "${1:-$SCRIPTS/../measurements}/$WORKLOAD"/time/*.meta.txt \
		"${1:-$SCRIPTS/../measurements}/$WORKLOAD"/count/*.meta.txt; do
		[ -f "$f" ] || continue
		that="$(sed -n 's/^program:       //p' "$f" | head -1) $(sed -n 's/^arguments:     //p' "$f" | head -1)"
		starter=$(sed -n 's/^started by:    //p' "$f" | head -1)
		that="$that${starter:+ (started by: $starter)}"
		if grep -q '^== program.out (discarded, -q)$' "$f"; then
			that="$that (output discarded, -q)"
		fi
		if [ "$that" != "$this" ]; then
			die "workload $WORKLOAD holds runs of:
    $that
(see $(shown "$f")), not of:
    $this
Give the new command its own name: with -w, or as the first word of
its line in workloads.txt."
		fi
	done
}

# check_period cycles: a sampling period for perf, if one was given
check_period() {
	case "$1" in
	*[!0-9]* | 0*) die "-c takes a positive number of cycles, got '$1'" ;;
	esac
}

# check_program path: sets PROG (absolute) and BASE (its file name). The
# name ends up in file names and perf's process filter, which splits on
# commas.
check_program() {
	PROG=$(readlink -f "$1")
	[ -f "$PROG" ] && [ -x "$PROG" ] || die "not an executable file: $1"
	BASE=$(basename "$PROG")
	case "$BASE" in
	*[[:space:]]* | *,*) die "the program's file name must not contain spaces or commas: $BASE" ;;
	esac
}

# take_command measured command...: sets PROG and BASE, and ARGS, or
# with a measured program (-p) STARTER, the whole command
take_command() {
	if [ -n "$1" ]; then
		check_program "$1"
		shift
		# found the way the program's environment finds it (word
		# splitting intended: ENVIRONMENT is a list of settings)
		env -i $ENVIRONMENT sh -c 'command -v "$1"' sh "$1" >/dev/null ||
			die "command not found (the program's PATH is /usr/bin:/bin): $1"
		STARTER=
		for a in "$@"; do
			STARTER="$STARTER${STARTER:+ }$(quote "$a")"
		done
	else
		check_program "$2"
		shift 2
		ARGS="$*"
	fi
}

need_root() {
	if [ "$(id -u)" != 0 ]; then
		die_cmd "must run as root ($1)" "sudo ${CMDLINE:-$0}"
	fi
}

# own path...: under sudo, hands the files to the user who ran sudo
own() {
	if [ "$(id -u)" = 0 ] && [ -n "${SUDO_UID:-}" ] && [ "$SUDO_UID" != 0 ]; then
		chown -R "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" "$@" || true
	fi
}

# mkdir_own dir: mkdir -p, then owns the topmost folder it created
mkdir_own() {
	[ -e "$1" ] && return 0
	top=$1
	while [ ! -e "$(dirname "$top")" ]; do
		top=$(dirname "$top")
	done
	mkdir -p "$1"
	own "$top"
}

# Note why an unfinished run stopped, and hand its files to the user.
on_exit() {
	status=$?
	if [ -n "$PERF_RAM" ]; then
		if [ -f "$PERF_RAM/perf.data" ] && [ -n "$STAGE" ] && [ -d "$STAGE" ]; then
			mv "$PERF_RAM/perf.data" "$STAGE/perf.data" || true
		fi
		rm -rf "$PERF_RAM"
	fi
	if [ -n "$STAGE" ] && [ -d "$STAGE" ]; then
		if [ "$status" != 0 ] && [ ! -e "$STAGE/error.txt" ]; then
			echo "stopped with exit status $status (129: terminal closed, 130: Ctrl-C, 141: output pipe closed, 143: killed)" >"$STAGE/error.txt"
		fi
		own "$STAGE"
	fi
}

# What surrounds the program and stays the same from run to run on one
# machine. Tuning state, date and the program itself are per run and go
# in the run's meta.txt instead.
platform() {
	# PCs describe themselves through DMI; ARM boards like the Raspberry
	# Pi through the device tree
	d=/sys/class/dmi/id
	if [ -r "$d/sys_vendor" ]; then
		echo "machine:   $(cat "$d/sys_vendor" "$d/product_version" "$d/product_name" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')"
		echo "firmware:  $(cat "$d/bios_version" 2>/dev/null)"
	else
		echo "machine:   $(tr -d '\0' 2>/dev/null </proc/device-tree/model || echo unknown)"
		# a Raspberry Pi's boot firmware, from the device tree: everyone
		# may read that, so root and a user get the same line
		echo "firmware:  $(tr -d '\0' 2>/dev/null </proc/device-tree/chosen/bootloader/version || echo unknown)"
	fi
	LC_ALL=C lscpu | sed -n 's/^Model name: *\(.*\)/cpu:       \1/p'
	echo "microcode: $(sed -n 's/^microcode[[:space:]]*: //p' /proc/cpuinfo | head -1)"
	# ARM boards count cores per cluster, and have no sockets ("-")
	LC_ALL=C lscpu | awk -F ':[ \t]+' '/^(Thread\(s\) per core|Core\(s\) per (socket|cluster)|Socket\(s\)|Cluster\(s\)|L[0-9][di]* cache):/ && $2 != "-" { print $1 ": " $2 }'
	# lsmem counts whole memory blocks, steadier than MemTotal, but needs
	# memory hotplug support, which many ARM kernels lack
	mem=$(LC_ALL=C lsmem --summary --bytes 2>/dev/null | sed -n 's/^Total online memory: *//p')
	if [ -n "$mem" ]; then
		echo "memory:    $mem bytes"
	else
		echo "memory:    $(awk '/^MemTotal:/ { print $2 * 1024 }' /proc/meminfo) bytes (MemTotal)"
	fi
	# Ubuntu's PRETTY_NAME includes the point release (26.04.1); Debian's
	# doesn't, and Raspberry Pi OS's image date in /etc/rpi-issue is fixed
	# at build time and stays stale after updates, so DEBIAN_VERSION_FULL
	# (kept current by apt) is added where PRETTY_NAME lacks it.
	echo "os:        $(. /etc/os-release; printf '%s' "$PRETTY_NAME"
		case $PRETTY_NAME in *[0-9].[0-9]*) ;; *) [ -n "${DEBIAN_VERSION_FULL:-}" ] &&
			printf ' (%s)' "$DEBIAN_VERSION_FULL" ;; esac)"
	echo "kernel:    $(uname -srvm)"
	echo "cmdline:   $(cat /proc/cmdline)"
	echo "libc:      $(ldd --version 2>&1 | head -1)"
	echo "perf:      $(perf --version 2>/dev/null || echo none)"
	echo "valgrind:  $(valgrind --version 2>/dev/null || echo none)"
}

# highest N among names like <prefix>N<suffix> in a folder, or 0
last_number() {
	last=0
	for f in "$1"/*; do
		n=${f##*/}
		case "$n" in
		"$2"*"$3") ;;
		*) continue ;;
		esac
		n=${n#"$2"}
		n=${n%"$3"}
		case "$n" in
		"" | *[!0-9]*) continue ;;
		esac
		if [ "$n" -gt "$last" ]; then
			last=$n
		fi
	done
	echo "$last"
}

# start_run root kind nick: finds or creates the platform, stores PROG's
# binary, picks the run number and creates the staging folder. An empty
# root means measurements/ in the repo. Sets PLATFORM, RUN, RUN_DIR,
# STAGE, BINARY and PROG_SHA.
start_run() {
	ROOT=${1:-$SCRIPTS/../measurements}
	check_command "$ROOT"
	for d in "$ROOT/platforms" "$ROOT/$WORKLOAD/binaries" "$ROOT/$WORKLOAD/$2/failed"; do
		mkdir_own "$d"
	done
	ROOT=$(readlink -f "$ROOT")
	trap on_exit EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 141' PIPE
	trap 'exit 143' TERM

	current=$(platform)
	for f in "$ROOT/platforms/$3"-*.txt; do
		[ -f "$f" ] || continue
		if [ "$(cat "$f")" = "$current" ]; then
			PLATFORM=$(basename "$f" .txt)
			break
		fi
	done
	if [ -z "$PLATFORM" ]; then
		last=$(last_number "$ROOT/platforms" "$3-" .txt)
		PLATFORM=$3-$((last + 1))
		printf '%s\n' "$current" >"$ROOT/platforms/$PLATFORM.txt"
		own "$ROOT/platforms/$PLATFORM.txt"
		if [ "$last" -gt 0 ]; then
			note "new platform $PLATFORM; changed since $3-$last:"
			diff "$ROOT/platforms/$3-$last.txt" "$ROOT/platforms/$PLATFORM.txt" >&2 || true
		else
			note "new platform $PLATFORM"
		fi
	fi

	PROG_SHA=$(sha256sum "$PROG" | cut -d' ' -f1)
	BINARY=$ROOT/$WORKLOAD/binaries/$(printf '%s' "$PROG_SHA" | cut -c1-12)
	if [ ! -e "$BINARY" ]; then
		cp "$PROG" "$BINARY"
		own "$BINARY"
	elif ! cmp -s "$PROG" "$BINARY"; then
		die "$BINARY exists but differs from $PROG"
	fi

	RUN_DIR=$ROOT/$WORKLOAD/$2
	a=$(last_number "$RUN_DIR" "$PLATFORM.run" .meta.txt)
	b=$(last_number "$RUN_DIR/failed" "$PLATFORM.run" "")
	if [ "$b" -gt "$a" ]; then
		a=$b
	fi
	RUN=$PLATFORM.run$((a + 1))
	mkdir "$RUN_DIR/failed/$RUN" || die "could not create $RUN_DIR/failed/$RUN"
	STAGE=$RUN_DIR/failed/$RUN
}

# program_failed status [what]: stops with the program's exit status and
# the end of what it printed to stderr
program_failed() {
	die "${2:-the program} exited with status $1:
$(tail -n 5 "$STAGE/program.err" | sed 's/^/    /')
(everything is in $STAGE)"
}

# noise_report cpu before after: what happened on the CPU between two
# snapshots (taken by record_time's wrapper), as lines for meta.txt;
# removes the snapshots.
noise_report() {
	# per-CPU counters: "label: n n n ... description", under a header
	# naming the online CPUs; prints "label delta description" for cpu
	delta_per_cpu() {
		awk -v cpu="CPU$1" '
			FNR == 1 {
				col = 0
				for (i = 1; i <= NF; i++) if ($i == cpu) col = i + 1
				ncpu = NF
				next
			}
			!col || NF < col { next }
			{
				desc = ""
				for (i = ncpu + 2; i <= NF; i++) desc = desc (desc == "" ? "" : " ") $i
				if (FILENAME == ARGV[1]) before[$1] = $col
				else printf "%s %d %s\n", $1, $col - before[$1], desc
			}
		' "$2" "$3"
	}
	# "total, most from: A n (desc), B n, C n". perf's own sampling
	# interrupts are counted apart: on x86 PMI, and again under NMI, so
	# only NMIs beyond the PMIs (the watchdog, say) count as noise; on ARM
	# a numbered interrupt whose name mentions the PMU (arm-pmu, say).
	summarize() {
		awk '
			$1 == "NMI:" { nmi = $2; next }
			$1 == "PMI:" { mine = $2; next }
			{ d = tolower($0); sub(/^[^ ]+ [^ ]+ ?/, "", d) }
			d ~ /pmu/ { mine += $2; next }
			$2 > 0 { total += $2; print }
			END {
				if (nmi > mine) { total += nmi - mine; print "NMI:", nmi - mine, "non-perf NMIs" }
				print "#", total + 0, mine + 0
			}
		' | sort -k2,2nr | awk '
			/^#/ { total = $2; mine = $3; next }
			n < 3 {
				d = $0; sub(/^[^ ]+ [^ ]+ ?/, "", d)
				top = top (n ? ", " : "") substr($1, 1, length($1) - 1) " " $2 (d != "" ? " (" d ")" : "")
				n++
			}
			END {
				printf "%d", total
				if (mine) printf " (plus %d from perf'"'"'s own sampling)", mine
				if (top != "") printf ", most from: %s", top
				print ""
			}'
	}
	echo "interrupts:    $(delta_per_cpu "$1" "$2.interrupts" "$3.interrupts" | summarize)"
	echo "softirqs:      $(delta_per_cpu "$1" "$2.softirqs" "$3.softirqs" | summarize)"
	# user nice system idle iowait irq softirq steal, in clock ticks
	paste -d' ' "$2.stat" "$3.stat" | awk -v hz="$(getconf CLK_TCK)" '{
		n = (NF - 2) / 2
		for (i = 2; i <= 9; i++) { d[i] = $(i + n + 1) - $i; t += d[i] }
		if (t == 0) { print "cpu time:      n/a"; exit }
		printf "cpu time:      user %.1f%%, system %.1f%%, irq %.1f%%, softirq %.1f%%, idle %.1f%% of %.1f s\n",
			100 * (d[2] + d[3]) / t, 100 * d[4] / t, 100 * d[7] / t, 100 * d[8] / t,
			100 * (d[5] + d[6]) / t, t / hz }'
	# cpuN ... running_ns waiting_ns timeslices
	paste -d' ' "$2.schedstat" "$3.schedstat" | awk '{
		n = NF / 2
		printf "scheduling:    %d timeslices, tasks waited %.1f ms for the CPU\n",
			$(2 * n) - $n, ($(2 * n - 1) - $(n - 1)) / 1e6 }'
	paste -d' ' "$2.throttle" "$3.throttle" | awk '{
		if ($1 == "-") print "throttling:    n/a"
		else printf "throttling:    %d core, %d package events\n", $3 - $1, $4 - $2 }'
	rm "$2".* "$3".*
}

# noise_summary report: noise_report's lines, as one short phrase
noise_summary() {
	awk '
		$1 == "interrupts:" { irq = $2 + 0 }
		$1 == "scheduling:" { slices = $2 + 0; wait = $6 }
		$1 == "throttling:" { thr = ($2 == "n/a") ? "n/a" : $2 + $4 }
		END {
			printf "%s interrupts, %s timeslices, %s ms waiting, ", irq, slices, wait
			if (thr == "n/a") print "throttling n/a"
			else if (thr == 0) print "no throttling"
			else printf "%d throttling events\n", thr
		}' "$1"
}

# repo_commit: the repo's commit, and whether what decides a run
# (scripts/, the Makefile, workloads.txt) differs from it. Read-only:
# --no-optional-locks keeps git status from rewriting the index as root,
# and safe.directory lets root read the user's repo.
repo_commit() {
	repo=$(dirname "$SCRIPTS")
	g() {
		git -c safe.directory="$repo" -C "$repo" --no-optional-locks "$@" 2>/dev/null
	}
	if ! c=$(g rev-parse --short=12 HEAD); then
		echo "unknown (not a git checkout)"
	elif [ -n "$(g status --porcelain -- scripts Makefile workloads.txt)" ]; then
		echo "$c, with changes not committed in scripts/, the Makefile or workloads.txt"
	else
		echo "$c"
	fi
}

# The lines every meta.txt starts with. Takes the program's arguments.
meta_common() {
	echo "run:           $RUN"
	echo "workload:      $WORKLOAD"
	echo "date:          $(date -Iseconds)"
	echo "repo commit:   $(repo_commit)"
	echo "platform:      $PLATFORM (see platforms/$PLATFORM.txt)"
	# printf: echo would turn a \t in an argument into a tab
	if [ -n "$STARTER" ]; then
		printf 'command:       %s\n' "$STARTER"
	else
		printf 'command:       %s %s\n' "$PROG" "$*"
	fi
	# what makes up the workload, the same on every machine
	printf 'program:       %s\n' "$BASE"
	printf 'arguments:     %s\n' "$*"
	[ -z "$STARTER" ] || printf 'started by:    %s\n' "$STARTER"
	echo "binary:        sha256 $PROG_SHA, stored as binaries/$(basename "$BINARY")"
	echo "compiler:      $(readelf -p .comment "$PROG" 2>/dev/null | sed -n 's/^ *\[ *[0-9a-f]*\] *//p' | head -1)"
	# from the debug information of the program's first source file: the
	# options in force, a distribution's own defaults among them
	echo "compiled with: $(readelf --debug-dump=info "$PROG" 2>/dev/null | sed -n '/DW_AT_producer/ { s/.*): //p; q; }')"
	echo "environment:   $ENVIRONMENT"
	echo "user:          $(id -un "$RUN_UID" 2>/dev/null || echo "$RUN_UID")"
	echo "aslr:          $(cat /proc/sys/kernel/randomize_va_space) (randomize_va_space; 2: full)"
	echo "page size:     $(getconf PAGESIZE) bytes"
}

# The program's output, for the end of meta.txt; removes the files.
meta_output() {
	for f in program.out program.err; do
		echo ""
		if [ -e "$STAGE/$f" ]; then
			echo "== $f (first 100 lines)"
			head -n 100 "$STAGE/$f"
			rm "$STAGE/$f"
		else
			echo "== $f (discarded, -q)"
		fi
	done
}

# rank_run <mode> <raw> <second-arg> <what>: the run's three ranked
# lists, <what>.csv, line-<what>.csv and function-<what>.csv; rank's
# notes in rank.log, rank-lines.log and rank-functions.log, its warnings
# also on the terminal and in rank-warnings
rank_run() {
	"$SCRIPTS/rank" "$1" instructions "$2" "$3" >"$STAGE/$4.csv" 2>"$STAGE/rank.log" ||
		die "ranking failed: $(cat "$STAGE/rank.log")"
	for level in line function; do
		"$SCRIPTS/rank" "$1" "${level}s" "$2" "$3" >"$STAGE/$level-$4.csv" \
			2>"$STAGE/rank-${level}s.log" ||
			die "ranking by ${level}s failed: $(cat "$STAGE/rank-${level}s.log")"
	done
	# the three levels read the same files, so mostly the same warnings
	sort -u "$STAGE/rank.log" "$STAGE"/rank-*s.log | sed -n 's/^warning: //p' >"$STAGE/rank-warnings"
	sed "s/^/$NAME: warning: /" "$STAGE/rank-warnings" >&2
}

# rank_levels <what>: meta.txt's lines on the line and function lists
# (how many, and what rank left out), and rank's warnings; removes
# rank's notes on them
rank_levels() {
	for level in line function; do
		printf '%-15s%s ranked' "${level}s:" "$(($(wc -l <"$STAGE/$level-$1.csv") - 1))"
		sed -n 's/^left out/; left out/p' "$STAGE/rank-${level}s.log" | tr -d '\n'
		echo ""
		rm "$STAGE/rank-${level}s.log"
	done
	sed 's/^/warning:       /' "$STAGE/rank-warnings"
	rm "$STAGE/rank-warnings"
}

# finish_run: moves the run's files out of failed/ as <run>.<name>.
finish_run() {
	for f in "$STAGE"/*; do
		[ -e "$f" ] || continue
		own "$f"
		mv "$f" "$RUN_DIR/$RUN.${f##*/}"
	done
	rmdir "$STAGE"
	STAGE=
	rmdir "$RUN_DIR/failed" 2>/dev/null || true
}

# record all: tune, time runs, restore, count
record_all() {
	NICK=
	RUNS=1
	UNTUNED=
	PERIOD=
	QUIET=
	MDIR=
	MEASURED=
	while getopts hn:w:r:uc:qm:p: opt; do
		case "$opt" in
		h) usage 0 ;;
		p) MEASURED=$OPTARG ;;
		n) NICK=$OPTARG ;;
		w) WORKLOAD=$OPTARG ;;
		r) RUNS=$OPTARG ;;
		u) UNTUNED=-u ;;
		c) PERIOD=$OPTARG ;;
		q) QUIET=-q; DISCARD=1 ;;
		m) MDIR=$OPTARG ;;
		*) usage ;;
		esac
	done
	shift $((OPTIND - 1))
	[ $# -ge 1 ] || usage
	check_nick "$NICK"
	check_workload "$WORKLOAD"
	case "$RUNS" in
	"" | *[!0-9]* | 0*) die "-r takes a positive number of runs, got '$RUNS'" ;;
	esac
	check_period "$PERIOD"
	# checked here too, so that these fail before the system is tuned
	take_command "$MEASURED" "$@"
	check_command "$MDIR"

	need_root "tuning and perf need it"
	# also with -u: record time -u refuses a tuned system
	if [ -f /run/tune.state ]; then
		die_cmd "the system is already tuned, by something other than this run" \
			"sudo $SCRIPTS/tune reset" \
			"or, if tune is running in another terminal, stop it with Ctrl-C."
	fi

	TUNED=0
	untune() {
		if [ "$TUNED" = 1 ]; then
			TUNED=0
			# tune says what to do if it fails
			"$SCRIPTS/tune" reset || true
		fi
	}
	# TUNED first: a signal while tune runs must still lead to a reset
	tune_system() {
		TUNED=1
		# tune rolls itself back if it fails part-way
		"$SCRIPTS/tune" keep >/dev/null || { TUNED=0; die "tuning failed"; }
	}
	trap untune EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 141' PIPE
	trap 'exit 143' TERM

	failed=0
	if [ -z "$UNTUNED" ]; then
		tune_system
	fi
	i=1
	while [ "$i" -le "$RUNS" ]; do
		# a long series can outlast tune's time limit for the radios
		if [ "$TUNED" = 1 ] && [ -n "$(radios_back)" ]; then
			note "the radios are back on (tune turns them on after an hour); restoring the system and tuning again"
			"$SCRIPTS/tune" reset >/dev/null || die "restoring the system failed"
			TUNED=0
			tune_system
		fi
		"$SCRIPTS/record" time -n "$NICK" -w "$WORKLOAD" $UNTUNED \
			${PERIOD:+-c} ${PERIOD:+"$PERIOD"} $QUIET ${MDIR:+-m} ${MDIR:+"$MDIR"} \
			${MEASURED:+-p} ${MEASURED:+"$MEASURED"} "$@" ||
			failed=$((failed + 1))
		i=$((i + 1))
	done
	untune

	if [ -n "$MEASURED" ]; then
		note "no count run: callgrind does not follow the processes a command starts, so a -p workload gets time runs only"
		set -- true
	elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
		set -- sudo -u "$SUDO_USER" -- "$SCRIPTS/record" count -n "$NICK" -w "$WORKLOAD" $QUIET ${MDIR:+-m} ${MDIR:+"$MDIR"} "$@"
	else
		set -- "$SCRIPTS/record" count -n "$NICK" -w "$WORKLOAD" $QUIET ${MDIR:+-m} ${MDIR:+"$MDIR"} "$@"
	fi
	"$@" || failed=$((failed + 1))

	[ "$failed" = 0 ] || die "$failed recording(s) failed; see the failed/ folders"
}

record_time() {
	NAME="record time"
	EVENT=cycles:P
	PERIOD=100003
	NICK=
	MDIR=
	UNTUNED=0
	OUT=
	MEASURED=
	while getopts hn:w:uc:qm:p: opt; do
		case "$opt" in
		h) usage 0 ;;
		n) NICK=$OPTARG ;;
		w) WORKLOAD=$OPTARG ;;
		p) MEASURED=$OPTARG ;;
		u) UNTUNED=1 ;;
		c) PERIOD=$OPTARG ;;
		q) OUT=/dev/null; DISCARD=1 ;;
		m) MDIR=$OPTARG ;;
		*) usage ;;
		esac
	done
	shift $((OPTIND - 1))
	[ $# -ge 1 ] || usage
	check_nick "$NICK"
	check_workload "$WORKLOAD"
	check_period "$PERIOD"
	take_command "$MEASURED" "$@"
	[ -n "$STARTER" ] || shift
	# the kernel keeps only the first 15 characters as the process name
	COMM=$(printf '%s' "$BASE" | cut -c1-15)

	have perf || die_cmd "perf is not installed" "$(perf_hint)"
	have setpriv || die_cmd "setpriv is not installed" "$(install_hint util-linux util-linux util-linux)"
	# by its path: the program's environment has a PATH of its own
	SETPRIV=$(command -v setpriv)
	if [ "$UNTUNED" = 0 ] && ! have systemd-run; then
		die "systemd-run is missing; it is needed to start the program in tune.slice"
	fi

	# no power supply entries at all: a desktop
	ac=desktop
	for f in /sys/class/power_supply/*/online; do
		[ -r "$f" ] || continue
		if [ "$(cat "$f")" = 1 ]; then
			ac=1
		elif [ "$ac" = desktop ]; then
			ac=0
		fi
	done
	[ "$ac" != 0 ] || die "no AC adapter detected -- plug in the power cable; on battery the CPU clock can drop mid-run"

	need_root "perf needs it, and so does starting the program in tune.slice"

	BENCH=
	if [ "$UNTUNED" = 1 ] && [ -f /run/tune.state ]; then
		die_cmd "the system is tuned, so -u would run the program on the CPUs left over for everything else" \
			"sudo $SCRIPTS/tune reset" \
			"or, if tune is running in another terminal, stop it with Ctrl-C."
	fi
	if [ "$UNTUNED" = 0 ]; then
		if [ ! -f /run/tune.state ]; then
			die_cmd "the system is not tuned" \
				"sudo $SCRIPTS/tune hold" \
				"Run it in another terminal and leave it running, or pass -u
for an untuned baseline run."
		fi
		BENCH=$(systemctl show --property=AllowedCPUs --value tune.slice 2>/dev/null || true)
		case "$BENCH" in
		"" | *[!0-9]*)
			die_cmd "tune.slice allows CPUs '$BENCH', expected exactly one; the tuning is incomplete" \
				"sudo $SCRIPTS/tune reset" \
				"then tune again."
			;;
		esac
		[ -z "$(radios_back)" ] ||
			die_cmd "the radios are back on: tune's time limit for them has passed" \
				"sudo $SCRIPTS/tune reset" \
				"then tune again."
	fi

	start_run "$MDIR" time "$NICK"

	# A wrapping sh runs the program: it writes the exit status, so that
	# does not depend on perf's, and snapshots the measured CPU's counters
	# right before and after (for noise_report), so the noise covers the
	# program, not perf starting up. The process-name filter below drops
	# its samples.
	[ -n "$STARTER" ] || set -- "$PROG" "$@"
	# perf needs root; the program runs as the user who ran sudo, as it
	# does in count runs: what a user may do can change what a program
	# does
	RUN_UID=$(id -u)
	if [ -n "${SUDO_UID:-}" ] && [ "$SUDO_UID" != 0 ]; then
		RUN_UID=$SUDO_UID
		set -- "$SETPRIV" --reuid "$SUDO_UID" --regid "${SUDO_GID:-$SUDO_UID}" --init-groups "$@"
	fi
	# word splitting intended: ENVIRONMENT is a list of settings. Inside
	# systemd-run, which adds a variable of its own.
	set -- env -i $ENVIRONMENT "$@"
	if [ "$UNTUNED" = 0 ]; then
		set -- systemd-run --scope --slice=tune --quiet "$@"
		note "recording $BASE as $RUN on CPU $BENCH"
	else
		note "recording $BASE as $RUN, untuned"
	fi
	# perf writes its samples to RAM and they move to the run's folder
	# afterwards: on a slow disk perf falls behind and drops samples (2 of
	# 5 git clone runs on the Pi's USB disk did, 87 MB of samples each)
	PERF_RAM=$(mktemp -d /dev/shm/record.XXXXXX) || die "could not create a folder in /dev/shm for perf's samples"
	perf record -e "$EVENT" -c "$PERIOD" --sample-cpu -o "$PERF_RAM/perf.data" -- \
		sh -c '
			snapshot() {
				cat /proc/interrupts >"$2.interrupts"
				cat /proc/softirqs >"$2.softirqs"
				grep "^cpu$1 " /proc/stat >"$2.stat"
				grep "^cpu$1 " /proc/schedstat >"$2.schedstat"
				t=/sys/devices/system/cpu/cpu$1/thermal_throttle
				echo "$(cat "$t/core_throttle_count" 2>/dev/null || echo -) $(cat "$t/package_throttle_count" 2>/dev/null || echo -)" >"$2.throttle"
			}
			cpu=$1 dir=$2 out=$3; shift 3
			[ -z "$cpu" ] || snapshot "$cpu" "$dir/noise.before"
			"$@" >"$out" 2>"$dir/program.err"
			echo $? >"$dir/status"
			[ -z "$cpu" ] || snapshot "$cpu" "$dir/noise.after"' \
		sh "$BENCH" "$STAGE" "${OUT:-$STAGE/program.out}" "$@" \
		2>"$STAGE/perf-record.log" ||
		die "perf record failed: $(cat "$STAGE/perf-record.log")"
	mv "$PERF_RAM/perf.data" "$STAGE/perf.data"
	rmdir "$PERF_RAM"
	PERF_RAM=
	[ -s "$STAGE/status" ] || die "the program did not run to the end; see $STAGE/perf-record.log"
	if [ "$UNTUNED" = 0 ]; then
		[ -f /run/tune.state ] || die "the system was restored during the run, so it was not tuned throughout"
		[ -z "$(radios_back)" ] ||
			die "the radios came back on during the run (tune's time limit for them passed), so it was noisier than the others"
	fi
	status=$(cat "$STAGE/status")
	rm "$STAGE/status"
	[ "$status" = 0 ] || program_failed "$status" "the program (or what starts it: systemd-run, env, setpriv)"

	# One line per sample: "tid [cpu] seconds.nanoseconds: period ip
	# (file)". The clock comes from the gaps between a thread's samples:
	# perf counts cycles per thread, so a gap is <period> cycles of that
	# thread running, plus any time it waited. The median gap leaves the
	# waits out, and threads or processes running at once do not add up.
	# Seconds and nanoseconds are kept apart: as one number they would
	# lose precision. The gaps are counted per whole MHz, so a long run
	# needs no more memory than a short one.
	{
		rc=0
		perf script -i "$STAGE/perf.data" --comms "$COMM" --ns -F tid,cpu,time,period,ip,dso \
			2>"$STAGE/perf-script.log" || rc=$?
		echo "$rc" >"$STAGE/perf-script.status"
	} | awk -v bench="$BENCH" -v prog="$PROG" -v base="$BASE" -v others="$STAGE/others" '
		{
			cpu = $2; gsub(/[^0-9]/, "", cpu); cpu += 0   # "[003]" -> 3
			t = $3; sub(/:$/, "", t); split(t, p, ".")
			n++
			if (cpu != bench) off++
			f = $0; sub(/^[^(]*\(/, "", f); sub(/\)$/, "", f)
			b = f; sub(/.*\//, "", b)
			if (b == base && f != prog) other[f]++
			if ($1 in sec) {
				g = (p[1] - sec[$1]) * 1e9 + (p[2] - ns[$1])
				if (g > 0) {
					m = int($4 / g * 1e3 + 0.5)
					if (!ngaps || m < minm) minm = m
					if (!ngaps || m > maxm) maxm = m
					all[m]++; ngaps++
					persec[p[1], m]++; insec[p[1]]++
				}
			}
			sec[$1] = p[1]; ns[$1] = p[2]
		}
		# the median of the gaps counted in h, n of them
		function median(h, n,   c, m) {
			c = 0
			for (m = minm; m <= maxm; m++) {
				if (m in h) c += h[m]
				if (2 * c >= n) return m
			}
		}
		END {
			mhz = ngaps ? median(all, ngaps) : "n/a"
			# per second, for seconds with enough gaps to trust the median
			for (s in insec) {
				if (insec[s] < 50) continue
				split("", h)
				for (m = minm; m <= maxm; m++) if ((s, m) in persec) h[m] = persec[s, m]
				m = median(h, insec[s])
				if (!secs || m < lo) lo = m
				if (!secs || m > hi) hi = m
				secs++
			}
			for (f in other) printf "    %s (%d samples)\n", f, other[f] >others
			printf "%d %d %s %d %d %d\n", n + 0, off + 0, mhz, secs + 0, lo + 0, hi + 0
		}
	' >"$STAGE/check"
	[ "$(cat "$STAGE/perf-script.status")" = 0 ] ||
		die "perf script failed: $(cat "$STAGE/perf-script.log")"
	read -r nsamples offcpu mhz secs lo hi <"$STAGE/check"
	rm "$STAGE/check" "$STAGE/perf-script.status"
	[ "$nsamples" -gt 0 ] ||
		die "no samples from a process named $COMM in $STAGE/perf.data"
	# record keeps processes by name, and rank tells files apart by name
	# only, so another file of the same name would mix in unnoticed
	[ ! -s "$STAGE/others" ] ||
		die "processes named $COMM ran other files than $PROG:
$(cat "$STAGE/others")
so their samples would be mixed with its own. Make the command start
$PROG itself (for git: --exec-path; for gcc: -B)."
	rm -f "$STAGE/others"
	[ "$UNTUNED" = 1 ] || [ "$offcpu" = 0 ] ||
		die "$offcpu of $nsamples samples ran on other CPUs than $BENCH, so the program was not confined to tune.slice"
	# perf lists only the record types that occur, as "NAME events: count";
	# the first list is the total over the whole file.
	perf report -i "$STAGE/perf.data" --stats >"$STAGE/stats" 2>&1 ||
		die "perf report --stats failed: $(cat "$STAGE/stats")"
	awk '$2 == "events:" && !($1 in n) { n[$1] = $3 }
		END { printf "%d %d %d\n", n["SAMPLE"], n["THROTTLE"], n["LOST"] + n["LOST_SAMPLES"] }
	' "$STAGE/stats" >"$STAGE/dropped"
	read -r stat_samples throttled lost <"$STAGE/dropped"
	rm "$STAGE/dropped"
	[ "$stat_samples" -gt 0 ] || die "could not read the sample count from perf report --stats"
	[ "$throttled" = 0 ] && [ "$lost" = 0 ] ||
		die "perf dropped samples ($throttled throttled, $lost lost), so the counts are incomplete; the kernel's limit is now $(cat /proc/sys/kernel/perf_event_max_sample_rate) samples/s"
	if [ "$secs" -gt 0 ]; then
		clock="~$mhz MHz while it ran, $lo-$hi MHz per second ($secs s)"
		clock_short="$lo-$hi MHz"
	else
		clock="~$mhz MHz while it ran (too short for per-second figures)"
		clock_short="~$mhz MHz"
	fi

	rank_run time "$STAGE/perf.data" "$BASE" samples
	rm "$STAGE/rank.log"
	programs=$(awk -F, -v f="$BASE" 'NR > 1 && $NF == f' "$STAGE/samples.csv" | wc -l)
	[ "$programs" -gt 0 ] ||
		die "no samples in $BASE's own code; perf could not match its samples to $PROG"
	# kernel code shows up as [kernel.kallsyms] or [module]; [vdso] is
	# kernel-provided code that runs in user space
	kernel=$(awk -F, 'NR > 1 { t += $2 } NR > 1 && $NF ~ /^\[/ && $NF != "[unknown]" && $NF != "[vdso]" { k += $2 }
		END { printf "%.1f", t ? 100 * k / t : 0 }' "$STAGE/samples.csv")

	if [ -n "$BENCH" ]; then
		noise_report "$BENCH" "$STAGE/noise.before" "$STAGE/noise.after" >"$STAGE/noise.txt"
		noise="on CPU $BENCH: $(noise_summary "$STAGE/noise.txt")"
	else
		noise="untuned"
	fi

	{
		meta_common "$ARGS"
		echo "event:         $EVENT, one sample every $PERIOD cycles"
		echo "precise_ip:    $(perf evlist -v -i "$STAGE/perf.data" 2>/dev/null | sed -n 's/.*precise_ip: \([0-9]*\).*/\1/p' | head -1)"
		if [ "$UNTUNED" = 0 ]; then
			echo "tuned:         yes, CPU $BENCH"
		else
			echo "tuned:         no"
		fi
		echo "samples:       $nsamples, at $(($(wc -l <"$STAGE/samples.csv") - 1)) locations, $programs of them in $BASE"
		rank_levels samples
		echo "clock:         $clock"
		echo "kernel:        $kernel% of the samples"
		if [ -n "$BENCH" ]; then
			echo "while the program ran, on CPU $BENCH:"
			sed 's/^/  /' "$STAGE/noise.txt"
		fi
		echo ""
		echo "== perf record"
		cat "$STAGE/perf-record.log"
		echo ""
		echo "== perf report --stats"
		cat "$STAGE/stats"
		echo ""
		echo "== perf evlist -v"
		perf evlist -v -i "$STAGE/perf.data" 2>&1 || true
		if [ -x "$SCRIPTS/tune" ]; then
			echo ""
			echo "== tune check"
			"$SCRIPTS/tune" check 2>&1 || true
		fi
		meta_output
	} >"$STAGE/meta.txt"
	rm -f "$STAGE/perf-record.log" "$STAGE/perf-script.log" "$STAGE/stats" "$STAGE/noise.txt"

	finish_run
	note "$(shown "$RUN_DIR")/$RUN: $(commas "$nsamples") samples, $clock_short, $kernel% in the kernel; $noise"
}

record_count() {
	NAME="record count"
	NICK=
	MDIR=
	OUT=
	while getopts hn:w:qm: opt; do
		case "$opt" in
		h) usage 0 ;;
		n) NICK=$OPTARG ;;
		w) WORKLOAD=$OPTARG ;;
		q) OUT=/dev/null; DISCARD=1 ;;
		m) MDIR=$OPTARG ;;
		*) usage ;;
		esac
	done
	shift $((OPTIND - 1))
	[ $# -ge 1 ] || usage
	check_nick "$NICK"
	check_workload "$WORKLOAD"
	check_program "$1"
	shift
	ARGS="$*"

	have valgrind || die_cmd "valgrind is not installed" "$(install_hint valgrind valgrind valgrind)"
	# by its path: the program's environment has a PATH of its own
	VALGRIND=$(command -v valgrind)
	have python3 || die_cmd "python3 is not installed" "$(install_hint python3 python3 python)"
	for c in nm objdump readelf; do
		have "$c" || die_cmd "$c is not installed" "$(install_hint binutils binutils binutils)"
	done

	start_run "$MDIR" count "$NICK"

	# -v -v -v logs where each file was loaded; the ranking needs that to
	# name the PLT, init and fini code callgrind leaves unattributed.
	# --skip-plt=no: every instruction is counted at its own address;
	# by default callgrind adds what runs in a PLT stub, and on some
	# platforms what follows the call, to the calling instruction.
	note "counting $BASE's instructions as $RUN, under callgrind (slow)"
	RUN_UID=$(id -u)
	status=0
	# word splitting intended: ENVIRONMENT is a list of settings
	env -i $ENVIRONMENT \
		"$VALGRIND" -v -v -v --tool=callgrind --dump-instr=yes --skip-plt=no \
		--collect-jumps=yes \
		--callgrind-out-file="$STAGE/callgrind.out" --log-file="$STAGE/valgrind.log" \
		"$PROG" "$@" >"${OUT:-$STAGE/program.out}" 2>"$STAGE/program.err" || status=$?
	[ "$status" = 0 ] || program_failed "$status"

	rank_run count "$STAGE/callgrind.out" "$STAGE/valgrind.log" counts
	programs=$(awk -F, -v f="$BASE" 'NR > 1 && $NF == f' "$STAGE/counts.csv" | wc -l)
	[ "$programs" -gt 0 ] ||
		die "no counts for $BASE's own code; the object names in callgrind.out do not match it"

	{
		meta_common "$ARGS"
		sed '/^warning: /d' "$STAGE/rank.log"
		echo "instructions:  $(($(wc -l <"$STAGE/counts.csv") - 1)) ran, $programs of them in $BASE"
		rank_levels counts
		meta_output
	} >"$STAGE/meta.txt"
	total=$(sed -n 's/^total Ir: //p' "$STAGE/rank.log")
	rm "$STAGE/rank.log"

	finish_run
	note "$(shown "$RUN_DIR")/$RUN: $total instructions ran, at $(commas "$(($(wc -l <"$RUN_DIR/$RUN.counts.csv") - 1))") addresses, $(commas "$programs") of them in $BASE"
}

case "${1:-}" in
-h | --help)
	usage 0
	;;
all | time | count)
	cmd=$1
	shift
	case "${1:-}" in
	-h | --help) usage 0 ;;
	esac
	"record_$cmd" "$@"
	;;
*)
	usage
	;;
esac
